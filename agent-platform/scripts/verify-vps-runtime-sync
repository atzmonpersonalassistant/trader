#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import shlex
import subprocess
import sys
from dataclasses import dataclass

ROOT = pathlib.Path(__file__).resolve().parents[2]


@dataclass(frozen=True)
class Artifact:
    source: str
    target: str
    mode: str | None = None


ARTIFACTS = [
    Artifact('agent-platform/runtime/bin/trading-orchestrator', '/usr/local/bin/trading-orchestrator'),
    Artifact('agent-platform/runtime/bin/trading-coding-agent', '/usr/local/bin/trading-coding-agent'),
    Artifact('agent-platform/runtime/bin/trading-coding-agent-stub', '/usr/local/bin/trading-coding-agent-stub'),
