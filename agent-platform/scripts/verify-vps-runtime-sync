def sha256(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def remote_hashes(host: str, ssh_key: str | None) -> dict[str, str]:
    paths = ' '.join(shlex.quote(a.target) for a in ARTIFACTS)
    cmd = f"sha256sum {paths} 2>/dev/null || true"
    ssh = ['ssh', '-o', 'BatchMode=yes', '-o', 'IdentitiesOnly=yes']
    if ssh_key:
        ssh += ['-i', ssh_key]
    ssh += [host, cmd]
    proc = subprocess.run(ssh, text=True, capture_output=True, timeout=120)
    if proc.returncode != 0:
        print(proc.stderr, file=sys.stderr)
        raise SystemExit(proc.returncode)
    out: dict[str, str] = {}
    for line in proc.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            out[parts[1]] = parts[0]
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description='Verify versioned Trader runtime artifacts match a VPS deployment.')
    ap.add_argument('--host', required=True, help='SSH host, e.g. ubuntu@example.com')
    ap.add_argument('--ssh-key')
    ap.add_argument('--json', action='store_true')
    args = ap.parse_args()
    remote = remote_hashes(args.host, args.ssh_key)
    rows = []
    ok = True
    for artifact in ARTIFACTS:
        src = ROOT / artifact.source
        local_hash = sha256(src) if src.exists() else None
        remote_hash = remote.get(artifact.target)
        status = 'match' if local_hash and remote_hash == local_hash else 'missing-local' if not local_hash else 'missing-remote' if not remote_hash else 'diff'
        if status != 'match':
            ok = False
        rows.append({'status': status, 'source': artifact.source, 'target': artifact.target, 'local_sha256': local_hash, 'remote_sha256': remote_hash})
    if args.json:
        print(json.dumps({'ok': ok, 'artifacts': rows}, indent=2, sort_keys=True))
    else:
        for row in rows:
            print(f"{row['status']}\t{row['target']}\t{row['source']}")
    return 0 if ok else 1


if __name__ == '__main__':
    raise SystemExit(main())
