#!/usr/bin/env bash
set -euo pipefail
LOG_DIR=/agents/orchestrator/logs
LOCK=/agents/orchestrator/state/orchestrator.tick.lock
mkdir -p "$LOG_DIR" /agents/orchestrator/state
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "$(date -Is) another orchestrator tick is already running"
  exit 0
fi
{
  echo "$(date -Is) tick start"
  trading-orchestrator scan || true
  trading-orchestrator claim || true
  trading-orchestrator dispatch coding --timeout-seconds 900 || true
  trading-orchestrator scan-prs || true
  trading-orchestrator dispatch missing-reviews --timeout-seconds 900 || true
  trading-orchestrator enable-auto-merge || true
  trading-orchestrator route-review-failures || true
  trading-orchestrator finalize-merged || true
  echo "$(date -Is) tick end"
} >>"$LOG_DIR/tick.log" 2>&1
