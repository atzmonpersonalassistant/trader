#!/usr/bin/env bash
set -euo pipefail
umask 077
export PYTHONDONTWRITEBYTECODE=1
export HOME=/home/agent-research
RUNNER_USER=${TRADING_RESEARCH_RUNNER_USER:-agent-research-runner}
RUNNER_HOME=${TRADING_RESEARCH_RUNNER_HOME:-/home/agent-research-runner}
export PATH=/usr/local/bin:/usr/bin:/bin
RESEARCH_ENV=${TRADING_RESEARCH_ENV_FILE:-/etc/trading-agents/secrets/research/env}
if [ -r "$RESEARCH_ENV" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$RESEARCH_ENV"
  set +a
fi
mkdir -p /agents/research/tmp
cd /agents/research/tmp

QUEUE=${TRADING_RESEARCH_QUEUE:-/agents/research/state/strategy-queue.json}
LOG_DIR=${TRADING_RESEARCH_LOG_DIR:-/agents/research/logs}
REPORTS_DIR=${TRADING_RESEARCH_REPORTS_DIR:-/agents/research/reports}
RUNNER_HANDOFF_DIR=${TRADING_RESEARCH_RUNNER_HANDOFF_DIR:-/agents/research/handoff}
LOCK=${TRADING_RESEARCH_LOCK:-/agents/research/state/research-agent-loop.lock}
LOOP_ONCE=${TRADING_RESEARCH_LOOP_ONCE:-0}
DISABLE_SEED=${TRADING_RESEARCH_LOOP_DISABLE_SEED:-0}
DRY_RUN=${TRADING_RESEARCH_LOOP_DRY_RUN:-0}
mkdir -p "$LOG_DIR" "$REPORTS_DIR" /agents/research/tmp "$RUNNER_HANDOFF_DIR"

make_runner_task_inputs_readable() {
  local file
  for file in "$@"; do
    [ -e "$file" ] || continue
    if command -v setfacl >/dev/null 2>&1 && setfacl -m "u:$RUNNER_USER:r--" "$file" 2>/dev/null; then
      chmod u+rw,o-rwx "$file"
    else
      chgrp "$RUNNER_USER" "$file" 2>/dev/null || true
      chmod u+rw,g+r,o-rwx "$file"
    fi
  done
}

exec 9>"$LOCK"
if ! flock -n 9; then
  echo "$(date -u +%FT%TZ) another research loop already running"
  exit 0
fi

if [ "$DISABLE_SEED" != "1" ] && [ ! -s "$QUEUE" ]; then
  trading-research-agent --queue "$QUEUE" seed-cheap-calls >> "$LOG_DIR/loop.log" 2>&1 || true
fi

while true; do
  if [ "$DISABLE_SEED" != "1" ]; then
    trading-research-agent --queue "$QUEUE" generate-ideas --min-queued 3 --limit 6 --reports-dir "$REPORTS_DIR" >> "$LOG_DIR/loop.log" 2>&1 || true
  fi
  RUN_ID="research-pass-$(date -u +%Y%m%d-%H%M%S)"
  RUN_DIR="$REPORTS_DIR/$RUN_ID"
  mkdir -p "$RUN_DIR"
  chmod 750 "$RUN_DIR"
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "u:$RUNNER_USER:--x" /agents /agents/research "$REPORTS_DIR" 2>/dev/null || true
    setfacl -m "u:agent-research:rwx,u:$RUNNER_USER:rwx,m::rwx,d:u:agent-research:rwx,d:u:$RUNNER_USER:rwx,d:m::rwx" "$RUN_DIR"
  else
    chgrp "$RUNNER_USER" "$RUN_DIR"
    chmod 2770 "$RUN_DIR"
  fi

  trading-research-agent --queue "$QUEUE" claim --run-id "$RUN_ID" > "$RUN_DIR/candidate.json"
  if python3 - "$RUN_DIR/candidate.json" <<'PY'
import json, sys
p=json.load(open(sys.argv[1]))
sys.exit(0 if p.get('type') == 'candidate' else 1)
PY
  then
    trading-research-agent mandate > "$RUN_DIR/mandate.json"
    trading-research-agent qc-prompt > "$RUN_DIR/qc_prompt.json"
    cat > "$RUN_DIR/task.txt" <<EOF
You are running as the Trader Strategy / Quant Research Agent.

Run one autonomous research pass for the candidate in ./candidate.json.

Current Uriel mandate updates:
- Pre-market and after-hours data may be used for context, monitoring, priority changes, and hypothesis generation only.
- Do not send a candidate based solely on extended-hours movement.
- Candidate status requires regular-session-aware validation and realistic execution assumptions.
- Capital/sizing remains out of scope for MVP: report max loss/collateral/risk profile only; do not recommend dollars or contract count.

Use QuantConnect as default, with QC Research Notebooks / QuantBook as the preferred diagnostics and exploration layer before cloud backtests. When testing a hypothesis, first create or update a QC-compatible research notebook artifact (research.ipynb or notebook-style script) that documents the signal, option-chain checks, contract filters, liquidity, event counts, and quick charts/tables where possible.

Before deeper QC diagnostics, inspect qc_broker_artifacts.json, qc_broker_summary.md, qc_research_artifact_manifest.json, qc_research_artifact_summary.md, qc_option_history_probe.py, qc_option_history_extract.json, and qc_research_execution_diagnostic.json when present. The loop runs a narrow authenticated QuantConnect broker before launching you and saves non-secret artifacts there. If qc_option_history_extract.json exists, use the provided bounded option-chain/history extract before deciding whether deeper backtests are justified. If only qc_research_execution_diagnostic.json exists, distinguish auth failure, generated-probe-only state, and the exact unavailable QC/Lean execution surface. Do not read raw credentials or request direct secret access; if more authenticated QC data is needed, define the next broker artifact needed.

Apply Option Pricing / Volatility Intelligence before candidate status: evaluate market mid versus theoretical/model range, IV rank/percentile where available, IV versus realized volatility, skew, term structure, Greeks and net spread exposures, debit/credit versus expected move and max risk, payoff scenarios before/at expiry, and sensitivity to bid/ask, fill, and slippage. Black-Scholes/Merton is only a baseline; use other lenses when useful such as binomial/trinomial trees, finite-difference/QuantLib-style models, Monte Carlo for path-dependent structures, empirical IV/RV, skew, term structure, and scenario simulation. Do not blindly optimize parameters to rescue a weak result; use pricing diagnostics to explain what failed and what is worth refining.

Then run QC-compatible diagnostics and prepare cloud-backtest artifacts only after notebook/diagnostic/pricing evidence justifies them. You run as the offline Codex research role: use only current-directory artifacts and do not expect raw QuantConnect credentials or unrestricted network. Authenticated QC/Lean access is brokered through narrow non-secret artifacts. Never print raw credentials or secret file contents.

Save all artifacts, scripts, JSON responses, logs, and final report in the current working directory: $RUN_DIR. End final_report.md with one verdict exactly: discard, refine, retest_after_technical_fix, or candidate_for_validator_review.

If blocked by QC nodes/data/log extraction/tooling, document the exact blocker and next technical step instead of pretending the hypothesis was validated.
EOF
    make_runner_task_inputs_readable "$RUN_DIR/candidate.json" "$RUN_DIR/mandate.json" "$RUN_DIR/qc_prompt.json" "$RUN_DIR/task.txt"
    echo "$(date -u +%FT%TZ) starting $RUN_ID" | tee -a "$LOG_DIR/loop.log"
    set +e
    cd "$RUN_DIR"
    HANDOFF_TASK="$RUNNER_HANDOFF_DIR/$RUN_ID-task.txt"
    install -o agent-research -g "$RUNNER_USER" -m 640 "$RUN_DIR/task.txt" "$HANDOFF_TASK"
    if [ "$DRY_RUN" = "1" ]; then
      echo "$(date -u +%FT%TZ) dry-run $RUN_ID" | tee -a "$LOG_DIR/loop.log"
      RC=0
    else
      # Run a narrow authenticated QuantConnect broker before handing work to
      # the LLM. The broker may use QC credentials/network and writes only
      # non-secret artifacts for the offline Codex research pass.
      trading-research-qc-broker preflight "$RUN_DIR" "$RUN_DIR/candidate.json" > "$RUN_DIR/qc_broker.log" 2> "$RUN_DIR/qc_broker.err"
      BROKER_RC=$?
      if [ "$BROKER_RC" = "0" ]; then
        trading-research-qc-broker research-artifact "$RUN_DIR" "$RUN_DIR/candidate.json" >> "$RUN_DIR/qc_broker.log" 2>> "$RUN_DIR/qc_broker.err"
        BROKER_RC=$?
      fi
      make_runner_task_inputs_readable "$RUN_DIR/qc_broker_artifacts.json" "$RUN_DIR/qc_broker_summary.md" "$RUN_DIR/qc_broker_candidate_summary.json" "$RUN_DIR/qc_research_artifact_manifest.json" "$RUN_DIR/qc_research_artifact_summary.md" "$RUN_DIR/qc_option_history_probe.py" "$RUN_DIR/qc_option_history_extract.json" "$RUN_DIR/qc_research_execution_diagnostic.json" "$RUN_DIR/qc_broker.log" "$RUN_DIR/qc_broker.err"
      if [ "$BROKER_RC" != "0" ]; then
        {
          echo "# QC broker preflight failed"
          echo
          echo "The research loop ran trading-research-qc-broker before the autonomous pass and the broker preflight failed."
          echo "See qc_broker_artifacts.json, qc_broker_summary.md, and qc_broker.err for the exact non-secret failing check."
          echo
          echo "retest_after_technical_fix"
        } > "$RUN_DIR/final_report.md"
        RC=0
      else
        # Run the autonomous Codex research pass offline. Authenticated QC/Lean
        # access is exposed only through broker-produced non-secret artifacts.
        sudo -n -u "$RUNNER_USER" /usr/local/bin/trading-research-runner-codex "$HANDOFF_TASK" "$RUN_DIR" > "$RUN_DIR/codex.log" 2>&1
        RC=$?
      fi
    fi
    set -e
    rm -f "$HANDOFF_TASK" 2>/dev/null || true
    echo "$RC" > "$RUN_DIR/exit_code"
    CANDIDATE_ID=$(python3 - "$RUN_DIR/candidate.json" <<'PY'
import json, sys
p=json.load(open(sys.argv[1]))
print(p["candidate"]["id"])
PY
)
    STATUS=done
    if [ "$RC" != "0" ]; then
      STATUS=failed
    elif [ ! -s "$RUN_DIR/final_report.md" ]; then
      STATUS=failed
    elif ! grep -Eq "^(discard|refine|retest_after_technical_fix|candidate_for_validator_review)$" "$RUN_DIR/final_report.md"; then
      STATUS=failed
    elif grep -Eq "^retest_after_technical_fix$" "$RUN_DIR/final_report.md"; then
      STATUS=blocked
    elif grep -Eq "^refine$" "$RUN_DIR/final_report.md"; then
      STATUS=refine
    fi
    trading-research-agent --queue "$QUEUE" complete --candidate-id "$CANDIDATE_ID" --run-id "$RUN_ID" --status "$STATUS" >> "$LOG_DIR/loop.log" 2>&1 || true
    echo "$(date -u +%FT%TZ) finished $RUN_ID rc=$RC status=$STATUS" | tee -a "$LOG_DIR/loop.log"
  else
    echo "$(date -u +%FT%TZ) no queued candidate; sleeping" | tee -a "$LOG_DIR/loop.log"
    rm -rf "$RUN_DIR"
    if [ "$LOOP_ONCE" = "1" ]; then
      exit 0
    fi
    sleep 1800
  fi

  if [ "$LOOP_ONCE" = "1" ]; then
    exit 0
  fi
  sleep 300
done
