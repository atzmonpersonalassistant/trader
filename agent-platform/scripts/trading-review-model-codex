#!/usr/bin/env python3
import os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path('/agents/review/workspaces').resolve()

def die(msg, code=64):
    print(f'ERROR: {msg}', file=sys.stderr)
    raise SystemExit(code)

if len(sys.argv) != 4:
    die('usage: trading-review-model-codex <workspace> <output> <model>')
workspace = Path(sys.argv[1]).resolve()
output = Path(sys.argv[2]).resolve()
model = sys.argv[3]
if not re.fullmatch(r'[A-Za-z0-9._:-]{1,64}', model):
    die('invalid model token')
try:
    workspace.relative_to(ROOT)
except ValueError:
    die('workspace outside review root')
if not re.fullmatch(r'pr-[0-9]+', workspace.name):
    die('workspace must be pr-N')
try:
    output.relative_to(workspace / '.review-agent')
except ValueError:
    die('output outside .review-agent')
if output.name != 'model-review.md':
    die('output filename must be model-review.md')
if not workspace.is_dir():
    die('workspace missing')
(output.parent).mkdir(parents=True, exist_ok=True)
runner_home = Path('/home/agent-research-runner')
auth_src = runner_home / '.codex' / 'auth.json'
if not auth_src.is_file():
    die('runner Codex auth missing', 69)

tmp_home = Path(tempfile.mkdtemp(prefix='review-codex-home-', dir='/tmp'))
try:
    codex_home = tmp_home / '.codex'
    codex_home.mkdir(mode=0o700)
    shutil.copy2(auth_src, codex_home / 'auth.json')
    (codex_home / 'config.toml').write_text('', encoding='utf-8')

    env = os.environ.copy()
    env['HOME'] = str(tmp_home)
    env['PYTHONDONTWRITEBYTECODE'] = '1'
    env.pop('SUDO_COMMAND', None)
    cmd = [
        'codex', 'exec', '--model', model,
        '--sandbox', 'read-only', '--skip-git-repo-check', '--ignore-user-config', '--ignore-rules',
        '-c', 'approval_policy="never"',
        '-C', str(workspace), '--output-last-message', str(output), '-'
    ]
    prompt = sys.stdin.read()
    proc = subprocess.run(cmd, input=prompt, text=True, env=env)
    raise SystemExit(proc.returncode)
finally:
    shutil.rmtree(tmp_home, ignore_errors=True)
