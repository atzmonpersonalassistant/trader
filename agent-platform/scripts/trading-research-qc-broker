#!/usr/bin/env bash
set -euo pipefail
umask 077

export HOME=${TRADING_RESEARCH_RUNNER_HOME:-/home/agent-research}
export PATH=/usr/local/bin:/usr/bin:/bin
export PYTHONDONTWRITEBYTECODE=1

QC_ENV=${TRADING_QUANTCONNECT_ENV_FILE:-/etc/trading-agents/secrets/quantconnect/env}
LEAN_WORKSPACE=${TRADING_RESEARCH_LEAN_WORKSPACE:-/agents/research/lean-workspace}
MODE=${1:-}
RUN_DIR=${2:-}
CANDIDATE_JSON=${3:-}
DRY_RUN=${4:-}

usage() {
  echo "usage: trading-research-qc-broker {preflight|research-artifact|execute-research-artifact} RUN_DIR CANDIDATE_JSON [--dry-run]" >&2
}

if [[ "$MODE" != "preflight" && "$MODE" != "research-artifact" && "$MODE" != "execute-research-artifact" ]]; then
  usage
  exit 64
fi
if [[ -z "$RUN_DIR" || -z "$CANDIDATE_JSON" || ( $# -ne 3 && $# -ne 4 ) ]]; then
  usage
  exit 64
fi
if [[ $# -eq 4 && "$DRY_RUN" != "--dry-run" ]]; then
  usage
  exit 64
fi
if [[ "$MODE" != "research-artifact" && -n "$DRY_RUN" ]]; then
  echo "ERROR: --dry-run is only supported for research-artifact" >&2
  usage
  exit 64
fi

case "$RUN_DIR" in
  /agents/research/reports/research-pass-*) ;;
  *) echo "ERROR: run dir must be an approved research-pass directory" >&2; exit 67 ;;
esac
if [[ -L "$RUN_DIR" || ! -d "$RUN_DIR" || ! -w "$RUN_DIR" ]]; then
  echo "ERROR: run dir is not usable" >&2
  exit 66
fi
if [[ -L "$CANDIDATE_JSON" || ! -r "$CANDIDATE_JSON" ]]; then
  echo "ERROR: candidate json is not readable" >&2
  exit 66
fi
RUN_REAL="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$RUN_DIR")"
CANDIDATE_REAL="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$CANDIDATE_JSON")"
case "$RUN_REAL" in
  /agents/research/reports/research-pass-*) ;;
  *) echo "ERROR: resolved run dir escaped reports" >&2; exit 69 ;;
esac
case "$CANDIDATE_REAL" in
  "$RUN_REAL"/candidate.json) ;;
  *) echo "ERROR: candidate json must belong to run dir" >&2; exit 68 ;;
esac

if [[ "$MODE" == "research-artifact" || "$MODE" == "execute-research-artifact" ]]; then
  if [[ "$DRY_RUN" == "--dry-run" ]]; then
    echo QC_BROKER_RESEARCH_ARTIFACT_DRY_RUN
    exit 0
  fi
  OUT_JSON="$RUN_REAL/qc_research_artifact_manifest.json"
  OUT_MD="$RUN_REAL/qc_research_artifact_summary.md"
  OUT_PY="$RUN_REAL/qc_option_history_probe.py"
  OUT_EXTRACT="$RUN_REAL/qc_option_history_extract.json"
  OUT_EXEC_DIAG="$RUN_REAL/qc_research_execution_diagnostic.json"
  TMP_JSON="$OUT_JSON.tmp.$$"
  TMP_MD="$OUT_MD.tmp.$$"
  TMP_PY="$OUT_PY.tmp.$$"
  TMP_EXTRACT="$OUT_EXTRACT.tmp.$$"
  TMP_EXEC_DIAG="$OUT_EXEC_DIAG.tmp.$$"
  EXEC_DIR=""
  EXEC_STDOUT=""
  EXEC_STDERR=""
  PY_IMPORT_STDERR=""
  DOCKER_LOG=""
  LEAN_HELP_LOG=""
  LEAN_WHOAMI_LOG=""
  LEAN_LOGIN_LOG=""
  trap 'rm -f "$TMP_JSON" "$TMP_MD" "$TMP_PY" "$TMP_EXTRACT" "$TMP_EXEC_DIAG" "$EXEC_STDOUT" "$EXEC_STDERR" "$PY_IMPORT_STDERR" "$DOCKER_LOG" "$LEAN_HELP_LOG" "$LEAN_WHOAMI_LOG" "$LEAN_LOGIN_LOG"; if [[ -n "$EXEC_DIR" ]]; then rm -rf "$EXEC_DIR"; fi' EXIT

  python3 - "$CANDIDATE_REAL" "$TMP_JSON" "$TMP_MD" "$TMP_PY" <<'PY'
import json
import re
import sys
import time
from pathlib import Path

candidate_path, manifest_path, summary_path, script_path = map(Path, sys.argv[1:])
payload = json.loads(candidate_path.read_text(encoding="utf-8"))
c = payload.get("candidate") or payload

def safe_symbol(value):
    token = re.sub(r"[^A-Za-z0-9._-]", "", str(value or "").upper())
    return token[:12] or "SPY"

universe = c.get("universe") or []
symbols = []
for item in universe:
    symbol = safe_symbol(item)
    if symbol not in symbols:
        symbols.append(symbol)
symbols = symbols[:3] or ["SPY"]

manifest = {
    "type": "qc_broker_research_artifact",
    "ok": True,
    "status": "generated_probe_pending_execution",
    "extraction_status": "execution_attempt_pending",
    "extraction_reason": "The broker generated a bounded QC/QuantBook extraction artifact and will attempt the available non-interactive local execution surfaces before handing work to the offline runner.",
    "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "candidate": {
        "id": c.get("id"),
        "family": c.get("family"),
        "universe": symbols,
        "timeframe": c.get("timeframe"),
        "structure": c.get("structure"),
        "thesis": c.get("thesis"),
    },
    "bounded_limits": {
        "max_underlyings": 3,
        "history_lookback_days": 30,
        "option_chain_expiry_window_days": 90,
        "max_contract_rows_per_underlying": 200,
        "cloud_backtest_submitted": False,
        "live_trading_or_orders": False,
    },
    "artifacts": [
        {
            "path": "qc_option_history_probe.py",
            "kind": "quantbook_script",
            "description": "QC Research / QuantBook script for bounded option-chain and equity-history extraction.",
        }
    ],
    "security_boundary": {
        "raw_quantconnect_credentials_exposed_to_codex": False,
        "contains_tokens_or_secret_paths": False,
        "runner_may_read": True,
    },
    "next_research_instruction": "Use qc_option_history_extract.json when present. Otherwise inspect qc_research_execution_diagnostic.json for the exact authenticated QC/Lean execution surface that was unavailable. Do not treat qc_option_history_probe.py as extracted market data.",
    "extracted_artifacts": [],
    "required_next_artifact": "qc_option_history_extract.json",
    "capability_gap": "Execution attempt has not completed yet.",
}

script = f'''# Bounded QC Research / QuantBook artifact generated by trading-research-qc-broker.
# Research only: no live trading, no orders, no brokerage operations.
from AlgorithmImports import *
from QuantConnect import Resolution
import json

UNDERLYINGS = {symbols!r}
HISTORY_LOOKBACK_DAYS = 30
EXPIRY_WINDOW_DAYS = 90
MAX_CONTRACT_ROWS_PER_UNDERLYING = 200

qb = QuantBook()
rows = []
history_summary = {{}}

for ticker in UNDERLYINGS:
    equity = qb.AddEquity(ticker, Resolution.Daily)
    option = qb.AddOption(ticker, Resolution.Minute)
    chain = qb.OptionChainProvider.GetOptionContractList(equity.Symbol, qb.Time)
    filtered = []
    for contract in chain:
        sid = contract.ID
        dte = (sid.Date.date() - qb.Time.date()).days
        if 0 <= dte <= EXPIRY_WINDOW_DAYS:
            filtered.append({{
                "underlying": ticker,
                "symbol": str(contract),
                "expiry": sid.Date.strftime("%Y-%m-%d"),
                "strike": float(sid.StrikePrice),
                "right": str(sid.OptionRight),
                "style": str(sid.OptionStyle),
                "dte": dte,
            }})
        if len(filtered) >= MAX_CONTRACT_ROWS_PER_UNDERLYING:
            break
    rows.extend(filtered)
    hist = qb.History(equity.Symbol, HISTORY_LOOKBACK_DAYS, Resolution.Daily)
    history_summary[ticker] = {{
        "rows": int(0 if hist is None else len(hist)),
        "lookback_days": HISTORY_LOOKBACK_DAYS,
    }}

artifact = {{
    "type": "qc_option_history_extract",
    "underlyings": UNDERLYINGS,
    "history_summary": history_summary,
    "option_contract_rows": rows,
    "limits": {{
        "history_lookback_days": HISTORY_LOOKBACK_DAYS,
        "expiry_window_days": EXPIRY_WINDOW_DAYS,
        "max_contract_rows_per_underlying": MAX_CONTRACT_ROWS_PER_UNDERLYING,
    }},
}}
with open("qc_option_history_extract.json", "w") as fh:
    json.dump(artifact, fh, indent=2, sort_keys=True)
print(json.dumps({{"ok": True, "artifact": "qc_option_history_extract.json", "contract_rows": len(rows)}}))
'''

summary = [
    "# QC broker research artifact",
    "",
    "Status: `generated_probe_pending_execution`",
    "",
    "Generated a bounded QC/QuantBook extraction script and queued a broker-side execution attempt.",
    "This is not extracted market data unless `qc_option_history_extract.json` exists.",
    "",
    "## Limits",
    "- max_underlyings: 3",
    "- history_lookback_days: 30",
    "- option_chain_expiry_window_days: 90",
    "- max_contract_rows_per_underlying: 200",
    "- cloud_backtest_submitted: false",
    "- live_trading_or_orders: false",
    "",
    "## Files",
    "- `qc_option_history_probe.py`: run inside QC Research / QuantBook to write `qc_option_history_extract.json`.",
    "- `qc_option_history_extract.json`: bounded extracted data, only when execution succeeds.",
    "- `qc_research_execution_diagnostic.json`: structured non-secret failure details, only when execution cannot produce the extract.",
    "",
    "Raw QC credentials were not written to this artifact.",
]

manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
summary_path.write_text("\n".join(summary) + "\n", encoding="utf-8")
script_path.write_text(script, encoding="utf-8")
PY
  mv "$TMP_JSON" "$OUT_JSON"
  mv "$TMP_MD" "$OUT_MD"
  mv "$TMP_PY" "$OUT_PY"

  mkdir -p "$LEAN_WORKSPACE"
  EXEC_DIR="$(mktemp -d "$LEAN_WORKSPACE/qc-research-artifact.XXXXXX")"
  EXEC_STDOUT="$(mktemp)"
  EXEC_STDERR="$(mktemp)"
  PY_IMPORT_STDERR="$(mktemp)"
  DOCKER_LOG="$(mktemp)"
  LEAN_HELP_LOG="$(mktemp)"
  LEAN_WHOAMI_LOG="$(mktemp)"
  LEAN_LOGIN_LOG="$(mktemp)"
  cp "$OUT_PY" "$EXEC_DIR/qc_option_history_probe.py"

  auth_status="not_checked"
  lean_status="lean_missing"
  lean_research_status="not_checked"
  if command -v lean >/dev/null 2>&1; then
    lean_status="present"
    if [[ -r "$QC_ENV" ]]; then
      set -a
      # shellcheck disable=SC1090
      . "$QC_ENV"
      set +a
      if [[ -n "${QUANTCONNECT_USER_ID:-}" && -n "${QUANTCONNECT_API_TOKEN:-}" ]]; then
        printf "%s\n" "$QUANTCONNECT_API_TOKEN" | /usr/bin/timeout 60s lean login --user-id "$QUANTCONNECT_USER_ID" >"$LEAN_LOGIN_LOG" 2>&1 || true
      fi
      unset QUANTCONNECT_USER_ID QUANTCONNECT_API_TOKEN || true
    fi
    if /usr/bin/timeout 60s lean whoami >"$LEAN_WHOAMI_LOG" 2>&1; then
      auth_status="authenticated"
    else
      auth_status="auth_failure"
    fi
    /usr/bin/timeout 20s lean --help >"$LEAN_HELP_LOG" 2>&1 || true
    if grep -Eiq "(research|notebook|quantbook)" "$LEAN_HELP_LOG"; then
      lean_research_status="detected_but_noninteractive_runner_not_configured"
    else
      lean_research_status="non_interactive_research_execution_unsupported"
    fi
  else
    auth_status="lean_cli_missing"
    lean_research_status="lean_missing"
  fi

  execution_status="extract_unavailable"
  execution_surface="local_python_quantbook_script"
  execution_rc=127
  local_python_runtime_status="not_checked"
  if command -v python3 >/dev/null 2>&1; then
    if /usr/bin/timeout 20s python3 - <<'PY' 2>"$PY_IMPORT_STDERR"
import clr  # noqa: F401
import QuantConnect  # noqa: F401
PY
    then
      local_python_runtime_status="quantconnect_python_runtime_present"
    else
      local_python_runtime_status="quantconnect_python_runtime_missing"
    fi
    set +e
    (cd "$EXEC_DIR" && /usr/bin/timeout 120s python3 qc_option_history_probe.py >"$EXEC_STDOUT" 2>"$EXEC_STDERR")
    execution_rc=$?
    set -e
    if [[ "$execution_rc" == "0" && -s "$EXEC_DIR/qc_option_history_extract.json" ]]; then
      python3 - "$EXEC_DIR/qc_option_history_extract.json" "$TMP_EXTRACT" <<'PY'
import json, sys
src, dst = sys.argv[1], sys.argv[2]
payload = json.load(open(src, encoding="utf-8"))
if payload.get("type") != "qc_option_history_extract":
    raise SystemExit("unexpected extract type")
rows = payload.get("option_contract_rows") or []
underlyings = payload.get("underlyings") or []
limits = payload.get("limits") or {}
if len(underlyings) > 3:
    raise SystemExit("extract exceeds max underlyings")
if int(limits.get("history_lookback_days", 0)) > 30:
    raise SystemExit("extract exceeds history lookback")
if int(limits.get("expiry_window_days", 0)) > 90:
    raise SystemExit("extract exceeds expiry window")
if len(rows) > max(1, len(underlyings)) * 200:
    raise SystemExit("extract exceeds contract row limit")
open(dst, "w", encoding="utf-8").write(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
PY
      mv "$TMP_EXTRACT" "$OUT_EXTRACT"
      execution_status="extract_written"
    fi
  else
    local_python_runtime_status="python_missing"
  fi

  docker_status="not_checked"
  docker_image=""
  if [[ "$execution_status" != "extract_written" ]]; then
    if command -v docker >/dev/null 2>&1; then
      if /usr/bin/timeout 20s docker info >"$DOCKER_LOG" 2>&1; then
        docker_status="running_no_quantconnect_lean_image"
        docker_image="$(/usr/bin/timeout 20s docker image ls --format '{{.Repository}}:{{.Tag}}' 2>>"$DOCKER_LOG" | grep -E '(^|/)quantconnect/(lean|research|foundation)|lean.*quantconnect' | head -n 1 || true)"
        if [[ -n "$docker_image" ]]; then
          docker_status="attempted_existing_quantconnect_lean_image"
          execution_surface="lean_docker_quantconnect_python_runtime"
          set +e
          /usr/bin/timeout 180s docker run --rm \
            -v "$EXEC_DIR:/work" \
            -w /work \
            --network none \
            "$docker_image" \
            python qc_option_history_probe.py >"$EXEC_STDOUT" 2>>"$EXEC_STDERR"
          execution_rc=$?
          set -e
          if [[ "$execution_rc" == "0" && -s "$EXEC_DIR/qc_option_history_extract.json" ]]; then
            python3 - "$EXEC_DIR/qc_option_history_extract.json" "$TMP_EXTRACT" <<'PY'
import json, sys
src, dst = sys.argv[1], sys.argv[2]
payload = json.load(open(src, encoding="utf-8"))
if payload.get("type") != "qc_option_history_extract":
    raise SystemExit("unexpected extract type")
rows = payload.get("option_contract_rows") or []
underlyings = payload.get("underlyings") or []
limits = payload.get("limits") or {}
if len(underlyings) > 3:
    raise SystemExit("extract exceeds max underlyings")
if int(limits.get("history_lookback_days", 0)) > 30:
    raise SystemExit("extract exceeds history lookback")
if int(limits.get("expiry_window_days", 0)) > 90:
    raise SystemExit("extract exceeds expiry window")
if len(rows) > max(1, len(underlyings)) * 200:
    raise SystemExit("extract exceeds contract row limit")
open(dst, "w", encoding="utf-8").write(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
PY
            mv "$TMP_EXTRACT" "$OUT_EXTRACT"
            execution_status="extract_written"
          fi
        fi
      else
        docker_status="docker_not_running"
      fi
    else
      docker_status="docker_missing"
    fi
  fi

  if [[ "$execution_status" != "extract_written" ]]; then
    python3 - "$TMP_EXEC_DIAG" "$auth_status" "$lean_status" "$lean_research_status" "$local_python_runtime_status" "$docker_status" "$docker_image" "$execution_surface" "$execution_rc" "$EXEC_STDOUT" "$EXEC_STDERR" "$PY_IMPORT_STDERR" "$DOCKER_LOG" "$LEAN_HELP_LOG" "$LEAN_WHOAMI_LOG" <<'PY'
import json, re, sys, time
(
    path,
    auth_status,
    lean_status,
    lean_research_status,
    python_runtime_status,
    docker_status,
    docker_image,
    surface,
    rc,
    stdout_path,
    stderr_path,
    py_import_stderr_path,
    docker_log_path,
    help_path,
    whoami_path,
) = sys.argv[1:]

def read_limited(p, limit=2000):
    try:
        text = open(p, errors="replace").read()
    except OSError:
        return ""
    text = re.sub(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "<redacted-email>", text)
    text = re.sub(r"(?i)(token|api[_-]?key|password)\s*[:=]\s*\S+", r"\1=<redacted>", text)
    text = re.sub(r"(?i)(QUANTCONNECT_API_TOKEN|QUANTCONNECT_USER_ID)=\S+", r"\1=<redacted>", text)
    return text.strip()[:limit]

lean_help = read_limited(help_path)
known_research_terms = [term for term in ("research", "notebook", "quantbook") if term in lean_help.lower()]
if auth_status == "auth_failure":
    status = "auth_failure"
    reason = "Lean CLI authentication check failed for the broker role; no raw credentials were exposed to the runner."
elif auth_status == "lean_cli_missing":
    status = "lean_missing"
    reason = "Lean CLI is not installed or not on PATH for the broker role, so no authenticated QC Research execution surface is available."
elif python_runtime_status in ("quantconnect_python_runtime_missing", "python_missing"):
    status = "quantconnect_python_runtime_missing"
    reason = "Local Python cannot import the QuantConnect research runtime (clr/QuantConnect), so the bounded QuantBook probe cannot run directly."
elif docker_status in ("docker_missing", "docker_not_running"):
    status = docker_status
    reason = "Docker is required for the next local LEAN/QC runtime fallback, but it is missing or unavailable for the broker role."
elif lean_research_status == "non_interactive_research_execution_unsupported":
    status = "non_interactive_research_execution_unsupported"
    reason = "Lean CLI is authenticated, but this installed CLI did not advertise a non-interactive research/notebook execution command."
else:
    status = "cost_credit_guardrail_required"
    reason = "Local Lean/Python/Docker surfaces did not produce an extract. QuantConnect cloud/API execution was not submitted because it may consume credits or cloud resources without an explicit bounded approval path."

payload = {
    "type": "qc_research_execution_diagnostic",
    "ok": False,
    "status": status,
    "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "auth_status": auth_status,
    "attempted_surface": surface,
    "attempted_command": "timeout 120s python3 qc_option_history_probe.py",
    "exit_code": int(rc),
    "surface_checks": {
        "lean_cli": lean_status,
        "lean_research_noninteractive": lean_research_status,
        "local_python_quantconnect_runtime": python_runtime_status,
        "docker": docker_status,
        "docker_image": docker_image or None,
        "cloud_or_api_research": "cost_credit_guardrail_required",
    },
    "extract_artifact": "qc_option_history_extract.json",
    "extract_written": False,
    "reason": reason,
    "lean_cli_research_terms_detected": known_research_terms,
    "lean_cli_help_redacted_excerpt": lean_help[:2000],
    "lean_whoami_redacted_excerpt": read_limited(whoami_path, 1000),
    "python_import_stderr_redacted_excerpt": read_limited(py_import_stderr_path),
    "docker_redacted_excerpt": read_limited(docker_log_path),
    "stdout_redacted_excerpt": read_limited(stdout_path),
    "stderr_redacted_excerpt": read_limited(stderr_path),
    "bounded_limits": {
        "max_underlyings": 3,
        "history_lookback_days": 30,
        "option_chain_expiry_window_days": 90,
        "max_contract_rows_per_underlying": 200,
        "cloud_backtest_submitted": False,
        "live_trading_or_orders": False,
    },
    "security_boundary": {
        "raw_quantconnect_credentials_exposed_to_codex": False,
        "contains_tokens_or_secret_paths": False,
        "runner_may_read": True,
    },
    "next_research_instruction": "Use this diagnostic to distinguish auth failure from unavailable QuantBook/QC Research execution. Do not claim extracted option-chain/history data exists unless qc_option_history_extract.json is present.",
}
open(path, "w", encoding="utf-8").write(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
PY
    mv "$TMP_EXEC_DIAG" "$OUT_EXEC_DIAG"
  fi

  python3 - "$OUT_JSON" "$OUT_MD" "$execution_status" "${OUT_EXEC_DIAG#$RUN_REAL/}" "${OUT_EXTRACT#$RUN_REAL/}" <<'PY'
import json, sys
from pathlib import Path
manifest_path, summary_path, execution_status, diag_rel, extract_rel = sys.argv[1:]
manifest = json.load(open(manifest_path, encoding="utf-8"))
summary = Path(summary_path).read_text(encoding="utf-8").splitlines()
if execution_status == "extract_written":
    manifest["status"] = "executed_extract_available"
    manifest["extraction_status"] = "extract_written"
    manifest["extraction_reason"] = "The broker executed the bounded QC/QuantBook probe through an available non-interactive local surface and wrote qc_option_history_extract.json."
    manifest["extracted_artifacts"] = [extract_rel]
    manifest["capability_gap"] = None
    manifest["artifacts"].append({"path": extract_rel, "kind": "bounded_option_history_extract", "description": "Bounded option-chain/history content produced by the broker."})
    status_line = "Status: `executed_extract_available`"
    detail = "Broker execution produced `qc_option_history_extract.json`."
else:
    diag = json.load(open(Path(manifest_path).with_name(diag_rel), encoding="utf-8"))
    manifest["status"] = "execution_diagnostic"
    manifest["extraction_status"] = diag["status"]
    manifest["extraction_reason"] = diag["reason"]
    manifest["extracted_artifacts"] = []
    manifest["capability_gap"] = diag["status"]
    manifest["artifacts"].append({"path": diag_rel, "kind": "structured_execution_diagnostic", "description": "Non-secret failure details written when no authenticated non-interactive QuantBook/QC Research execution surface produces the extract."})
    status_line = "Status: `execution_diagnostic`"
    detail = "Broker execution did not produce extracted market data; inspect `qc_research_execution_diagnostic.json` for the exact non-secret capability failure."
for i, line in enumerate(summary):
    if line.startswith("Status: `"):
        summary[i] = status_line
        break
summary.extend(["", "## Execution", detail])
open(manifest_path, "w", encoding="utf-8").write(json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
Path(summary_path).write_text("\n".join(summary) + "\n", encoding="utf-8")
PY

  chmod 640 "$OUT_JSON" "$OUT_MD" "$OUT_PY"
  if [[ -e "$OUT_EXTRACT" ]]; then chmod 640 "$OUT_EXTRACT"; fi
  if [[ -e "$OUT_EXEC_DIAG" ]]; then chmod 640 "$OUT_EXEC_DIAG"; fi
  if [[ "$execution_status" == "extract_written" ]]; then
    echo QC_BROKER_RESEARCH_ARTIFACT_OK
  else
    echo QC_BROKER_RESEARCH_ARTIFACT_DIAGNOSTIC
  fi
  exit 0
fi

OUT_JSON="$RUN_REAL/qc_broker_artifacts.json"
OUT_MD="$RUN_REAL/qc_broker_summary.md"
TMP_JSON="$OUT_JSON.tmp.$$"
TMP_MD="$OUT_MD.tmp.$$"
LOGIN_LOG="$(mktemp)"
WHOAMI_LOG="$(mktemp)"
trap 'rm -f "$LOGIN_LOG" "$WHOAMI_LOG" "$TMP_JSON" "$TMP_MD"' EXIT

python3 - "$CANDIDATE_REAL" > "$RUN_REAL/qc_broker_candidate_summary.json" <<'PY'
import json, sys
payload=json.load(open(sys.argv[1]))
c=payload.get('candidate') or payload
safe={
  'id': c.get('id'),
  'family': c.get('family'),
  'universe': c.get('universe') or [],
  'timeframe': c.get('timeframe'),
  'thesis': c.get('thesis'),
  'structure': c.get('structure'),
}
print(json.dumps(safe, ensure_ascii=False, indent=2, sort_keys=True))
PY

status="ok"
errors=()
dns_ok=false
https_ok=false
env_ok=false
lean_installed=false
lean_login_ok=false
lean_whoami_ok=false
lean_whoami_redacted=""

if getent hosts www.quantconnect.com >/dev/null; then
  dns_ok=true
else
  status="blocked"
  errors+=("QuantConnect DNS resolution failed")
fi

if python3 - <<'PY'
import urllib.error, urllib.request
for url in ("https://www.quantconnect.com", "https://www.quantconnect.com/api/v2/"):
    req=urllib.request.Request(url, method="HEAD")
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            if r.status >= 500:
                raise SystemExit(1)
    except urllib.error.HTTPError as exc:
        if exc.code >= 500:
            raise SystemExit(1)
PY
then
  https_ok=true
else
  status="blocked"
  errors+=("QuantConnect HTTPS connectivity failed")
fi

if [[ -r "$QC_ENV" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$QC_ENV"
  set +a
  if [[ -n "${QUANTCONNECT_USER_ID:-}" && -n "${QUANTCONNECT_API_TOKEN:-}" ]]; then
    env_ok=true
  else
    status="blocked"
    errors+=("QuantConnect env is missing required variables")
  fi
else
  status="blocked"
  errors+=("QuantConnect env file is not readable")
fi

if command -v lean >/dev/null 2>&1; then
  lean_installed=true
else
  status="blocked"
  errors+=("Lean CLI is not installed or not on PATH")
fi

if [[ "$env_ok" == true && "$lean_installed" == true ]]; then
  mkdir -p "$LEAN_WORKSPACE"
  cd "$LEAN_WORKSPACE"
  if printf "%s\n" "$QUANTCONNECT_API_TOKEN" | /usr/bin/timeout 60s lean login --user-id "$QUANTCONNECT_USER_ID" >"$LOGIN_LOG" 2>&1; then
    lean_login_ok=true
  else
    status="blocked"
    errors+=("lean login failed")
  fi
  if /usr/bin/timeout 60s lean whoami >"$WHOAMI_LOG" 2>&1; then
    lean_whoami_ok=true
    lean_whoami_redacted="$(python3 - "$WHOAMI_LOG" <<'PY'
import re, sys
text=open(sys.argv[1], errors='replace').read()
text=re.sub(r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}', '<redacted-email>', text)
text=re.sub(r'(?i)(token|api[_-]?key|password)\s*[:=]\s*\S+', r'\1=<redacted>', text)
print(text.strip()[:1000])
PY
)"
  else
    status="blocked"
    errors+=("lean whoami failed")
  fi
fi
unset QUANTCONNECT_USER_ID QUANTCONNECT_API_TOKEN || true

python3 - "$TMP_JSON" "$status" "$dns_ok" "$https_ok" "$env_ok" "$lean_installed" "$lean_login_ok" "$lean_whoami_ok" "$lean_whoami_redacted" "${errors[@]}" <<'PY'
import json, sys, time
path=sys.argv[1]
status=sys.argv[2]
keys=['dns_ok','https_ok','env_ok','lean_installed','lean_login_ok','lean_whoami_ok']
vals={k: (sys.argv[i+3]=='true') for i,k in enumerate(keys)}
whoami=sys.argv[9]
errors=sys.argv[10:]
payload={
  'type':'qc_broker_preflight',
  'ok': status == 'ok',
  'status': status,
  'generated_at_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
  'checks': vals,
  'lean_whoami_redacted': whoami,
  'errors': errors,
  'security_boundary': {
    'raw_quantconnect_credentials_exposed_to_codex': False,
    'codex_network_required': False,
    'broker_role': 'authenticated QC/Lean preflight and artifact generation only',
  },
  'next_research_instruction': 'Use this artifact to determine QC auth/connectivity status. Do not claim raw credentials are available. If ok=true, proceed with QC-compatible notebook/backtest artifacts; if deeper online QC calls are required, request/define a broker artifact rather than reading secrets.',
}
open(path,'w').write(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
PY

python3 - "$TMP_JSON" "$TMP_MD" <<'PY'
import json, sys
p=json.load(open(sys.argv[1]))
lines=['# QC broker preflight', '', f"Status: `{p['status']}`", '', '## Checks']
for k,v in p['checks'].items():
    lines.append(f"- {k}: {'OK' if v else 'FAIL'}")
if p.get('lean_whoami_redacted'):
    lines += ['', '## Lean whoami redacted', '', '```', p['lean_whoami_redacted'], '```']
if p.get('errors'):
    lines += ['', '## Errors'] + [f"- {e}" for e in p['errors']]
lines += ['', 'Raw QC credentials were not written to this artifact.']
open(sys.argv[2],'w').write('\n'.join(lines)+'\n')
PY

mv "$TMP_JSON" "$OUT_JSON"
mv "$TMP_MD" "$OUT_MD"
chmod 640 "$OUT_JSON" "$OUT_MD" "$RUN_REAL/qc_broker_candidate_summary.json"

if [[ "$status" == "ok" ]]; then
  echo QC_BROKER_PREFLIGHT_OK
  exit 0
fi
echo QC_BROKER_PREFLIGHT_BLOCKED >&2
exit 1
