#!/usr/bin/env bash
set -euo pipefail
umask 077

export HOME=${TRADING_RESEARCH_HOME:-/home/agent-research}
export PATH=/usr/local/bin:/usr/bin:/bin
export PYTHONDONTWRITEBYTECODE=1

QC_ENV=${TRADING_QUANTCONNECT_ENV_FILE:-/etc/trading-agents/secrets/quantconnect/env}
LEAN_WORKSPACE=${TRADING_RESEARCH_LEAN_WORKSPACE:-/agents/research/lean-workspace}
REPORTS_ROOT=${TRADING_RESEARCH_REPORTS_DIR:-/agents/research/reports}
MODE=${1:-}
RUN_DIR=${2:-}
CANDIDATE_JSON=${3:-}
SUBMIT=${4:-}

usage() {
  cat >&2 <<'EOF'
usage: trading-research-qc-cloud-run prepare|run RUN_DIR CANDIDATE_JSON [--submit]

prepare: generate a bounded QuantConnect cloud project and artifacts, no cloud run.
run:     same as prepare; requires --submit to push and run cloud backtest.

Guardrails:
- no live trading
- no orders except defined-risk backtest strategy orders inside QC backtest
- max 3 symbols
- one QC cloud backtest per invocation
- raw QC credentials stay in QC_ENV/Lean CLI; not written to artifacts
EOF
}

if [[ "$MODE" != "prepare" && "$MODE" != "run" ]]; then usage; exit 64; fi
if [[ -z "$RUN_DIR" || -z "$CANDIDATE_JSON" || ( $# -ne 3 && $# -ne 4 ) ]]; then usage; exit 64; fi
if [[ $# -eq 4 && "$SUBMIT" != "--submit" ]]; then usage; exit 64; fi
if [[ "$MODE" == "run" && "$SUBMIT" != "--submit" ]]; then
  echo "ERROR: run mode requires explicit --submit" >&2
  exit 64
fi

REPORTS_REAL="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$REPORTS_ROOT")"
case "$RUN_DIR" in "$REPORTS_ROOT"/research-pass-*|"$REPORTS_ROOT"/qc-run-*) ;; *) echo "ERROR: run dir must be under reports root as research-pass-* or qc-run-*" >&2; exit 67 ;; esac
if [[ -L "$RUN_DIR" || ! -d "$RUN_DIR" || ! -w "$RUN_DIR" ]]; then echo "ERROR: unusable run dir" >&2; exit 66; fi
if [[ -L "$CANDIDATE_JSON" || ! -r "$CANDIDATE_JSON" ]]; then echo "ERROR: unreadable candidate json" >&2; exit 66; fi
RUN_REAL="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$RUN_DIR")"
CANDIDATE_REAL="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$CANDIDATE_JSON")"
case "$RUN_REAL" in "$REPORTS_REAL"/research-pass-*|"$REPORTS_REAL"/qc-run-*) ;; *) echo "ERROR: resolved run dir escaped reports" >&2; exit 69 ;; esac
case "$CANDIDATE_REAL" in "$RUN_REAL"/*) ;; *) echo "ERROR: candidate must be under run dir" >&2; exit 68 ;; esac

OUT_MANIFEST="$RUN_REAL/qc_cloud_run_manifest.json"
OUT_SUMMARY="$RUN_REAL/qc_cloud_run_summary.md"
OUT_STDOUT="$RUN_REAL/qc_cloud_backtest_stdout.log"
OUT_STDERR="$RUN_REAL/qc_cloud_backtest_stderr.log"
OUT_PROJECT_TGZ="$RUN_REAL/qc_cloud_project.tgz"
RUN_ID="$(basename "$RUN_REAL")"
PROJECT_ROOT="$LEAN_WORKSPACE/cloud-runs/$RUN_ID"
PROJECT_NAME="trader-${RUN_ID}-qc-cloud"
PROJECT_DIR="$PROJECT_ROOT/$PROJECT_NAME"
QC_PROJECT_REF="cloud-runs/$RUN_ID/$PROJECT_NAME"

sanitize_log() {
  python3 - "$1" <<'PY'
import re, sys
p=sys.argv[1]
try:
    text=open(p, encoding='utf-8', errors='replace').read()
except FileNotFoundError:
    text=''
patterns=[
    r'(?i)(api[_-]?token|token|secret|password)(\s*[=:]\s*)\S+',
    r'(?i)(Authorization:\s*Bearer\s+)\S+',
    r'(?i)(QUANTCONNECT_API_TOKEN=)\S+',
]
for pat in patterns:
    text=re.sub(pat, lambda m: m.group(1) + (m.group(2) if m.lastindex and m.lastindex>=2 else '') + '<redacted>', text)
print(text[:12000])
PY
}

mkdir -p "$PROJECT_DIR"
chmod 700 "$PROJECT_ROOT" "$PROJECT_DIR"

python3 - "$CANDIDATE_REAL" "$PROJECT_DIR" "$OUT_MANIFEST.tmp" "$PROJECT_NAME" <<'PY'
import json, re, sys, time
from pathlib import Path
candidate_path=Path(sys.argv[1]); project_dir=Path(sys.argv[2]); manifest_path=Path(sys.argv[3]); project_name=sys.argv[4]
payload=json.loads(candidate_path.read_text(encoding='utf-8'))
c=payload.get('candidate') or payload

def safe_symbol(x):
    s=re.sub(r'[^A-Za-z0-9._-]', '', str(x or '').upper())[:12]
    return s or None
symbols=[]
for key in ('symbol','underlying','ticker'):
    s=safe_symbol(c.get(key))
    if s and s not in symbols: symbols.append(s)
for item in c.get('universe') or []:
    s=safe_symbol(item)
    if s and s not in symbols: symbols.append(s)
symbols=(symbols or ['SPY','QQQ'])[:3]
strategy=str(c.get('strategy') or c.get('hypothesis') or 'pullback_bull_call_spread')[:80]
start=str(c.get('start') or '2018-01-01')
end=str(c.get('end') or '2026-01-01')
if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', start):
    start='2018-01-01'
if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', end):
    end='2026-01-01'
symbols_csv=','.join(symbols)
start_literal=json.dumps(start)
end_literal=json.dumps(end)
symbols_csv_literal=json.dumps(symbols_csv)
strategy_literal=json.dumps(strategy)

main = f'''# region imports
from AlgorithmImports import *
# endregion

import json
from datetime import timedelta

class TraderCloudStrategyFinder(QCAlgorithm):
    """Bounded QC cloud research harness generated by trading-research-qc-cloud-run.

    Purpose: use QuantConnect cloud data/backtest runtime to evaluate candidate
    option/equity strategy evidence. No live trading. One backtest only.
    """

    def initialize(self):
        self.set_start_date(*map(int, self.get_parameter("start", {start_literal}).split("-")))
        self.set_end_date(*map(int, self.get_parameter("end", {end_literal}).split("-")))
        self.set_cash(100000)
        self.set_brokerage_model(BrokerageName.INTERACTIVE_BROKERS_BROKERAGE, AccountType.MARGIN)
        self.universe_settings.resolution = Resolution.HOUR
        self.symbol_names = [x.strip().upper() for x in self.get_parameter("symbols", {symbols_csv_literal}).split(",") if x.strip()][:3]
        self.strategy_name = self.get_parameter("strategy", {strategy_literal})
        self.equities = []
        self.option_by_equity = {{}}
        self.sma200 = {{}}
        self.rsi14 = {{}}
        self.high20 = {{}}
        self.pending = {{}}
        self.current = None
        self.trades = []
        self.signals = []
        self.chain_stats = []
        self.stats = {{"signals":0,"entries":0,"entry_fail_no_chain":0,"entry_fail_no_spread":0,"exits":0}}
        for name in self.symbol_names:
            eq = self.add_equity(name, Resolution.HOUR)
            eq.set_data_normalization_mode(DataNormalizationMode.RAW)
            opt = self.add_option(name, Resolution.HOUR)
            opt.set_filter(lambda u: u.calls_only().delta(0.20, 0.60).expiration(21, 75).strikes(-20, 20))
            self.equities.append(eq.symbol)
            self.option_by_equity[eq.symbol] = opt.symbol
            self.sma200[eq.symbol] = self.sma(eq.symbol, 200, Resolution.DAILY)
            self.rsi14[eq.symbol] = self.rsi(eq.symbol, 14, MovingAverageType.WILDERS, Resolution.DAILY)
            hi = Maximum(20)
            self.register_indicator(eq.symbol, hi, Resolution.DAILY, lambda bar: bar.high)
            self.high20[eq.symbol] = hi
            self.schedule.on(self.date_rules.every_day(eq.symbol), self.time_rules.before_market_close(eq.symbol, 5), lambda s=eq.symbol: self.capture_signal(s))
            self.schedule.on(self.date_rules.every_day(eq.symbol), self.time_rules.after_market_open(eq.symbol, 10), lambda s=eq.symbol: self.try_enter(s))
        self.set_warmup(260, Resolution.DAILY)

    def capture_signal(self, symbol):
        if self.is_warming_up or self.portfolio.invested: return
        if not (self.sma200[symbol].is_ready and self.rsi14[symbol].is_ready and self.high20[symbol].is_ready): return
        px=float(self.securities[symbol].price); sma=float(self.sma200[symbol].current.value); rsi=float(self.rsi14[symbol].current.value); hi=float(self.high20[symbol].current.value)
        if hi <= 0 or sma <= 0: return
        pullback=(hi-px)/hi*100.0
        # Simple baseline: uptrend pullback. This is a harness; candidates can replace signal logic.
        if px > sma and 3.0 <= pullback <= 8.0 and 30.0 <= rsi <= 55.0:
            self.stats["signals"] += 1
            self.pending[symbol]={{"date":str(self.time.date()),"symbol":str(symbol),"price":round(px,4),"sma200":round(sma,4),"rsi14":round(rsi,4),"pullback_pct":round(pullback,4)}}
            self.signals.append(self.pending[symbol])

    def try_enter(self, symbol):
        if self.is_warming_up or self.portfolio.invested or symbol not in self.pending: return
        opt_symbol=self.option_by_equity[symbol]
        chain=self.option_chain(opt_symbol, flatten=True)
        if chain is None or len(chain.contracts)==0:
            self.stats["entry_fail_no_chain"] += 1; self.pending.pop(symbol, None); return
        contracts=[c for c in chain if c.right == OptionRight.CALL and c.expiry.date() > self.time.date()]
        if not contracts:
            self.stats["entry_fail_no_spread"] += 1; self.pending.pop(symbol, None); return
        contracts=sorted(contracts, key=lambda c: (abs((c.expiry.date()-self.time.date()).days-45), abs((float(c.greeks.delta) if c.greeks and c.greeks.delta is not None else 0.4)-0.45)))
        long=None; short=None
        for c in contracts:
            d=float(c.greeks.delta) if c.greeks and c.greeks.delta is not None else None
            if d is not None and 0.35 <= d <= 0.55 and c.ask_price > 0 and c.bid_price >= 0:
                long=c; break
        if long is not None:
            same=[c for c in contracts if c.expiry==long.expiry and c.strike>long.strike and c.ask_price>0 and c.bid_price>=0]
            same=sorted(same, key=lambda c: abs((float(c.greeks.delta) if c.greeks and c.greeks.delta is not None else 0.25)-0.25))
            short=same[0] if same else None
        if long is None or short is None:
            self.stats["entry_fail_no_spread"] += 1; self.pending.pop(symbol, None); return
        debit=max(0.01, float(long.ask_price)-float(short.bid_price))
        width=float(short.strike-long.strike)
        if debit <= 0 or width <= 0 or debit > width*0.65:
            self.stats["entry_fail_no_spread"] += 1; self.pending.pop(symbol, None); return
        strat=OptionStrategies.bull_call_spread(opt_symbol, float(long.strike), float(short.strike), long.expiry)
        tickets=self.buy(strat, 1, asynchronous=False, tag="bounded cloud probe bull call spread")
        if tickets:
            self.stats["entries"] += 1
            self.current={{"symbol":str(symbol),"entry":str(self.time),"expiry":str(long.expiry.date()),"long":str(long.symbol),"short":str(short.symbol),"debit_mid":round(debit,4),"width":round(width,4)}}
            self.trades.append(dict(self.current))
        self.pending.pop(symbol, None)

    def on_data(self, data):
        pass

    def on_end_of_algorithm(self):
        result={{
            "type":"qc_cloud_strategy_evidence",
            "strategy":self.strategy_name,
            "symbols":self.symbol_names,
            "start":str(self.start_date.date()),
            "end":str(self.end_date.date()),
            "stats":self.stats,
            "signals_sample":self.signals[-50:],
            "trades_sample":self.trades[-50:],
            "portfolio_value":round(float(self.portfolio.total_portfolio_value), 2),
            "guardrails":{{"live_trading":False,"max_symbols":3,"one_backtest":True,"defined_risk_options_only":True}}
        }}
        self.debug("TRADER_QC_EVIDENCE_JSON=" + json.dumps(result, sort_keys=True))
'''
(project_dir/'main.py').write_text(main, encoding='utf-8')
(project_dir/'config.json').write_text(json.dumps({"algorithm-language":"Python","parameters":{"symbols":','.join(symbols),"strategy":strategy,"start":start,"end":end},"description":"Trader bounded QC cloud strategy evidence harness"}, indent=2)+"\n", encoding='utf-8')
(project_dir/'lean.json').write_text(json.dumps({"algorithm-type-name":"TraderCloudStrategyFinder","algorithm-language":"Python","algorithm-location":"main.py","parameters":{"symbols":','.join(symbols),"strategy":strategy,"start":start,"end":end}}, indent=2)+"\n", encoding='utf-8')
manifest={"type":"qc_cloud_run_manifest","ok":True,"status":"prepared","generated_at_utc":time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),"project_name":project_name,"project_ref":"cloud-runs/" + project_dir.parent.name + "/" + project_name,"project_dir":str(project_dir),"candidate":str(candidate_path),"symbols":symbols,"strategy":strategy,"guardrails":{"live_trading":False,"one_cloud_backtest_per_invocation":True,"max_symbols":3,"no_raw_credentials_in_artifacts":True},"artifacts":["main.py","config.json","lean.json"]}
manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True)+"\n", encoding='utf-8')
PY
mv "$OUT_MANIFEST.tmp" "$OUT_MANIFEST"
tar -C "$PROJECT_ROOT" -czf "$OUT_PROJECT_TGZ" "$PROJECT_NAME"
chmod 640 "$OUT_MANIFEST" "$OUT_PROJECT_TGZ"

cat > "$OUT_SUMMARY" <<EOF
# QC Cloud Run

Status: prepared
Project: $PROJECT_NAME
Project dir: $PROJECT_DIR

Guardrails:
- no live trading
- one cloud backtest per invocation
- max 3 symbols
- credentials remain in Lean/QC auth files, not artifacts

Run command:
\`trading-research-qc-cloud-run run $RUN_REAL $CANDIDATE_REAL --submit\`
EOF
chmod 640 "$OUT_SUMMARY"

if [[ "$MODE" == "prepare" ]]; then
  echo QC_CLOUD_RUN_PREPARED
  exit 0
fi

if [[ ! -r "$QC_ENV" || -L "$QC_ENV" ]]; then
  echo "ERROR: QC env missing/unreadable" >&2
  exit 70
fi
set -a
# shellcheck disable=SC1090
. "$QC_ENV"
set +a
: "${QUANTCONNECT_USER_ID:?missing QUANTCONNECT_USER_ID}"
: "${QUANTCONNECT_API_TOKEN:?missing QUANTCONNECT_API_TOKEN}"

cd "$LEAN_WORKSPACE"
QC_BACKTEST_TIMEOUT_SECONDS=${TRADING_QC_BACKTEST_TIMEOUT_SECONDS:-900}
if ! [[ "$QC_BACKTEST_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] || [[ "$QC_BACKTEST_TIMEOUT_SECONDS" -lt 60 ]]; then
  echo "ERROR: TRADING_QC_BACKTEST_TIMEOUT_SECONDS must be an integer >= 60" >&2
  exit 64
fi
# Ensure Lean is authenticated. Do not print token.
printf '%s\n' "$QUANTCONNECT_API_TOKEN" | lean login --user-id "$QUANTCONNECT_USER_ID" >/dev/null 2>>"$OUT_STDERR" || true
set +e
timeout "$QC_BACKTEST_TIMEOUT_SECONDS" lean cloud push --project "$PROJECT_DIR" >"$OUT_STDOUT" 2>"$OUT_STDERR"
push_rc=$?
if [[ "$push_rc" -eq 0 ]]; then
  timeout "$QC_BACKTEST_TIMEOUT_SECONDS" lean cloud backtest "$QC_PROJECT_REF" --push --name "${RUN_ID}-bounded-strategy-evidence" >>"$OUT_STDOUT" 2>>"$OUT_STDERR"
  backtest_rc=$?
else
  backtest_rc=99
fi
if [[ "$push_rc" -eq 124 ]]; then
  echo "lean cloud push timed out after ${QC_BACKTEST_TIMEOUT_SECONDS}s" >>"$OUT_STDERR"
fi
if [[ "$backtest_rc" -eq 124 ]]; then
  echo "lean cloud backtest timed out after ${QC_BACKTEST_TIMEOUT_SECONDS}s" >>"$OUT_STDERR"
fi
set -e
sanitize_log "$OUT_STDOUT" > "$OUT_STDOUT.redacted"
sanitize_log "$OUT_STDERR" > "$OUT_STDERR.redacted"
mv "$OUT_STDOUT.redacted" "$OUT_STDOUT"
mv "$OUT_STDERR.redacted" "$OUT_STDERR"
chmod 640 "$OUT_STDOUT" "$OUT_STDERR"

python3 - "$OUT_MANIFEST" "$OUT_SUMMARY" "$OUT_STDOUT" "$OUT_STDERR" "$push_rc" "$backtest_rc" <<'PY'
import json, re, sys, time
from pathlib import Path
manifest=Path(sys.argv[1]); summary=Path(sys.argv[2]); stdout=Path(sys.argv[3]); stderr=Path(sys.argv[4]); push_rc=int(sys.argv[5]); backtest_rc=int(sys.argv[6])
m=json.loads(manifest.read_text())
out=stdout.read_text(errors='replace') if stdout.exists() else ''
err=stderr.read_text(errors='replace') if stderr.exists() else ''
evidence=[]
for line in out.splitlines()+err.splitlines():
    if 'TRADER_QC_EVIDENCE_JSON=' in line:
        evidence.append(line.split('TRADER_QC_EVIDENCE_JSON=',1)[1].strip())
ids=re.findall(r'backtest\s+(?:id|Id|ID)?[:# ]+([A-Za-z0-9_-]+)', out+'\n'+err)
m.update({"status":"cloud_backtest_completed" if backtest_rc==0 else "cloud_backtest_failed", "push_returncode":push_rc, "backtest_returncode":backtest_rc, "completed_at_utc":time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), "possible_backtest_ids":ids[-5:], "evidence_json_lines":evidence[-20:], "logs":{"stdout":"qc_cloud_backtest_stdout.log","stderr":"qc_cloud_backtest_stderr.log"}})
manifest.write_text(json.dumps(m, indent=2, sort_keys=True)+"\n")
summary.write_text(f"# QC Cloud Run\n\nStatus: `{m['status']}`\n\nPush rc: `{push_rc}`\nBacktest rc: `{backtest_rc}`\n\nProject: `{m.get('project_name')}`\n\nArtifacts:\n- qc_cloud_run_manifest.json\n- qc_cloud_backtest_stdout.log\n- qc_cloud_backtest_stderr.log\n- qc_cloud_project.tgz\n\nEvidence JSON lines: `{len(evidence)}`\n", encoding='utf-8')
PY

if [[ "$push_rc" -ne 0 || "$backtest_rc" -ne 0 ]]; then
  echo QC_CLOUD_RUN_FAILED
  exit 1
fi
echo QC_CLOUD_RUN_COMPLETED
