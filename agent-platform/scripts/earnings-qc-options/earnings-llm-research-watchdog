#!/usr/bin/env bash
set -euo pipefail

export TZ=Asia/Jerusalem
if [[ -n "${EARNINGS_WATCHDOG_PATH_PREFIX:-}" ]]; then
  export PATH="${EARNINGS_WATCHDOG_PATH_PREFIX}:/agents/research/bin:/usr/local/bin:/usr/bin:/bin"
else
  export PATH=/agents/research/bin:/usr/local/bin:/usr/bin:/bin
fi
export PYTHONDONTWRITEBYTECODE=1

MODEL="gpt-5.4-mini"
DATE="$(date +%F)"
DRY_RUN=0
FORCE=0

usage() {
  cat >&2 <<'USAGE'
usage: earnings-llm-research-watchdog [--date YYYY-MM-DD] [--model MODEL] [--dry-run] [--force]

LLM-only watchdog for the earnings research loop after the deterministic daily run.
It reads run/postrun artifacts and logs, asks the isolated Codex research runner to
identify failures and likely causes, and writes durable diagnosis artifacts.

It never runs QC/LEAN, never calls earnings-qc-research, never writes bounded action
requests, and never sends notifications itself.
USAGE
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])'
}

make_runner_inputs_usable() {
  local task_file="$1"
  local output_dir="$2"
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "u:agent-research-watchdog:--x" /agents /agents/research "$REPORT_ROOT" "$HANDOFF_DIR" 2>/dev/null || true
    setfacl -m "u:agent-research:rwx,u:agent-research-watchdog:rwx,m::rwx,d:u:agent-research:rwx,d:u:agent-research-watchdog:rwx,d:m::rwx" "$output_dir"
    setfacl -m "u:agent-research-watchdog:r--" "$task_file"
    chmod u+rw,o-rwx "$task_file"
  else
    chgrp agent-research-watchdog "$output_dir"
    chmod 2770 "$output_dir"
    chgrp agent-research-watchdog "$task_file"
    chmod 0640 "$task_file"
  fi
}

write_failure_handoff_task() {
  local condition="$1"
  local marker_dir task_file tmp_task_file ts
  marker_dir="$STATE_DIR/failure-handoffs/${DATE_COMPACT}-${condition}"
  mkdir -p "$STATE_DIR/failure-handoffs"
  tmp_task_file="$(mktemp "$HANDOFF_DIR/.research-watchdog-${DATE_COMPACT}-${condition}.XXXXXX")"
  ts="$(date -u +%Y%m%d-%H%M%S)"
  task_file="$HANDOFF_DIR/research-watchdog-${DATE_COMPACT}-${ts}-$$-${condition}-task.txt"
  cat > "$tmp_task_file" <<TASK
Earnings research watchdog detected a daily-run failure state.

condition: $condition
date: $DATE
scheduled_at: ${DAILY_RUN_SCHEDULED_AT:-}
schedule_zone: ${DAILY_RUN_ZONE:-}
schedule_source: ${DAILY_RUN_SOURCE:-}
grace_seconds: $MISSING_RUN_GRACE_SECONDS
threshold_seconds: $STALE_RUNNING_SECONDS
run_id: ${STATE_RUN_ID:-}
status: ${STATE_STATUS:-}
started_at: ${STATE_STARTED_AT:-}
age_seconds: ${STATE_AGE_SECONDS:-}

This is a durable handoff artifact for the LLM/operator loop. Keep the existing
script exit/status signal; investigate why the deterministic daily run did not
produce a usable finished run.
TASK
  chmod 0640 "$tmp_task_file"
  if ! mkdir "$marker_dir" 2>/dev/null; then
    rm -f "$tmp_task_file"
    echo "HANDOFF_TASK_ALREADY_WRITTEN condition=$condition marker=$marker_dir"
    return
  fi
  if ! mv "$tmp_task_file" "$task_file"; then
    rmdir "$marker_dir" 2>/dev/null || true
    rm -f "$tmp_task_file"
    echo "ERROR: failed to persist handoff task condition=$condition task=$task_file" >&2
    return 73
  fi
  printf '%s\n' "$task_file" > "$marker_dir/task_file.txt"
  printf '%s\n' "$(date -Is)" > "$marker_dir/written_at.txt"
  echo "HANDOFF_TASK_WRITTEN condition=$condition task=$task_file"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --date) DATE="${2:?missing --date value}"; shift 2 ;;
    --model) MODEL="${2:?missing --model value}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage; exit 64 ;;
  esac
done

if [[ ! "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "ERROR: --date must be YYYY-MM-DD" >&2
  exit 64
fi
case "$MODEL" in
  *[!A-Za-z0-9._/-]*|"") echo "ERROR: unsafe model name" >&2; exit 64 ;;
esac

DATE_COMPACT="${DATE//-/}"
STATE_DIR="${EARNINGS_WATCHDOG_STATE_DIR:-/agents/research/state/earnings-qc-research/llm-research-watchdog}"
POSTRUN_STATE_DIR="${EARNINGS_POSTRUN_STATE_DIR:-/agents/research/state/earnings-qc-research/llm-postrun-review}"
HANDOFF_DIR="${EARNINGS_WATCHDOG_HANDOFF_DIR:-/agents/research/handoff}"
REPORT_ROOT="${EARNINGS_WATCHDOG_REPORT_ROOT:-/agents/research/reports}"
LOG_DIR="${EARNINGS_WATCHDOG_LOG_DIR:-/agents/research/logs/earnings-qc-research}"
SKILL_FILE="${EARNINGS_WATCHDOG_SKILL_FILE:-/agents/research/skills/trader-research-system/SKILL.md}"
LOCK="${STATE_DIR}/earnings-llm-research-watchdog.lock"
STALE_RUNNING_SECONDS="${EARNINGS_WATCHDOG_STALE_RUNNING_SECONDS:-10800}"
MISSING_RUN_GRACE_SECONDS="${EARNINGS_WATCHDOG_MISSING_RUN_GRACE_SECONDS:-10800}"
DAILY_RUN_COMMAND="/agents/research/bin/earnings-otm-daily.sh"
# Fallback for the managed systemd timer in .github/workflows/vps-deploy.yml:
# OnCalendar=*-*-* 06:00:00 Asia/Jerusalem
DAILY_RUN_DEFAULT_MINUTE=0
DAILY_RUN_DEFAULT_HOUR=6
DAILY_RUN_DEFAULT_ZONE="Asia/Jerusalem"
mkdir -p "$STATE_DIR" "$HANDOFF_DIR" "$REPORT_ROOT"

exec 9>"$LOCK"
if ! flock -n 9; then
  echo "WATCHDOG_ALREADY_RUNNING"
  exit 0
fi

daily_run_schedule() {
  local schedule minute hour minute_i hour_i zone timer_calendar parsed
  zone="${EARNINGS_WATCHDOG_DAILY_SCHEDULE_ZONE:-$DAILY_RUN_DEFAULT_ZONE}"
  if [[ -n "${EARNINGS_WATCHDOG_DAILY_SCHEDULE:-}" ]]; then
    schedule="${EARNINGS_WATCHDOG_DAILY_SCHEDULE}"
    minute="${schedule##*:}"
    hour="${schedule%%:*}"
    if [[ "$minute" =~ ^[0-9]+$ && "$hour" =~ ^[0-9]+$ ]]; then
      minute_i=$((10#$minute))
      hour_i=$((10#$hour))
      if (( minute_i <= 59 && hour_i <= 23 )); then
        printf '%s|%s|%s|%s\n' "$minute_i" "$hour_i" "$zone" "env"
        return
      fi
    fi
  fi

  if command -v systemctl >/dev/null 2>&1; then
    timer_calendar="$(systemctl show trader-earnings-otm-daily.timer -p TimersCalendar --value 2>/dev/null || true)"
    if [[ -n "$timer_calendar" ]]; then
      parsed="$(python3 - "$timer_calendar" <<'PY'
import re
import sys

text = sys.argv[1]
match = re.search(r'(?:OnCalendar=)?[^;\n]*?\b([0-9]{1,2}):([0-9]{2})(?::[0-9]{2})?\s+([A-Za-z_]+/[A-Za-z_]+)\b', text)
if match:
    hour, minute, zone = match.groups()
    print(f"{int(minute)}|{int(hour)}|{zone}")
PY
)"
      if [[ -n "$parsed" ]]; then
        IFS='|' read -r minute hour zone <<< "$parsed"
        if [[ "$minute" =~ ^[0-9]+$ && "$hour" =~ ^[0-9]+$ ]]; then
          minute_i=$((10#$minute))
          hour_i=$((10#$hour))
          if (( minute_i <= 59 && hour_i <= 23 )) && [[ -n "$zone" ]]; then
            printf '%s|%s|%s|%s\n' "$minute_i" "$hour_i" "$zone" "systemd"
            return
          fi
        fi
      fi
    fi
  fi

  printf '%s|%s|%s|%s\n' "$DAILY_RUN_DEFAULT_MINUTE" "$DAILY_RUN_DEFAULT_HOUR" "$DAILY_RUN_DEFAULT_ZONE" "fallback"
}

cd /tmp && psql -d trader_research -qAt -v ON_ERROR_STOP=1 -c "ALTER TABLE earnings_cache.research_runs ADD COLUMN IF NOT EXISTS research_verdict TEXT;" >/dev/null
RUN_STATE="$(cd /tmp && psql -d trader_research -qAt -F '|' -v ON_ERROR_STOP=1 -v stale_seconds="$STALE_RUNNING_SECONDS" -c "
WITH daily AS (
  SELECT 0 AS source_rank, run_id, status, COALESCE(started_at::text,'') AS started_at_text, COALESCE(finished_at::text,'') AS finished_at_text, COALESCE(EXTRACT(EPOCH FROM (now() - started_at))::bigint, 0)::text AS age_seconds, run_dir, started_at, finished_at
  FROM earnings_cache.research_runs
  WHERE campaign_id = 'daily-earnings-otm'
    AND run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
  UNION ALL
  SELECT 1 AS source_rank, run_id, status, COALESCE(started_at::text,'') AS started_at_text, COALESCE(finished_at::text,'') AS finished_at_text, COALESCE(EXTRACT(EPOCH FROM (now() - started_at))::bigint, 0)::text AS age_seconds, run_dir, started_at, finished_at
  FROM earnings_cache.research_runs
  WHERE run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
    AND COALESCE(parameters_json->>'from_stage','calendar') = 'calendar'
    AND COALESCE(parameters_json->>'to_stage','historical_option_pnl') = 'historical_option_pnl'
    AND COALESCE((parameters_json->>'years')::int, 1) = 1
    AND COALESCE((parameters_json->>'parallel')::int, 1) = 1
    AND COALESCE((parameters_json->>'end_to_end')::boolean, true) = true
    AND COALESCE((parameters_json->>'chunk_size')::int, 25) = 25
    AND COALESCE(parameters_json->>'symbols','') = ''
    AND COALESCE(parameters_json->>'calendar_source','nasdaq') = 'nasdaq'
)
SELECT run_id, status, started_at_text, finished_at_text, age_seconds, run_dir
FROM daily
ORDER BY source_rank, COALESCE(finished_at, started_at) DESC NULLS LAST
LIMIT 1;
")"

if [[ -z "$RUN_STATE" ]]; then
  IFS='|' read -r DAILY_RUN_MINUTE DAILY_RUN_HOUR DAILY_RUN_ZONE DAILY_RUN_SOURCE <<< "$(daily_run_schedule)"
  DAILY_RUN_SCHEDULED_AT="$(printf '%02d:%02d' "$DAILY_RUN_HOUR" "$DAILY_RUN_MINUTE")"
  MISSING_ROW_STATE="$(python3 - "$DATE" "$DAILY_RUN_HOUR" "$DAILY_RUN_MINUTE" "$DAILY_RUN_ZONE" "$MISSING_RUN_GRACE_SECONDS" "${EARNINGS_WATCHDOG_NOW:-}" <<'PY'
import datetime as dt
import sys
from zoneinfo import ZoneInfo

date_s, hour_s, minute_s, zone_s, grace_s, now_s = sys.argv[1:7]
tz = ZoneInfo(zone_s)
run_date = dt.date.fromisoformat(date_s)
due_at = dt.datetime.combine(run_date, dt.time(int(hour_s), int(minute_s)), tzinfo=tz)
deadline = due_at + dt.timedelta(seconds=int(grace_s))
if now_s:
    raw = now_s.replace("Z", "+00:00")
    now = dt.datetime.fromisoformat(raw)
    if now.tzinfo is None:
        now = now.replace(tzinfo=tz)
    else:
        now = now.astimezone(tz)
else:
    now = dt.datetime.now(tz)
if now < due_at:
    print("not_due")
elif now < deadline:
    print("within_grace")
else:
    print("after_deadline")
PY
)"
  if [[ "$MISSING_ROW_STATE" == "after_deadline" ]]; then
    write_failure_handoff_task "DAILY_RUN_MISSING_AFTER_DEADLINE"
    echo "ERROR: DAILY_RUN_MISSING_AFTER_DEADLINE date=$DATE scheduled_at=$DAILY_RUN_SCHEDULED_AT schedule_zone=$DAILY_RUN_ZONE schedule_source=$DAILY_RUN_SOURCE grace_seconds=$MISSING_RUN_GRACE_SECONDS" >&2
    exit 75
  fi
  if [[ "$MISSING_ROW_STATE" == "not_due" ]]; then
    echo "DAILY_RUN_NOT_DUE_YET date=$DATE scheduled_at=$DAILY_RUN_SCHEDULED_AT schedule_zone=$DAILY_RUN_ZONE schedule_source=$DAILY_RUN_SOURCE grace_seconds=$MISSING_RUN_GRACE_SECONDS"
  else
    echo "DAILY_RUN_MISSING_WITHIN_GRACE date=$DATE scheduled_at=$DAILY_RUN_SCHEDULED_AT schedule_zone=$DAILY_RUN_ZONE schedule_source=$DAILY_RUN_SOURCE grace_seconds=$MISSING_RUN_GRACE_SECONDS"
  fi
  exit 0
fi

IFS='|' read -r STATE_RUN_ID STATE_STATUS STATE_STARTED_AT STATE_FINISHED_AT STATE_AGE_SECONDS STATE_RUN_DIR <<< "$RUN_STATE"
if [[ "$STATE_STATUS" == "running" && -z "$STATE_FINISHED_AT" && "${STATE_AGE_SECONDS:-0}" =~ ^[0-9]+$ && "$STATE_AGE_SECONDS" -gt "$STALE_RUNNING_SECONDS" ]]; then
  write_failure_handoff_task "STALE_RUNNING_DAILY_RUN"
  echo "ERROR: STALE_RUNNING_DAILY_RUN date=$DATE run_id=$STATE_RUN_ID started_at=$STATE_STARTED_AT age_seconds=$STATE_AGE_SECONDS threshold_seconds=$STALE_RUNNING_SECONDS" >&2
  exit 75
fi

ROW="$(cd /tmp && psql -d trader_research -qAt -F $'\t' -v ON_ERROR_STOP=1 -c "
SELECT run_id, status, COALESCE(research_verdict, summary_json->>'status', ''), COALESCE(finished_at::text,''), run_dir, COALESCE(final_candidate_count,0)::text, COALESCE(bottleneck,''), COALESCE(error,'')
FROM earnings_cache.research_runs
WHERE campaign_id = 'daily-earnings-otm'
  AND run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
  AND finished_at IS NOT NULL
ORDER BY finished_at DESC
LIMIT 1;
")"

if [[ -z "$ROW" ]]; then
  ROW="$(cd /tmp && psql -d trader_research -qAt -F $'\t' -v ON_ERROR_STOP=1 -c "
  SELECT run_id, status, COALESCE(research_verdict, summary_json->>'status', ''), COALESCE(finished_at::text,''), run_dir, COALESCE(final_candidate_count,0)::text, COALESCE(bottleneck,''), COALESCE(error,'')
  FROM earnings_cache.research_runs
  WHERE run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
    AND finished_at IS NOT NULL
    AND COALESCE(parameters_json->>'from_stage','calendar') = 'calendar'
    AND COALESCE(parameters_json->>'to_stage','historical_option_pnl') = 'historical_option_pnl'
    AND COALESCE((parameters_json->>'years')::int, 1) = 1
    AND COALESCE((parameters_json->>'parallel')::int, 1) = 1
    AND COALESCE((parameters_json->>'end_to_end')::boolean, true) = true
    AND COALESCE((parameters_json->>'chunk_size')::int, 25) = 25
    AND COALESCE(parameters_json->>'symbols','') = ''
    AND COALESCE(parameters_json->>'calendar_source','nasdaq') = 'nasdaq'
  ORDER BY finished_at DESC
  LIMIT 1;
  ")"
  if [[ -n "$ROW" ]]; then
    echo "USING_LEGACY_DAILY_RUN_FALLBACK date=$DATE"
  fi
fi

if [[ -z "$ROW" ]]; then
  echo "NO_FINISHED_DAILY_RUN date=$DATE"
  exit 0
fi

IFS=$'\t' read -r RUN_ID RUN_STATUS RESEARCH_VERDICT FINISHED_AT RUN_DIR FINAL_COUNT BOTTLENECK RUN_ERROR <<< "$ROW"
if [[ -z "${RUN_ID:-}" || -z "${RUN_DIR:-}" ]]; then
  echo "ERROR: malformed DB row for date=$DATE: $ROW" >&2
  exit 70
fi
if [[ ! -d "$RUN_DIR" || ! -f "$RUN_DIR/full_summary.json" ]]; then
  echo "ERROR: finished DB row exists but run artifacts are missing: run_id=$RUN_ID run_dir=$RUN_DIR" >&2
  exit 66
fi

SAFE_RUN_MARKER="$(printf '%s' "$RUN_ID" | tr -c 'A-Za-z0-9._-' '-')"
RUN_STATE_DIR="$STATE_DIR/runs/$SAFE_RUN_MARKER"
mkdir -p "$RUN_STATE_DIR"

POSTRUN_DIR="$(find "$REPORT_ROOT" -maxdepth 1 -type d -name "research-pass-postrun-*-${SAFE_RUN_MARKER}" -printf '%T@\t%p\n' 2>/dev/null | sort -nr | head -1 | cut -f2- || true)"
DAILY_LOG="$LOG_DIR/daily-${DATE_COMPACT}.log"
POSTRUN_LOG="$LOG_DIR/llm-postrun-review.log"

FINGERPRINT="$(python3 - "$RUN_DIR" "$POSTRUN_DIR" <<'PY'
import hashlib, json, pathlib, sys
run_dir, postrun_dir = [pathlib.Path(x) if x else None for x in sys.argv[1:]]
items=[]
def add(path):
    if path and path.exists() and not path.is_symlink():
        st=path.stat()
        items.append({'path': str(path), 'size': st.st_size, 'mtime_ns': st.st_mtime_ns})
for name in ('full_summary.json', 'run_metadata.json'):
    add(run_dir / name)
if postrun_dir:
    for name in ('run_metadata.json', 'review.md', 'review.json', 'notify.txt', 'bounded_action_result.json'):
        add(postrun_dir / name)
print(hashlib.sha256(json.dumps(items, sort_keys=True).encode()).hexdigest())
PY
)"
LAST_FINGERPRINT_FILE="$RUN_STATE_DIR/last-fingerprint.txt"
if [[ "$FORCE" -ne 1 && -f "$LAST_FINGERPRINT_FILE" && "$(cat "$LAST_FINGERPRINT_FILE")" == "$FINGERPRINT" ]]; then
  echo "WATCHDOG_NO_CHANGE run_id=$RUN_ID fingerprint=$FINGERPRINT"
  exit 0
fi

TS="$(date -u +%Y%m%d-%H%M%S)"
TASK_FILE="$HANDOFF_DIR/research-watchdog-${DATE_COMPACT}-${TS}-task.txt"
OUTPUT_DIR="$REPORT_ROOT/research-watchdog-${DATE_COMPACT}-${TS}-${SAFE_RUN_MARKER}"

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "WOULD_RUN_WATCHDOG run_id=$RUN_ID output=$OUTPUT_DIR model=$MODEL fingerprint=$FINGERPRINT"
  exit 0
fi

mkdir -p "$OUTPUT_DIR"
chmod 750 "$OUTPUT_DIR"

SUMMARY_EXCERPT="$(python3 - "$RUN_DIR/full_summary.json" <<'PY'
import json, pathlib, sys
j=json.loads(pathlib.Path(sys.argv[1]).read_text())
keys=['status','run_date','calendar_universe_count','qc_symbols_scanned','forward_candidate_count','final_candidate_count','failed_chunk_count','aggregate_funnel','failed_chunks','chunk_multiyear_statuses','final_candidate_gate']
print(json.dumps({k:j.get(k) for k in keys}, ensure_ascii=False, indent=2, sort_keys=True)[:16000])
PY
)"
POSTRUN_META=""
if [[ -n "$POSTRUN_DIR" && -f "$POSTRUN_DIR/run_metadata.json" ]]; then
  POSTRUN_META="$(python3 - "$POSTRUN_DIR/run_metadata.json" <<'PY'
import json, pathlib, sys
j=json.loads(pathlib.Path(sys.argv[1]).read_text())
print(json.dumps(j, ensure_ascii=False, indent=2, sort_keys=True)[:8000])
PY
)"
fi
DAILY_LOG_TAIL="$(tail -120 "$DAILY_LOG" 2>/dev/null || true)"
POSTRUN_LOG_TAIL="$(tail -160 "$POSTRUN_LOG" 2>/dev/null || true)"

cat > "$TASK_FILE" <<'TASK'
You are the LLM-only failure watchdog for Uriel's VPS earnings research system.

Important boundary:
- You are NOT the deterministic scanner and NOT the bounded postrun actor.
- This job is LLM-only: do not run QC/LEAN, do not run /agents/research/bin/earnings-qc-research, do not request or execute bounded actions, do not change parameters, do not create cron jobs, do not send messages.
- Your job is to read the supplied artifacts/log excerpts, identify what failed in the research/postrun flow after the daily run, infer likely causes, and explain what should be investigated next by a human/operator or by a separate approved code/deploy task.
- Do not promote any trade candidate. Output is diagnosis only.

Run context:
- run_id: __RUN_ID__
- status: __RUN_STATUS__
- research_verdict: __RESEARCH_VERDICT__
- finished_at: __FINISHED_AT__
- run_dir: __RUN_DIR__
- final_candidate_count: __FINAL_COUNT__
- bottleneck: __BOTTLENECK__
- error: __RUN_ERROR__
- latest postrun dir: __POSTRUN_DIR__
- fingerprint: __FINGERPRINT__

Full summary excerpt:
```json
__SUMMARY_EXCERPT__
```

Latest postrun metadata, if any:
```json
__POSTRUN_META__
```

Daily log tail:
```text
__DAILY_LOG_TAIL__
```

Postrun log tail:
```text
__POSTRUN_LOG_TAIL__
```

Write these files under __OUTPUT_DIR__:
1. diagnosis.md — concise but useful diagnosis.
2. diagnosis.json — valid JSON with this shape:
   {
     "run_id": "...",
     "changed": true,
     "severity": "none|info|warning|failure",
     "findings": [{"title":"...","evidence":"...","likely_cause":"...","confidence":"low|medium|high","next_step":"..."}],
     "notify": true/false,
     "hebrew_summary": "..."
   }
3. notify.txt — either exactly NO_NOTIFY or a concise Hebrew WhatsApp-style update.

Notification threshold:
- notify=true only for a new/changed failure, new likely root cause, new recovery, or a concrete next-step decision.
- If this is just the same already-known no-candidate/no-change situation, write NO_NOTIFY.

Be skeptical. Separate evidence from hypothesis. Keep Hebrew summary direct and short.
TASK
printf '%s\n' "$SUMMARY_EXCERPT" > "$OUTPUT_DIR/summary-excerpt.txt"
printf '%s\n' "$POSTRUN_META" > "$OUTPUT_DIR/postrun-meta.txt"
printf '%s\n' "$DAILY_LOG_TAIL" > "$OUTPUT_DIR/daily-log-tail.txt"
printf '%s\n' "$POSTRUN_LOG_TAIL" > "$OUTPUT_DIR/postrun-log-tail.txt"
python3 - "$TASK_FILE" "$OUTPUT_DIR" "$RUN_ID" "$RUN_STATUS" "$RESEARCH_VERDICT" "$FINISHED_AT" "$RUN_DIR" "$FINAL_COUNT" "$BOTTLENECK" "$RUN_ERROR" "$POSTRUN_DIR" "$FINGERPRINT" <<'PY'
import pathlib, sys
(task_file, output_dir, run_id, run_status, research_verdict, finished_at, run_dir, final_count, bottleneck, run_error, postrun_dir, fingerprint) = sys.argv[1:]
out = pathlib.Path(output_dir)
text = pathlib.Path(task_file).read_text()
replacements = {
    '__OUTPUT_DIR__': output_dir,
    '__RUN_ID__': run_id,
    '__RUN_STATUS__': run_status,
    '__RESEARCH_VERDICT__': research_verdict,
    '__FINISHED_AT__': finished_at,
    '__RUN_DIR__': run_dir,
    '__FINAL_COUNT__': final_count,
    '__BOTTLENECK__': bottleneck,
    '__RUN_ERROR__': run_error,
    '__POSTRUN_DIR__': postrun_dir,
    '__FINGERPRINT__': fingerprint,
    '__SUMMARY_EXCERPT__': (out / 'summary-excerpt.txt').read_text(),
    '__POSTRUN_META__': (out / 'postrun-meta.txt').read_text(),
    '__DAILY_LOG_TAIL__': (out / 'daily-log-tail.txt').read_text(),
    '__POSTRUN_LOG_TAIL__': (out / 'postrun-log-tail.txt').read_text(),
}
for old, new in replacements.items():
    text = text.replace(old, new)
pathlib.Path(task_file).write_text(text)
PY
chmod 0640 "$TASK_FILE" "$OUTPUT_DIR"/*.txt
make_runner_inputs_usable "$TASK_FILE" "$OUTPUT_DIR"

STARTED_AT="$(date -Is)"
set +e
sudo -n -u agent-research-watchdog /usr/local/bin/trading-research-watchdog-codex "$TASK_FILE" "$OUTPUT_DIR" "$MODEL" \
  > "$OUTPUT_DIR/runner.stdout.log" 2> "$OUTPUT_DIR/runner.stderr.log"
RC=$?
set -e
FINISHED_AT_REVIEW="$(date -Is)"

VALID_JSON=0
if [[ -f "$OUTPUT_DIR/diagnosis.json" ]] && python3 -m json.tool "$OUTPUT_DIR/diagnosis.json" >/dev/null 2>&1; then
  VALID_JSON=1
fi
HAS_DIAGNOSIS_MD=0
if [[ -s "$OUTPUT_DIR/diagnosis.md" ]]; then
  HAS_DIAGNOSIS_MD=1
fi
ARTIFACTS_VALID=0
if [[ "$VALID_JSON" -eq 1 && "$HAS_DIAGNOSIS_MD" -eq 1 ]]; then
  ARTIFACTS_VALID=1
fi
if [[ ! -f "$OUTPUT_DIR/notify.txt" ]]; then
  printf 'NO_NOTIFY\n' > "$OUTPUT_DIR/notify.txt"
fi

RUN_ID_JSON="$(printf '%s' "$RUN_ID" | json_escape)"
RUN_STATUS_JSON="$(printf '%s' "$RUN_STATUS" | json_escape)"
RESEARCH_VERDICT_JSON="$(printf '%s' "$RESEARCH_VERDICT" | json_escape)"
RUN_DIR_JSON="$(printf '%s' "$RUN_DIR" | json_escape)"
POSTRUN_DIR_JSON="$(printf '%s' "$POSTRUN_DIR" | json_escape)"
FINGERPRINT_JSON="$(printf '%s' "$FINGERPRINT" | json_escape)"
cat > "$OUTPUT_DIR/run_metadata.json" <<META
{
  "run_id": "$RUN_ID_JSON",
  "daily_run_status": "$RUN_STATUS_JSON",
  "research_verdict": "$RESEARCH_VERDICT_JSON",
  "run_dir": "$RUN_DIR_JSON",
  "postrun_dir": "$POSTRUN_DIR_JSON",
  "fingerprint": "$FINGERPRINT_JSON",
  "started_at": "$STARTED_AT",
  "finished_at": "$FINISHED_AT_REVIEW",
  "model": "$MODEL",
  "returncode": $RC,
  "valid_diagnosis_json": $VALID_JSON,
  "has_diagnosis_md": $HAS_DIAGNOSIS_MD,
  "artifacts_valid": $ARTIFACTS_VALID,
  "runner": "trading-research-watchdog-codex",
  "output_dir": "$OUTPUT_DIR"
}
META

if [[ "$RC" -eq 0 && "$ARTIFACTS_VALID" -eq 1 ]]; then
  printf '%s\n' "$FINGERPRINT" > "$LAST_FINGERPRINT_FILE"
  printf '%s\n' "$OUTPUT_DIR" > "$RUN_STATE_DIR/latest-output-dir.txt"
  mkdir -p "$STATE_DIR/latest"
  ln -sfn "$OUTPUT_DIR" "$STATE_DIR/latest/output"
  if [[ -s "$OUTPUT_DIR/notify.txt" && "$(tr -d '\r\n ' < "$OUTPUT_DIR/notify.txt")" != "NO_NOTIFY" ]]; then
    cp "$OUTPUT_DIR/notify.txt" "$STATE_DIR/latest-notify.txt"
    printf '%s\n' "$OUTPUT_DIR" > "$STATE_DIR/latest-notify-output-dir.txt"
    printf '%s\n' "$FINGERPRINT" > "$STATE_DIR/latest-notify-fingerprint.txt"
  fi
  echo "WATCHDOG_COMPLETED run_id=$RUN_ID output=$OUTPUT_DIR notify=$(head -1 "$OUTPUT_DIR/notify.txt" 2>/dev/null || true)"
else
  if [[ "$RC" -eq 0 ]]; then
    RC=70
  fi
  echo "WATCHDOG_FAILED run_id=$RUN_ID rc=$RC artifacts_valid=$ARTIFACTS_VALID valid_diagnosis_json=$VALID_JSON has_diagnosis_md=$HAS_DIAGNOSIS_MD output=$OUTPUT_DIR" >&2
  exit "$RC"
fi
