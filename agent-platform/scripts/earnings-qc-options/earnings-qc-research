def refresh_summary_after_historical(run_dir: pathlib.Path, mb: dict | None) -> dict:
    fs = run_dir / 'full_summary.json'
    summary = json.loads(fs.read_text()) if fs.exists() else {'ok': False, 'status': 'NO_FULL_SUMMARY'}
    prior_status = summary.get('status')
    if not mb:
        src = summary.get('forward_candidates') or summary.get('candidates') or []
        summary['multiyear_backtest'] = None
        summary['historical_gate_ran'] = False
        summary['historical_gate_no_pass'] = False
        summary['historical_gate_blocked'] = bool(src)
        summary['multiyear_failed'] = True
        summary['ok'] = False
        summary['status'] = 'BLOCKED_MULTIYEAR_OPTION_PNL_BACKTEST'
        if fs.exists():
            fs.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + '\n')
        return summary
    summary['multiyear_backtest'] = mb
    summary['historical_gate_ran'] = True
    summary['aggregate_funnel'] = dict(summary.get('aggregate_funnel') or {})
    summary['aggregate_funnel']['07_multi_year_backtest_status'] = mb.get('status')
    result_symbols = {r.get('symbol') for r in mb.get('results', []) if r.get('symbol')}
    results_by_symbol = {}
    for r in mb.get('results', []):
        if r.get('symbol'):
            results_by_symbol.setdefault(r.get('symbol'), []).append(r)
    gate = final_candidate_gate_thresholds()
    summary['final_candidate_gate'] = gate
    summary['final_candidate_gate_evaluations'] = [
        final_candidate_gate_evaluation(r, gate)
        for r in mb.get('results', [])
        if r.get('symbol')
    ]
    passing_results = {r.get('symbol'): r for r in mb.get('results', []) if mb.get('ok') and multiyear_result_passes(r)}
    src = summary.get('forward_candidates') or summary.get('candidates') or []
    summary['final_candidates'] = [
        final_candidate for c in src
        for final_candidate in [promoted_final_candidate(c, passing_results.get(c.get('symbol')))]
        if final_candidate
    ]
    summary['candidates'] = summary['final_candidates']
    summary['candidate_count'] = len(summary['final_candidates'])
    summary['final_candidate_count'] = len(summary['final_candidates'])
    mb_status = mb.get('status')
    mb_ok = mb.get('ok')
    mb_no_forward = mb_status == 'NO_FORWARD_CANDIDATES'
    capacity_blocked = bool(mb.get('ok') is False and not mb_no_forward and is_qc_cloud_capacity_status(mb_status))
    infra_failed = bool(mb.get('ok') is False and not mb_no_forward and multiyear_infrastructure_failed(mb_status))
    historical_failed = list(summary.get('historical_failed_chunks') or [])
    scanner_failed = []
    for x in (summary.get('failed_chunks') or []):
        text = (str(x.get('status')) + ' ' + str(x.get('blocked_reason'))).upper()
        if any(marker in text for marker in ['MULTIYEAR', 'HISTORICAL', 'OPTION-PNL', 'OPTION_PNL']):
            historical_failed.append(x)
        else:
            scanner_failed.append(x)
    for x in historical_failed:
        if x.get('ok') is False:
            x.setdefault('blocked_reason', 'mandatory multiyear option-PnL backtest failed')
    summary['failed_chunks'] = scanner_failed
    summary['failed_chunk_count'] = len(scanner_failed)
    summary['historical_failed_chunks'] = historical_failed
    summary['historical_failed_chunk_count'] = len(historical_failed)
    base_scan_ok = bool(summary.get('chunk_count')) and not scanner_failed and int(summary.get('qc_symbols_scanned') or 0) >= int(summary.get('calendar_row_count') or summary.get('calendar_universe_count') or 0)
    all_forward_candidates_had_historical_results = bool(src) and all(c.get('symbol') in result_symbols for c in src)
    # Evidence deficiencies are blocked; terminal no-pass means every consulted candidate was fully evaluated.
    all_consulted_results_had_window_evidence = (
        all_forward_candidates_had_historical_results
        and all(
            all(multiyear_result_has_window_evidence(r) for r in results_by_symbol.get(c.get('symbol'), []))
            for c in src
        )
    )
    no_forward_candidates_preblocked = not any(candidate_historical_status_blocks(c) for c in src)
    no_pass = bool(src) and bool(base_scan_ok) and not summary['final_candidates'] and all_forward_candidates_had_historical_results and all_consulted_results_had_window_evidence and no_forward_candidates_preblocked and multiyear_completed_without_infra_failure(mb_status, mb_ok)
    summary['historical_gate_no_pass'] = no_pass
    summary['historical_gate_blocked'] = bool(src) and bool(base_scan_ok) and not summary['final_candidates'] and (capacity_blocked or infra_failed or not no_pass)
    summary['multiyear_failed'] = infra_failed
    summary['qc_capacity_blocked'] = capacity_blocked
    if not src:
        summary['ok'] = bool(base_scan_ok) and (bool(mb_ok) or mb_no_forward)
    else:
        summary['ok'] = bool(base_scan_ok) and bool(mb.get('ok')) and bool(summary['final_candidates'])
    if summary['ok'] and not src:
        summary['status'] = 'NO_FORWARD_CANDIDATES'
    elif summary['ok']:
        summary['status'] = 'OK_FULL_QC_SCAN'
    elif no_pass:
        summary['status'] = 'NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL'
    elif bool(src) and bool(base_scan_ok) and no_forward_candidates_preblocked and all_forward_candidates_had_historical_results and not all_consulted_results_had_window_evidence:
        summary['status'] = 'BLOCKED_HISTORICAL_OPTION_PNL_MISSING_WINDOW_EVIDENCE'
    elif capacity_blocked:
        summary['status'] = mb_status
    elif infra_failed:
        summary['status'] = mb_status or 'BLOCKED_MULTIYEAR_OPTION_PNL_BACKTEST'
    elif bool(src) and not summary['final_candidates']:
        summary['status'] = 'BLOCKED_HISTORICAL_OPTION_PNL_GATE'
    elif not src:
        summary['status'] = prior_status if prior_status and prior_status != 'NO_FORWARD_CANDIDATES' else 'PARTIAL_FULL_QC_SCAN'
    if fs.exists():
        fs.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + '\n')
    return summary


