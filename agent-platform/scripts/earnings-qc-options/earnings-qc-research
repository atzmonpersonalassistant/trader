def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def sql_lit(v) -> str:
    if v is None:
        return 'NULL'
    return "'" + str(v).replace("'", "''") + "'"


def sql_json(v) -> str:
    return sql_lit(json.dumps(v if v is not None else {}, ensure_ascii=False, sort_keys=True)) + '::jsonb'


def sql_int_or_null(v) -> str:
    if v is None:
        return 'NULL'
    try:
        return str(int(v))
    except Exception:
        return 'NULL'


def db_exec(sql: str, fetch: bool = False) -> str | None:
    if shutil.which('psql') is None:
        if DB_STRICT:
            raise RuntimeError('psql not found for required research DB persistence')
        return None
    try:
        p = subprocess.run(['psql', '-d', PG_DB, '-v', 'ON_ERROR_STOP=1', '-qAt', '-c', sql], text=True, capture_output=True, timeout=30)
    except Exception as e:
        if DB_STRICT:
            raise RuntimeError(f'psql execution failed for required research DB persistence: {e!r}')
        return None
    if p.returncode != 0:
        if DB_STRICT:
            raise RuntimeError('psql failed for required research DB persistence: ' + (p.stderr or p.stdout or '').strip()[:1000])
        return None
    return p.stdout if fetch else ''


