def run_chunk(run_dir: pathlib.Path, offset: int, batch_size: int, symbols: list[str] | None = None, args=None) -> dict:
    out_path = run_dir / f'chunk-{offset}.stdout.json'
    err_path = run_dir / f'chunk-{offset}.stderr.log'
    cmd = [str(SCANNER), 'run-now', '--no-outbox', '--qc-batch-limit', str(batch_size), '--qc-batch-offset', str(offset)]
    if symbols:
        cmd += ['--symbols', ','.join(symbols)]
    if args is not None:
        for attr, flag in [
            ('as_of_date', '--as-of-date'),
            ('calendar_from_days', '--calendar-from-days'),
            ('calendar_to_days', '--calendar-to-days'),
            ('calendar_source', '--calendar-source'),
            ('qc_resolution', '--qc-resolution'),
            ('option_resolution', '--option-resolution'),
            ('min_expiry_after_earnings_days', '--min-expiry-after-earnings-days'),
            ('max_expiry_after_earnings_days', '--max-expiry-after-earnings-days'),
            ('min_expiration_days', '--min-expiration-days'),
            ('max_expiration_days', '--max-expiration-days'),
            ('strike_range', '--strike-range'),
            ('option_right', '--option-right'),
            ('delta_range', '--delta-range'),
            ('iv_range', '--iv-range'),
            ('min_open_interest', '--min-open-interest'),
            ('min_volume', '--min-volume'),
            ('max_premium', '--max-premium'),
            ('min_bid', '--min-bid'),
            ('max_spread_pct', '--max-spread-pct'),
            ('min_relative_spread', '--min-relative-spread'),
            ('vol_spread_factor', '--vol-spread-factor'),
            ('expected_move_spread_fraction', '--expected-move-spread-fraction'),
        ]:
            add_if_value(cmd, flag, getattr(args, attr, None))
    snapshot = run_dir / 'calendar_snapshot.json'
    if snapshot.exists():
        cmd += ['--calendar-snapshot', str(snapshot)]
    started = time.time()
    timeout = int(os.environ.get('QC_FULL_CHUNK_TIMEOUT_SECONDS','1200'))
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        stdout = e.stdout or ''
        stderr = e.stderr or ''
        out_path.write_text(str(stdout))
        err_path.write_text(str(stderr))
        d = {
            'ok': False,
            'status': 'BLOCKED_CHUNK_TIMEOUT',
            'blocked_reason': f'chunk timed out after {timeout}s',
            '_chunk_offset': offset,
            '_chunk_returncode': None,
            '_chunk_seconds': round(time.time() - started, 1),
            'qc_batch_count': 0,
        }
        capacity = classify_qc_cloud_capacity(str(stdout) + '\n' + str(stderr))
        if capacity:
            d.update(capacity)
        out_path.write_text(json.dumps(d, ensure_ascii=False, indent=2, sort_keys=True) + '\n')
        append_chunk_meta(run_dir, d)
        return d
    out_path.write_text(p.stdout)
    err_path.write_text(p.stderr)
    try:
        d = json.loads(p.stdout)
    except Exception as e:
        d = {'ok': False, 'status': 'BLOCKED_CHUNK_BAD_JSON', 'blocked_reason': repr(e), 'returncode': p.returncode}
        capacity = classify_qc_cloud_capacity(p.stdout + '\n' + p.stderr)
        if capacity:
            d.update(capacity)
        out_path.write_text(json.dumps(d, ensure_ascii=False, indent=2, sort_keys=True) + '\n')
    d['_chunk_offset'] = offset
    d['_chunk_returncode'] = p.returncode
    d['_chunk_seconds'] = round(time.time() - started, 1)
    append_chunk_meta(run_dir, d)
    return d


def run_chunk_multiyear(run_dir: pathlib.Path, chunk: dict, years: int, args=None) -> dict | None:
    candidates = chunk.get('candidate_details') or []
    if not candidates:
        return None
    if not MULTIYEAR.exists():
        return {'ok': False, 'status': 'BLOCKED_MULTIYEAR_RUNNER_MISSING', 'path': str(MULTIYEAR)}
    offset = int(chunk.get('_chunk_offset') or 0)
    chunk_dir = run_dir / 'chunk_e2e' / f'offset-{offset}'
    chunk_dir.mkdir(parents=True, exist_ok=True)
    summary = {
        'ok': True,
        'status': 'OK_CHUNK_FORWARD_CANDIDATES',
        'calendar_row_count': chunk.get('calendar_row_count'),
        'calendar_universe_count': chunk.get('calendar_universe_count'),
        'qc_symbols_scanned': chunk.get('qc_batch_count'),
        'chunk_count': 1,
        'failed_chunk_count': 0,
        'candidate_count': len(candidates),
        'candidates': candidates,
        'aggregate_funnel': dict(chunk.get('funnel') or {}),
        'run_dir': str(chunk_dir),
    }
    (chunk_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    cmd = [str(MULTIYEAR), '--run-dir', str(chunk_dir), '--years', str(years)]
    for attr, flag in [
        ('entry_window', '--entry-window'),
        ('exit_days_before', '--exit-days-before'),
        ('exit_policy', '--exit-policy'),
        ('historical_resolution', '--historical-resolution'),
        ('option_resolution', '--option-resolution'),
        ('option_right', '--option-right'),
        ('max_contracts', '--max-contracts'),
        ('path_metrics', '--path-metrics'),
        ('max_premium', '--max-premium'),
        ('min_bid', '--min-bid'),
        ('max_spread', '--max-spread'),
        ('max_spread_pct', '--max-spread-pct'),
        ('min_relative_spread', '--min-relative-spread'),
        ('vol_spread_factor', '--vol-spread-factor'),
        ('expected_move_spread_fraction', '--expected-move-spread-fraction'),
        ('min_open_interest', '--min-open-interest'),
        ('min_volume', '--min-volume'),
        ('strike_range', '--strike-range'),
        ('min_expiration_days', '--min-expiration-days'),
        ('max_expiration_days', '--max-expiration-days'),
        ('max_expiry_after_earnings_days', '--max-expiry-after-earnings-days'),
        ('delta_target', '--delta-target'),
        ('stop_loss_max_loss_pct', '--stop-loss-max-loss-pct'),
    ]:
        add_if_value(cmd, flag, getattr(args, attr, None) if args is not None else None)
    # The current multiyear runner uses one QC project name. Serialize this part to avoid project push/backtest collisions.
    with MULTIYEAR_LOCK:
        timeout = int(os.environ.get('QC_MULTIYEAR_TIMEOUT_SECONDS','2400'))
        try:
            p = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
        except subprocess.TimeoutExpired as e:
            stdout = e.stdout or ''
            stderr = e.stderr or ''
            (chunk_dir/'multiyear_runner.stdout.json').write_text(str(stdout))
            (chunk_dir/'multiyear_runner.stderr.log').write_text(str(stderr))
            mb = {
                'ok': False,
                'status': 'BLOCKED_MULTIYEAR_TIMEOUT',
                'blocked_reason': f'multiyear runner timed out after {timeout}s',
                'returncode': None,
            }
            capacity = classify_qc_cloud_capacity(str(stdout) + '\n' + str(stderr))
            if capacity:
                mb.update(capacity)
            return mb
    (chunk_dir/'multiyear_runner.stdout.json').write_text(p.stdout)
    (chunk_dir/'multiyear_runner.stderr.log').write_text(p.stderr)
    try:
        mb = json.loads(p.stdout)
    except Exception as e:
        capacity = classify_qc_cloud_capacity(p.stdout + '\n' + p.stderr)
        mb = {'ok': False, 'status': 'BLOCKED_MULTIYEAR_BAD_JSON', 'blocked_reason': repr(e), 'returncode': p.returncode}
        if capacity:
            mb.update(capacity)
    return mb


def run_chunk_end_to_end(run_dir: pathlib.Path, offset: int, batch_size: int, validation_years: int, end_to_end: bool, symbols: list[str] | None = None, args=None) -> dict:
    d = run_chunk(run_dir, offset, batch_size, symbols, args=args)
    if end_to_end and d.get('ok') and d.get('candidate_details'):
        mb = run_chunk_multiyear(run_dir, d, validation_years, args=args)
        d['chunk_multiyear_backtest'] = mb
        d['historical_backtest_status'] = (mb or {}).get('status') if mb else 'NO_FORWARD_CANDIDATES'
        # Rewrite chunk stdout with attached e2e result so aggregation/status are deterministic.
        (run_dir / f'chunk-{offset}.stdout.json').write_text(json.dumps(d, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    return d


def multiyear_no_passing_symbols(status: str | None) -> bool:
    return str(status or '') in ('BLOCKED_HISTORICAL_OPTION_PNL_GATE_NO_PASSING_SYMBOLS', 'NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL')


def multiyear_completed_without_infra_failure(status: str | None, ok: bool | None) -> bool:
    return bool(ok) or multiyear_no_passing_symbols(status)


def multiyear_infrastructure_failed(status: str | None) -> bool:
    status_s = str(status or '')
    return bool(status_s) and not is_qc_cloud_capacity_status(status_s) and not multiyear_no_passing_symbols(status_s) and status_s != 'OK_MULTIYEAR_OPTION_PNL_BACKTEST'


def aggregate(chunks: list[dict]) -> dict:
    first = chunks[0] if chunks else {}
    universe = first.get('calendar_universe_count') or first.get('calendar_row_count') or 0
    calendar_rows = first.get('calendar_row_count') or universe
    def is_stale_empty_batch_chunk(d: dict) -> bool:
        offset = d.get('_chunk_offset')
        return bool(
            calendar_rows
            and offset is not None
            and int(offset) >= int(calendar_rows)
            and d.get('status') == 'BLOCKED_QC_BATCH_FAILED'
            and ((d.get('qc_checks') or {}).get('qc_option_chain_batch_diagnostic') or {}).get('reason') == 'empty_batch'
        )
    effective_chunks = [d for d in chunks if not is_stale_empty_batch_chunk(d)]
    agg = {
        '01_nasdaq_earnings_21_28d_universe': universe,
        '01_nasdaq_earnings_21_28d_universe_symbols': aggregate_funnel_symbols(effective_chunks, '01_nasdaq_earnings_21_28d_universe'),
        '07_multi_year_backtest_status': 'NOT_IMPLEMENTED_IN_RUNNER_YET_QC_EODHD_APPROVED',
    }
    for k in INT_FUNNEL_KEYS:
        vals = [(d.get('funnel') or {}).get(k) for d in effective_chunks]
        int_vals = [v for v in vals if isinstance(v, int)]
        agg[k] = sum(int_vals) if len(int_vals) == len(vals) else None
        agg[funnel_symbol_list_key(k)] = aggregate_funnel_symbols(effective_chunks, k)
    forward_candidates=[]; final_candidates=[]; seen=set(); final_seen=set(); failed=[]; scanned=0; multiyear_statuses=[]; historical_result_symbols=set(); historical_results_by_symbol={}
    for d in chunks:
        if is_stale_empty_batch_chunk(d):
            continue
        scanned += int(d.get('qc_processed_row_count') or d.get('qc_batch_count') or 0)
        if not d.get('ok'):
            failed.append({'offset': d.get('_chunk_offset'), 'status': d.get('status'), 'blocked_reason': d.get('blocked_reason')})
        mb=d.get('chunk_multiyear_backtest') or {}
        if mb:
            multiyear_statuses.append({'offset': d.get('_chunk_offset'), 'status': mb.get('status'), 'ok': mb.get('ok'), 'mode': mb.get('mode')})
            for r in mb.get('results', []):
                if r.get('symbol'):
                    historical_result_symbols.add(r.get('symbol'))
                    historical_results_by_symbol.setdefault(r.get('symbol'), []).append(r)
            passing_results={r.get('symbol'): r for r in mb.get('results',[]) if mb.get('ok') and multiyear_result_passes(r)}
        else:
            passing_results={}
        for c in d.get('candidate_details') or []:
            key=(c.get('symbol'), c.get('earnings_date'))
            if key not in seen:
                forward_candidates.append(c); seen.add(key)
            final_candidate = promoted_final_candidate(c, passing_results.get(c.get('symbol')))
            if final_candidate and key not in final_seen:
                final_candidates.append(final_candidate); final_seen.add(key)
    candidate_chunk_count = sum(1 for d in chunks if d.get('candidate_details'))
    validated_candidate_chunk_count = sum(1 for d in chunks if d.get('candidate_details') and d.get('chunk_multiyear_backtest'))
    all_candidate_chunks_validated = candidate_chunk_count > 0 and validated_candidate_chunk_count == candidate_chunk_count
    historical_gate_ran = bool(multiyear_statuses)
    base_scan_complete = bool(chunks) and not failed and scanned >= calendar_rows
    all_forward_candidates_had_historical_results = bool(forward_candidates) and all(c.get('symbol') in historical_result_symbols for c in forward_candidates)
    # Evidence deficiencies are blocked; terminal no-pass means every consulted candidate was fully evaluated.
    all_consulted_results_had_window_evidence = (
        all_forward_candidates_had_historical_results
        and all(
            all(multiyear_result_has_window_evidence(r) for r in historical_results_by_symbol.get(c.get('symbol'), []))
            for c in forward_candidates
        )
    )
    no_forward_candidates_preblocked = not any(candidate_historical_status_blocks(c) for c in forward_candidates)
    historical_gate_no_pass = bool(forward_candidates) and base_scan_complete and all_candidate_chunks_validated and historical_gate_ran and not final_candidates and all_forward_candidates_had_historical_results and all_consulted_results_had_window_evidence and no_forward_candidates_preblocked and all(multiyear_completed_without_infra_failure(x.get('status'), x.get('ok')) for x in multiyear_statuses)
    historical_failed_chunks = [x for x in multiyear_statuses if x.get('ok') is False and multiyear_infrastructure_failed(x.get('status'))]
    capacity_blocked_chunks = [x for x in multiyear_statuses if x.get('ok') is False and is_qc_cloud_capacity_status(x.get('status'))]
    if historical_failed_chunks:
        for x in historical_failed_chunks:
            x.setdefault('blocked_reason', 'mandatory multiyear option-PnL backtest failed')
    multiyear_failed = bool(historical_failed_chunks)
    qc_capacity_blocked = bool(capacity_blocked_chunks)
    qc_capacity_statuses = sorted({str(x.get('status')) for x in capacity_blocked_chunks if x.get('status')})
    qc_capacity_status = qc_capacity_statuses[0] if len(qc_capacity_statuses) == 1 else 'BLOCKED_QC_CLOUD_CAPACITY'
    historical_gate_blocked = base_scan_complete and bool(forward_candidates) and not final_candidates and (not historical_gate_ran or multiyear_failed or qc_capacity_blocked or (historical_gate_ran and not historical_gate_no_pass))
    missing_window_evidence = historical_gate_blocked and historical_gate_ran and all_forward_candidates_had_historical_results and no_forward_candidates_preblocked and not all_consulted_results_had_window_evidence
    if multiyear_statuses:
        if all(x.get('ok') for x in multiyear_statuses):
            agg['07_multi_year_backtest_status'] = 'OK_CHUNKED_MULTIYEAR_OPTION_PNL_BACKTEST'
        elif historical_gate_no_pass:
            agg['07_multi_year_backtest_status'] = 'NO_PASSING_SYMBOLS_AFTER_CHUNKED_MULTIYEAR_OPTION_PNL_BACKTEST'
        else:
            agg['07_multi_year_backtest_status'] = 'PARTIAL_CHUNKED_MULTIYEAR_OPTION_PNL_BACKTEST'
    ok = base_scan_complete and not historical_gate_blocked and not multiyear_failed and not qc_capacity_blocked and not historical_gate_no_pass
    status = 'OK_FULL_QC_SCAN' if ok else ('NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL' if historical_gate_no_pass else (qc_capacity_status if qc_capacity_blocked else ('BLOCKED_HISTORICAL_OPTION_PNL_MISSING_WINDOW_EVIDENCE' if missing_window_evidence else ('BLOCKED_HISTORICAL_OPTION_PNL_GATE' if historical_gate_blocked else ('PARTIAL_FULL_QC_SCAN' if chunks else 'BLOCKED_FULL_SCAN_NOT_RUN')))))
    gate = final_candidate_gate_thresholds()
    final_candidate_gate_evaluations = [
        final_candidate_gate_evaluation(r, gate)
        for rows in historical_results_by_symbol.values()
        for r in rows
    ]
    return {
        'ok': ok,
        'status': status,
        'calendar_row_count': calendar_rows,
        'calendar_universe_count': universe,
        'qc_symbols_scanned': scanned,
        'chunk_count': len(chunks),
        'failed_chunk_count': len(failed),
        'failed_chunks': failed,
        'historical_failed_chunk_count': len(historical_failed_chunks),
        'historical_failed_chunks': historical_failed_chunks,
        'qc_capacity_blocked': qc_capacity_blocked,
        'qc_capacity_blocked_chunks': capacity_blocked_chunks,
        'qc_capacity_status': qc_capacity_status if qc_capacity_blocked else None,
        'aggregate_funnel': agg,
        'forward_candidate_count': len(forward_candidates),
        'forward_candidates': forward_candidates,
        'candidate_count': len(final_candidates),
        'candidates': final_candidates,
        'final_candidate_count': len(final_candidates),
        'final_candidates': final_candidates,
        'chunk_multiyear_statuses': multiyear_statuses,
        'candidate_chunk_count': candidate_chunk_count,
        'validated_candidate_chunk_count': validated_candidate_chunk_count,
        'historical_gate_ran': historical_gate_ran,
        'historical_gate_blocked': historical_gate_blocked,
        'historical_gate_no_pass': historical_gate_no_pass,
        'multiyear_failed': multiyear_failed,
        'final_candidate_gate': gate,
        'final_candidate_gate_evaluations': final_candidate_gate_evaluations,
        'guardrails': {
            'no_yahoo_yfinance': True,
            'nasdaq_calendar_stage_only': True,
            'qc_for_options_and_history': True,
            'chunked_qc_batch_size_safe_default': True,
            'research_only': True,
        },
    }


def hebrew_report(summary: dict, batch_size: int) -> str:
    f = summary['aggregate_funnel']
    lines = [
        'סריקת earnings QC מלאה הסתיימה.' if summary.get('ok') else 'סריקת earnings QC מלאה הסתיימה חלקית / נחסמה.',
        f'- סטטוס: {summary.get("status")}',
        f'- universe Nasdaq: {summary.get("calendar_universe_count")} סימבולים / {summary.get("calendar_row_count")} שורות',
        f'- נסרקו ב־QC: {summary.get("qc_symbols_scanned")} סימבולים, chunks={summary.get("chunk_count")}, chunk_size={batch_size}',
        f'- option chain: {f.get("02_qc_option_chain_available")}',
        f'- פקיעה עד 7 ימים אחרי הדוח: {f.get("03_qc_expiry_within_0_7d_after_earnings")}',
        f'- OTM בתוך חלון הפקיעה: {f.get("035_qc_otm_expiry_within_0_7d_after_earnings")}',
        f'- calls עם ask <= max premium: {f.get("04_qc_calls_ask_under_max_premium")}',
        f'- liquidity/Greeks quality pass: {f.get("05_qc_liquidity_greeks_quality_pass")}',
        f'- multi-year backtest: {f.get("07_multi_year_backtest_status")}',
        f'- forward candidates לפני historical PnL: {summary.get("forward_candidate_count")}',
        f'- מועמדים סופיים אחרי historical PnL: {summary.get("candidate_count")}',
    ]
    if summary.get('failed_chunk_count'):
        lines.append(f'- chunks שנכשלו: {summary.get("failed_chunk_count")} — הרץ retry-failed')
    lines.append('- לא הופעל Yahoo/yfinance.')
    return '\n'.join(lines)


def write_summary(run_dir: pathlib.Path, batch_size: int, notify: bool=False) -> dict:
    chunks = load_chunks(run_dir)
    summary = aggregate(chunks)
    summary.update({'run_date': datetime.datetime.now(datetime.timezone.utc).date().isoformat(), 'run_dir': str(run_dir), 'chunk_size': batch_size})
    msg = hebrew_report(summary, batch_size)
    (run_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    (run_dir/'hebrew_report.md').write_text(msg+'\n')
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR/'latest-full-run.txt').write_text(str(run_dir)+'\n')
    if notify and (summary.get('candidate_count') or summary.get('forward_candidate_count') or not summary.get('ok')):
        summary['outbox_written'] = write_outbox(msg, summary)
        (run_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    return summary


def discover_calendar_total(run_dir: pathlib.Path, batch_size: int, start_offset: int, validation_years: int, end_to_end: bool, symbols: list[str] | None = None, args=None) -> int | None:
    # Run one deterministic chunk first so we know and snapshot the Nasdaq calendar total/order.
    d = run_chunk_end_to_end(run_dir, start_offset, batch_size, validation_years, end_to_end, symbols, args=args)
    report_dir = d.get('report_dir')
    src = pathlib.Path(report_dir) / 'calendar_rows.json' if report_dir else None
    if src and src.exists():
        (run_dir / 'calendar_snapshot.json').write_text(src.read_text())
    return d.get('calendar_row_count') or d.get('calendar_universe_count')


def run_chunks_parallel(run_dir: pathlib.Path, offsets: list[int], batch_size: int, parallel: int, validation_years: int, end_to_end: bool, symbols: list[str] | None = None, args=None) -> None:
    if not offsets:
        return
    parallel = max(1, int(parallel or 1))
    if parallel == 1:
        delay = float(os.environ.get('QC_FULL_CHUNK_DELAY_SECONDS', '30'))
        for i, off in enumerate(offsets):
            try:
                run_chunk_end_to_end(run_dir, off, batch_size, validation_years, end_to_end, symbols, args=args)
            except Exception as e:
                d = {'ok': False, 'status': 'BLOCKED_CHUNK_EXCEPTION', 'blocked_reason': repr(e), '_chunk_offset': off, '_chunk_seconds': None, 'qc_batch_count': 0}
                (run_dir / f'chunk-{off}.stdout.json').write_text(json.dumps(d, ensure_ascii=False, indent=2))
                (run_dir / f'chunk-{off}.stderr.log').write_text(repr(e))
                append_chunk_meta(run_dir, d)
            if delay > 0 and i < len(offsets) - 1:
                time.sleep(delay)
        return
    # Conservative bounded parallelism for QC Cloud compile/backtest stability.
    with concurrent.futures.ThreadPoolExecutor(max_workers=parallel) as ex:
        futs = {ex.submit(run_chunk_end_to_end, run_dir, off, batch_size, validation_years, end_to_end, symbols, args): off for off in offsets}
        for fut in concurrent.futures.as_completed(futs):
            off = futs[fut]
            try:
                fut.result()
            except Exception as e:
                d = {'ok': False, 'status': 'BLOCKED_CHUNK_EXCEPTION', 'blocked_reason': repr(e), '_chunk_offset': off, '_chunk_seconds': None, 'qc_batch_count': 0}
                (run_dir / f'chunk-{off}.stdout.json').write_text(json.dumps(d, ensure_ascii=False, indent=2))
                (run_dir / f'chunk-{off}.stderr.log').write_text(repr(e))
                append_chunk_meta(run_dir, d)


def run_multiyear_if_requested(run_dir: pathlib.Path, args) -> dict | None:
    if not args.end_to_end:
        return None
    if not MULTIYEAR.exists():
        return {'ok': False, 'status': 'BLOCKED_MULTIYEAR_RUNNER_MISSING', 'path': str(MULTIYEAR)}
    cmd = [str(MULTIYEAR), '--run-dir', str(run_dir), '--years', str(getattr(args, 'validation_years', args.years))]
    for attr, flag in [
        ('entry_window', '--entry-window'),
        ('exit_days_before', '--exit-days-before'),
        ('exit_policy', '--exit-policy'),
        ('historical_resolution', '--historical-resolution'),
        ('option_resolution', '--option-resolution'),
        ('option_right', '--option-right'),
        ('max_contracts', '--max-contracts'),
        ('path_metrics', '--path-metrics'),
        ('max_premium', '--max-premium'),
        ('min_bid', '--min-bid'),
        ('max_spread', '--max-spread'),
        ('max_spread_pct', '--max-spread-pct'),
        ('min_relative_spread', '--min-relative-spread'),
        ('vol_spread_factor', '--vol-spread-factor'),
        ('expected_move_spread_fraction', '--expected-move-spread-fraction'),
        ('min_open_interest', '--min-open-interest'),
        ('min_volume', '--min-volume'),
        ('strike_range', '--strike-range'),
        ('min_expiration_days', '--min-expiration-days'),
        ('max_expiration_days', '--max-expiration-days'),
        ('max_expiry_after_earnings_days', '--max-expiry-after-earnings-days'),
        ('delta_target', '--delta-target'),
        ('stop_loss_max_loss_pct', '--stop-loss-max-loss-pct'),
    ]:
        add_if_value(cmd, flag, getattr(args, attr, None))
    timeout = int(os.environ.get('QC_MULTIYEAR_TIMEOUT_SECONDS','2400'))
    try:
        p = subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        stdout = e.stdout or ''
        stderr = e.stderr or ''
        (run_dir/'multiyear_runner.stdout.json').write_text(str(stdout))
        (run_dir/'multiyear_runner.stderr.log').write_text(str(stderr))
        out = {
            'ok': False,
            'status': 'BLOCKED_MULTIYEAR_TIMEOUT',
            'blocked_reason': f'multiyear runner timed out after {timeout}s',
            'returncode': None,
        }
        capacity = classify_qc_cloud_capacity(str(stdout) + '\n' + str(stderr))
        if capacity:
            out.update(capacity)
        return out
    (run_dir/'multiyear_runner.stdout.json').write_text(p.stdout)
    (run_dir/'multiyear_runner.stderr.log').write_text(p.stderr)
    try:
        return json.loads(p.stdout)
    except Exception as e:
        capacity = classify_qc_cloud_capacity(p.stdout + '\n' + p.stderr)
        out = {'ok': False, 'status': 'BLOCKED_MULTIYEAR_BAD_JSON', 'blocked_reason': repr(e), 'returncode': p.returncode}
        if capacity:
            out.update(capacity)
        return out


def cmd_run(args) -> int:
    validate_historical_runtime_params(args)
    campaign_id = args.campaign or DEFAULT_CAMPAIGN
    normalize_lifecycle_stage_params(args, default_from='calendar', default_to='historical_option_pnl' if args.end_to_end else 'candidate_scan')
    args.validation_years = int(getattr(args, 'validation_years', None) or args.years)
    if args.from_stage == 'historical_option_pnl':
        return cmd_historical(args)
    if stage_index(args.from_stage) > stage_index(args.to_stage):
        print(json.dumps({'ok': False, 'status': 'INVALID_STAGE_RANGE', 'from_stage': args.from_stage, 'to_stage': args.to_stage}, ensure_ascii=False, indent=2)); return 2
    if args.to_stage == 'intraday_validation':
        print(json.dumps({'ok': False, 'status': 'STAGE_NOT_IMPLEMENTED_FOR_RUN_TARGET', 'to_stage': args.to_stage}, ensure_ascii=False, indent=2)); return 2
    if args.from_stage == 'candidate_scan':
        print(json.dumps({'ok': False, 'status': 'STAGE_NOT_IMPLEMENTED_FOR_RUN_START', 'from_stage': args.from_stage, 'blocked_reason': 'candidate_scan start requires persisted QC chain artifacts; rerun from calendar/qc_chain_scan or historical_option_pnl'}, ensure_ascii=False, indent=2)); return 2
    if args.from_stage not in ('calendar', 'qc_chain_scan'):
        print(json.dumps({'ok': False, 'status': 'STAGE_NOT_IMPLEMENTED_FOR_RUN_START', 'from_stage': args.from_stage}, ensure_ascii=False, indent=2)); return 2
    if stage_index(args.to_stage) < stage_index('historical_option_pnl'):
        args.end_to_end = False
    if not require_research_db():
        print(json.dumps({'ok': False, 'status': 'DB_UNAVAILABLE', 'campaign_id': campaign_id}, ensure_ascii=False, indent=2)); return 1
    global DB_STRICT
    DB_STRICT = True
    now = datetime.datetime.now(datetime.timezone.utc)
    run_dir = pathlib.Path(args.run_dir) if args.run_dir else REPORT_ROOT / f'earnings-qc-options-scan-full-{now.strftime("%Y%m%d-%H%M%S")}'
    run_id = args.run_id or run_dir.name
    params = current_parameters(args)
    upsert_campaign(campaign_id, params=params)
    upsert_run(run_id, campaign_id, 'running', run_dir, params)
    db_run_check = latest_db_run(campaign_id)
    if not db_run_check or db_run_check.get('run_id') != run_id:
        print(json.dumps({'ok': False, 'status': 'DB_RUN_PERSIST_FAILED', 'campaign_id': campaign_id, 'run_id': run_id}, ensure_ascii=False, indent=2)); return 1
    run_dir.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR/'latest-full-run.txt').write_text(str(run_dir)+'\n')
    calendar_total = None
    existing_offsets = {int(d.get('_chunk_offset') or 0) for d in load_chunks(run_dir)} if args.resume else set()
    start_offset = args.start_offset
    symbols = normalize_symbols_arg(args.symbols)
    try:
        if existing_offsets:
            chunks = load_chunks(run_dir)
            calendar_total = (chunks[0].get('calendar_row_count') or chunks[0].get('calendar_universe_count')) if chunks else None
        elif args.from_stage == 'qc_chain_scan':
            snapshot = run_dir / 'calendar_snapshot.json'
            if not snapshot.exists():
                print(json.dumps({'ok': False, 'status': 'MISSING_CALENDAR_SNAPSHOT_FOR_QC_CHAIN_START', 'from_stage': args.from_stage, 'run_dir': str(run_dir), 'required_artifact': str(snapshot)}, ensure_ascii=False, indent=2)); return 2
            rows = json.loads(snapshot.read_text())
            calendar_total = len(rows)
        else:
            calendar_total = discover_calendar_total(run_dir, args.chunk_size, start_offset, args.validation_years, args.end_to_end, symbols, args=args)
            existing_offsets.add(start_offset)
        offsets=[]
        if args.from_stage == 'qc_chain_scan' and start_offset not in existing_offsets:
            offsets.append(start_offset)
        if calendar_total:
            off = start_offset + args.chunk_size
            while off < int(calendar_total):
                if off not in existing_offsets:
                    offsets.append(off)
                off += args.chunk_size
            if args.max_chunks is not None:
                already_ran = len(existing_offsets) if args.from_stage == 'calendar' else 0
                remaining=max(0,args.max_chunks-already_ran)
                offsets=offsets[:remaining]
        if offsets and not args.resume:
            discovery_delay = float(os.environ.get('QC_FULL_CHUNK_DELAY_SECONDS', '30'))
            if discovery_delay > 0:
                time.sleep(discovery_delay)
        run_chunks_parallel(run_dir, offsets, args.chunk_size, args.parallel, args.validation_years, args.end_to_end, symbols, args=args)
        summary = write_summary(run_dir, args.chunk_size, notify=False)
        if args.to_stage == 'candidate_scan' and summary.get('status') == 'BLOCKED_HISTORICAL_OPTION_PNL_GATE':
            summary['ok'] = True
            summary['status'] = 'OK_CANDIDATE_SCAN_REQUIRES_HISTORICAL_OPTION_PNL'
            summary['historical_gate_blocked'] = False
            summary['candidate_scan_only'] = True
            fp = run_dir/'full_summary.json'
            if fp.exists():
                fp.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
        mb = None if (args.end_to_end and summary.get('chunk_multiyear_statuses')) else run_multiyear_if_requested(run_dir, args)
        if mb is not None:
            summary = refresh_summary_after_historical(run_dir, mb)
            summary['end_to_end'] = {'requested': True, 'multiyear_status': mb.get('status'), 'multiyear_ok': mb.get('ok'), 'parallel_forward_chunks': args.parallel, 'years': args.validation_years, 'scan_years': args.years}
            fp=run_dir/'full_summary.json'
            fp.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
        summary['campaign_id'] = campaign_id; summary['run_id'] = run_id; summary['parameters'] = params; summary['stage_range'] = {'from_stage': args.from_stage, 'to_stage': args.to_stage}
        annotate_final_candidate_gate(summary, args.validation_years)
        fp=run_dir/'full_summary.json'
        fp.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
        persist_summary_to_db(campaign_id, run_id, run_dir, summary, params)
        db_after = latest_db_run(campaign_id)
        if not db_after or db_after.get('run_id') != run_id:
            print(json.dumps({'ok': False, 'status': 'DB_SUMMARY_PERSIST_FAILED', 'campaign_id': campaign_id, 'run_id': run_id}, ensure_ascii=False, indent=2)); return 1
        if not args.no_outbox and (summary.get('candidate_count') or summary.get('forward_candidate_count') or not summary.get('ok')):
            msg = hebrew_report(summary, args.chunk_size)
            summary['outbox_written'] = write_outbox(msg, summary)
            (run_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
        print(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True))
