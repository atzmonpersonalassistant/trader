    upsert_campaign(campaign_id, params=params); upsert_run(run_id, campaign_id, 'completed' if summary.get('ok') else 'blocked', run_dir, params, summary, finished=True)
    f = summary.get('aggregate_funnel') or {}; years = params.get('years') or 'unknown'
    upsert_stage(campaign_id, run_id, 'calendar', 'completed', output_json={'row_count': summary.get('calendar_row_count'), 'universe_count': summary.get('calendar_universe_count')}, artifact_path=str(run_dir/'calendar_snapshot.json'), params=params, passed=summary.get('calendar_universe_count'))
    upsert_stage(campaign_id, run_id, 'qc_chain_scan', 'completed', output_json={'available': f.get('02_qc_option_chain_available'), 'scanned': summary.get('qc_symbols_scanned')}, params=params, passed=f.get('02_qc_option_chain_available'))
    upsert_stage(campaign_id, run_id, 'liquidity_greeks', 'completed', output_json={'pass': f.get('05_qc_liquidity_greeks_quality_pass'), 'cheap_calls': f.get('04_qc_calls_ask_under_max_premium')}, params=params, passed=f.get('05_qc_liquidity_greeks_quality_pass'))
    upsert_stage(campaign_id, run_id, f'historical_option_pnl_years_{years}', 'completed' if summary.get('chunk_multiyear_statuses') or summary.get('multiyear_backtest') else 'skipped', output_json={'status': f.get('07_multi_year_backtest_status'), 'chunks': summary.get('chunk_multiyear_statuses') or [], 'final_candidate_count': summary.get('final_candidate_count')}, artifact_path=str(run_dir/'chunk_e2e'), params=params, passed=summary.get('final_candidate_count'), failed=summary.get('forward_candidate_count'), blocker=summary.get('status') if summary.get('historical_gate_blocked') else None)
    upsert_stage(campaign_id, run_id, 'aggregate_report', 'completed', output_json=summary, artifact_path=str(run_dir/'full_summary.json'), params=params, passed=summary.get('final_candidate_count'), failed=summary.get('failed_chunk_count'), blocker=summary.get('status') if not summary.get('ok') else None)
    for name, rel in [('aggregate_report','full_summary.json'), ('aggregate_report','hebrew_report.md'), ('calendar','calendar_snapshot.json')]: insert_artifact(name, run_id, run_dir/rel, keep=(rel=='full_summary.json'))
    persist_candidates(campaign_id, run_id, summary)


