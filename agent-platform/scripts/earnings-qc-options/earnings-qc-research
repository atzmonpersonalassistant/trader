def normalize_symbols_arg(symbols: str | None) -> list[str]:
    if not symbols:
        return []
    out = []
    seen = set()
    for raw in symbols.replace(';', ',').split(','):
        sym = raw.strip().upper()
        if not sym:
            continue
        if not all(c.isalnum() or c in {'-', '_'} for c in sym):
            raise SystemExit(f'invalid symbol for --symbols: {sym!r}')
        if sym not in seen:
            out.append(sym); seen.add(sym)
    return out


