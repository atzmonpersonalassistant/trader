KNOWN_CLEANUP_REPORT_DIR_POLICIES = (
    ('earnings-qc-options-scan-full', 'earnings-qc-options-scan-full-*'),
    ('research-pass', 'research-pass-*'),
    ('qc-run', 'qc-run-*'),
)
UNKNOWN_CLEANUP_REPORT_DIR_POLICY = 'other-report-dir'


def cleanup_report_dir_policy(path: pathlib.Path) -> str:
    name = path.name
    for policy, pattern in KNOWN_CLEANUP_REPORT_DIR_POLICIES:
        if fnmatch.fnmatchcase(name, pattern):
            return policy
    return UNKNOWN_CLEANUP_REPORT_DIR_POLICY


def cleanup_can_delete_run_dir(path: pathlib.Path) -> bool:
    policy = cleanup_report_dir_policy(path)
    if policy == 'earnings-qc-options-scan-full':
        return True
    if policy == 'research-pass':
        return (path / 'final_report.md').is_file() and (path / 'exit_code').is_file()
    if policy == 'qc-run':
        if (path / 'qc_run_result.json').is_file():
            return True
        manifest_path = path / 'qc_cloud_run_manifest.json'
        if not manifest_path.is_file():
            return False
        try:
            manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
        except Exception:
            return False
        return manifest.get('status') in {'cloud_backtest_completed', 'cloud_backtest_failed'} and bool(manifest.get('completed_at_utc'))
    if policy == UNKNOWN_CLEANUP_REPORT_DIR_POLICY:
        return True
    return False


def cleanup_dir_size(path: pathlib.Path) -> int:
    total = 0
    for f in path.rglob('*'):
        try:
            if f.is_file():
                total += f.stat().st_size
        except FileNotFoundError:
            continue
    return total


