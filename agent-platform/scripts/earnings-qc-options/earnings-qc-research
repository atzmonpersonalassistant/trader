def write_summary(run_dir: pathlib.Path, batch_size: int, notify: bool=False) -> dict:
    chunks = load_chunks(run_dir)
    summary = aggregate(chunks)
    summary.update({'run_date': datetime.datetime.now(datetime.timezone.utc).date().isoformat(), 'run_dir': str(run_dir), 'chunk_size': batch_size})
    msg = hebrew_report(summary, batch_size)
    (run_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    (run_dir/'hebrew_report.md').write_text(msg+'\n')
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    (STATE_DIR/'latest-full-run.txt').write_text(str(run_dir)+'\n')
    if notify and (summary.get('candidate_count') or summary.get('forward_candidate_count') or not summary.get('ok')):
        summary['outbox_written'] = write_outbox(msg, summary)
        (run_dir/'full_summary.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    return summary


def discover_calendar_total(run_dir: pathlib.Path, batch_size: int, start_offset: int, years: int, end_to_end: bool, symbols: list[str] | None = None, args=None) -> int | None:
    # Run one deterministic chunk first so we know and snapshot the Nasdaq calendar total/order.
    d = run_chunk_end_to_end(run_dir, start_offset, batch_size, years, end_to_end, symbols, args=args)
    report_dir = d.get('report_dir')
    src = pathlib.Path(report_dir) / 'calendar_rows.json' if report_dir else None
    if src and src.exists():
        (run_dir / 'calendar_snapshot.json').write_text(src.read_text())
    return d.get('calendar_row_count') or d.get('calendar_universe_count')


def run_chunks_parallel(run_dir: pathlib.Path, offsets: list[int], batch_size: int, parallel: int, years: int, end_to_end: bool, symbols: list[str] | None = None, args=None) -> None:
    if not offsets:
        return
    parallel = max(1, int(parallel or 1))
    if parallel == 1:
        delay = float(os.environ.get('QC_FULL_CHUNK_DELAY_SECONDS', '30'))
        for i, off in enumerate(offsets):
            run_chunk_end_to_end(run_dir, off, batch_size, years, end_to_end, symbols, args=args)
            if delay > 0 and i < len(offsets) - 1:
                time.sleep(delay)
        return
    # Conservative bounded parallelism for QC Cloud compile/backtest stability.
    with concurrent.futures.ThreadPoolExecutor(max_workers=parallel) as ex:
        futs = {ex.submit(run_chunk_end_to_end, run_dir, off, batch_size, years, end_to_end, symbols, args): off for off in offsets}
        for fut in concurrent.futures.as_completed(futs):
            off = futs[fut]
            try:
                fut.result()
            except Exception as e:
                d = {'ok': False, 'status': 'BLOCKED_CHUNK_EXCEPTION', 'blocked_reason': repr(e), '_chunk_offset': off, '_chunk_seconds': None, 'qc_batch_count': 0}
                (run_dir / f'chunk-{off}.stdout.json').write_text(json.dumps(d, ensure_ascii=False, indent=2))
                (run_dir / f'chunk-{off}.stderr.log').write_text(repr(e))
                append_chunk_meta(run_dir, d)


