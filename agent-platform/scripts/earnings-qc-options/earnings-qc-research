def cmd_cleanup(args) -> int:
    policy = {'older_than_days': args.older_than_days, 'keep_last': args.keep_last, 'dry_run': args.dry_run}
    cutoff = time.time() - args.older_than_days * 86400
    dirs = sorted([p for p in REPORT_ROOT.glob('earnings-qc-options-scan-full-*') if p.is_dir()], key=lambda p: p.stat().st_mtime, reverse=True)
    protected = {str(p) for p in dirs[:args.keep_last]}
    deleted = []; freed = 0
    for d in dirs[args.keep_last:]:
        if d.stat().st_mtime >= cutoff or str(d) in protected:
            continue
        size = sum((f.stat().st_size for f in d.rglob('*') if f.is_file()), 0)
        item = {'path': str(d), 'bytes': size}
        deleted.append(item); freed += size
        if not args.dry_run:
            shutil.rmtree(d, ignore_errors=True)
    cid = stable_id('cleanup', utc_now(), args.dry_run, args.older_than_days, args.keep_last)
    if ensure_research_db():
        db_exec(f"""INSERT INTO {PG_SCHEMA}.cleanup_runs(cleanup_id,finished_at,dry_run,policy_json,deleted_paths_json,freed_bytes)
VALUES ({sql_lit(cid)}, now(), {'TRUE' if args.dry_run else 'FALSE'}, {sql_json(policy)}, {sql_lit(json.dumps(deleted, ensure_ascii=False))}::jsonb, {freed});""")
    print(json.dumps({'ok': True, 'cleanup_id': cid, 'dry_run': args.dry_run, 'deleted_paths': deleted, 'freed_bytes': freed, 'policy': policy}, ensure_ascii=False, indent=2, sort_keys=True))
    return 0

