def is_run_blocked(summary: dict | None) -> bool:
    if not summary:
        return False
    status = str(summary.get('status') or '')
    return bool(
        summary.get('historical_gate_blocked')
        or summary.get('multiyear_failed')
        or summary.get('qc_capacity_blocked')
        or status.startswith('BLOCKED_')
        or status.startswith('PARTIAL_')
    )


def int_or_none(v) -> int | None:
    if v is None:
        return None
    try:
        return int(v)
    except Exception:
        return None


def derive_funnel_bottleneck(summary: dict | None) -> str | None:
    if not summary:
        return None
    final_count = int_or_none(summary.get('final_candidate_count') or summary.get('candidate_count')) or 0
    if final_count > 0:
        return None
    funnel = summary.get('aggregate_funnel') or summary.get('funnel') or {}
    for key in INT_FUNNEL_KEYS:
        if int_or_none(funnel.get(key)) is None:
            return FUNNEL_INCOMPLETE_BOTTLENECK
    counts = []
    for key, name in BOTTLENECK_FUNNEL_STAGES:
        raw = summary.get(key) if key == 'qc_symbols_scanned' else funnel.get(key)
        value = int_or_none(raw)
        if value is None:
            return FUNNEL_INCOMPLETE_BOTTLENECK
        counts.append((name, value))
    largest_drop_rate = 0.0
    bottleneck = None
    for (_, prev_count), (name, count) in zip(counts, counts[1:]):
        if count == 0:
            return name
        if prev_count <= 0:
            continue
        drop_rate = (prev_count - count) / prev_count
        if drop_rate > largest_drop_rate:
            largest_drop_rate = drop_rate
            bottleneck = name
    return bottleneck


def upsert_run(run_id: str, campaign_id: str, status: str, run_dir: pathlib.Path | None, params: dict, summary: dict | None = None, error: str | None = None, finished: bool = False) -> None:
    if not ensure_research_db(): return
    summary = summary or {}; final_count = int(summary.get('final_candidate_count') or summary.get('candidate_count') or 0) if summary else 0
    forward_count = int(summary.get('forward_candidate_count') or 0) if summary else 0
    research_verdict = summary.get('status') if summary else None
    bottleneck = research_verdict if summary and is_run_blocked(summary) else (derive_funnel_bottleneck(summary) or error)
    finished_sql = 'now()' if finished else 'NULL'
    db_exec(f"""INSERT INTO {PG_SCHEMA}.research_runs(run_id,campaign_id,status,started_at,finished_at,parameters_json,run_dir,summary_json,final_candidate_count,forward_candidate_count,research_verdict,bottleneck,error,updated_at)
VALUES ({sql_lit(run_id)}, {sql_lit(campaign_id)}, {sql_lit(status)}, now(), {finished_sql}, {sql_json(params)}, {sql_lit(str(run_dir) if run_dir else None)}, {sql_json(summary)}, {final_count}, {forward_count}, {sql_lit(research_verdict)}, {sql_lit(bottleneck)}, {sql_lit(error)}, now())
ON CONFLICT (run_id) DO UPDATE SET status=EXCLUDED.status, finished_at=COALESCE(EXCLUDED.finished_at,{PG_SCHEMA}.research_runs.finished_at), parameters_json=COALESCE({PG_SCHEMA}.research_runs.parameters_json, '{{}}'::jsonb) || COALESCE(EXCLUDED.parameters_json, '{{}}'::jsonb), run_dir=EXCLUDED.run_dir, summary_json=EXCLUDED.summary_json, final_candidate_count=EXCLUDED.final_candidate_count, forward_candidate_count=EXCLUDED.forward_candidate_count, research_verdict=EXCLUDED.research_verdict, bottleneck=EXCLUDED.bottleneck, error=EXCLUDED.error, updated_at=now();""")


def upsert_stage(campaign_id: str, run_id: str, stage_name: str, status: str, input_json=None, output_json=None, artifact_path: str | None = None, params=None, passed=None, failed=None, blocker=None, error=None) -> None:
    if not ensure_research_db(): return
    sid = stable_id('stage', run_id, stage_name); ih = hashlib.sha256(json.dumps(input_json or {}, sort_keys=True).encode()).hexdigest()
    finished_sql = 'now()' if status in TERMINAL_STAGE_STATUSES else 'NULL'
    db_exec(f"""INSERT INTO {PG_SCHEMA}.research_stages(stage_id,campaign_id,run_id,stage_name,status,started_at,finished_at,input_json,input_hash,output_json,artifact_path,parameters_json,passed_count,failed_count,blocker,error,updated_at)
VALUES ({sql_lit(sid)}, {sql_lit(campaign_id)}, {sql_lit(run_id)}, {sql_lit(stage_name)}, {sql_lit(status)}, now(), {finished_sql}, {sql_json(input_json or {})}, {sql_lit(ih)}, {sql_json(output_json or {})}, {sql_lit(artifact_path)}, {sql_json(params or {})}, {sql_int_or_null(passed)}, {sql_int_or_null(failed)}, {sql_lit(blocker)}, {sql_lit(error)}, now())
ON CONFLICT (run_id, stage_name) DO UPDATE SET status=EXCLUDED.status, finished_at=EXCLUDED.finished_at, input_json=EXCLUDED.input_json, input_hash=EXCLUDED.input_hash, output_json=EXCLUDED.output_json, artifact_path=EXCLUDED.artifact_path, parameters_json=COALESCE({PG_SCHEMA}.research_stages.parameters_json, '{{}}'::jsonb) || COALESCE(EXCLUDED.parameters_json, '{{}}'::jsonb), passed_count=EXCLUDED.passed_count, failed_count=EXCLUDED.failed_count, blocker=EXCLUDED.blocker, error=EXCLUDED.error, updated_at=now();""")


def insert_artifact(stage_name: str, run_id: str, path: pathlib.Path, keep: bool=False, artifact_type: str='file', metadata=None) -> None:
    if not path.exists() or not ensure_research_db(): return
    sid = stable_id('stage', run_id, stage_name); aid = stable_id('artifact', sid, str(path))
    try:
        b=path.read_bytes(); sha=hashlib.sha256(b).hexdigest(); size=len(b)
    except Exception:
        sha=None; size=None
    db_exec(f"""INSERT INTO {PG_SCHEMA}.stage_artifacts(artifact_id,stage_id,artifact_type,path,sha256,size_bytes,keep,metadata_json)
VALUES ({sql_lit(aid)}, {sql_lit(sid)}, {sql_lit(artifact_type)}, {sql_lit(str(path))}, {sql_lit(sha)}, {size if size is not None else 'NULL'}, {'TRUE' if keep else 'FALSE'}, {sql_json(metadata or {})})
ON CONFLICT (stage_id,path) DO UPDATE SET sha256=EXCLUDED.sha256, size_bytes=EXCLUDED.size_bytes, keep=EXCLUDED.keep, metadata_json=EXCLUDED.metadata_json;""")


def persist_candidates(campaign_id: str, run_id: str, summary: dict) -> None:
    if not ensure_research_db(): return
    final = summary.get('final_candidates') or summary.get('candidates') or []
    forward = summary.get('forward_candidates') or []
    hist_by_symbol = {r.get('symbol'): r for r in ((summary.get('multiyear_backtest') or {}).get('results') or []) if r.get('symbol')}
    gate_by_symbol = {
        item.get('symbol'): item
        for item in (summary.get('final_candidate_gate_evaluations') or [])
        if isinstance(item, dict) and item.get('symbol')
    }
    final_keys = {(c.get('symbol'), c.get('earnings_date') or c.get('report_date')) for c in final}
    seen = set()
    combined = []
    for c in list(final) + list(forward):
        key = (c.get('symbol'), c.get('earnings_date') or c.get('report_date'))
        if key in seen:
            continue
        seen.add(key); combined.append(c)
    for c in combined:
        sym = c.get('symbol') or 'UNKNOWN'; rd = c.get('earnings_date') or c.get('report_date'); cid = stable_id('candidate', run_id, sym, rd)
        verdict = 'final_candidate' if (sym, rd) in final_keys else 'forward_only_not_final'
        metrics = candidate_metrics_projection(c)
        if sym in gate_by_symbol:
            metrics['final_candidate_gate_evaluation'] = gate_by_symbol[sym]
        db_exec(f"""INSERT INTO {PG_SCHEMA}.candidate_dossiers(candidate_id,campaign_id,run_id,symbol,report_date,contract_json,liquidity_json,historical_pnl_json,metrics_json,verdict)
VALUES ({sql_lit(cid)}, {sql_lit(campaign_id)}, {sql_lit(run_id)}, {sql_lit(sym)}, {sql_lit(rd)}, {sql_json(c.get('contracts') or [])}, {sql_json(candidate_liquidity_projection(c))}, {sql_json(hist_by_symbol.get(sym) or {})}, {sql_json(metrics)}, {sql_lit(verdict)})
ON CONFLICT (candidate_id) DO UPDATE SET contract_json=EXCLUDED.contract_json, liquidity_json=EXCLUDED.liquidity_json, historical_pnl_json=EXCLUDED.historical_pnl_json, metrics_json=EXCLUDED.metrics_json, verdict=EXCLUDED.verdict;""")


def pick_present(d: dict, keys: list[str]) -> dict:
    return {k: d[k] for k in keys if k in d}


def candidate_liquidity_projection(c: dict) -> dict:
    contracts = c.get('contracts') or []
    liquidity_fields = [
        'contract',
        'bid',
        'ask',
        'mid',
        'spread',
        'spread_mid_pct',
        'allowed_spread',
        'allowed_relative_spread_pct',
        'volume',
        'open_interest',
        'zero_volume',
        'zero_open_interest',
        'liquidity_fail_reasons',
        'liquidity_warnings',
        'liquidity_diagnostic_only_low_oi',
        'liquidity_diagnostic_only_low_volume',
    ]
    return {
        **pick_present(c, ['contract_count', 'forward_candidate_status', 'historical_backtest_status']),
        'contracts': [pick_present(contract, liquidity_fields) for contract in contracts if isinstance(contract, dict)],
    }


def candidate_metrics_projection(c: dict) -> dict:
    contracts = c.get('contracts') or []
    metric_fields = [
        'contract',
        'expiry',
        'dte',
        'days_after_earnings',
        'strike',
        'strike_spot_ratio',
        'required_move_pct',
        'expected_option_move',
        'iv',
        'delta',
    ]
    return {
        **pick_present(c, ['spot', 'earnings_date', 'report_date']),
        'contracts': [pick_present(contract, metric_fields) for contract in contracts if isinstance(contract, dict)],
    }


