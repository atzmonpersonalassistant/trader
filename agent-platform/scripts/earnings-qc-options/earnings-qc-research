def funnel_symbol_list_key(counter_key: str) -> str:
    return f'{counter_key}_symbols'


def normalized_symbols(values) -> list[str]:
    out = []
    seen = set()
    for value in values or []:
        sym = str(value or '').strip().upper()
        if sym and sym not in seen:
            out.append(sym)
            seen.add(sym)
    return out


def chunk_funnel_symbols(chunk: dict, counter_key: str) -> list[str]:
    for source in FUNNEL_SYMBOL_SOURCES.get(counter_key, ()):
        if source in chunk:
            return normalized_symbols(chunk.get(source))
        funnel_symbols = chunk.get('funnel_symbols') or {}
        if source in funnel_symbols:
            return normalized_symbols(funnel_symbols.get(source))
        funnel = chunk.get('funnel') or {}
        symbol_key = funnel_symbol_list_key(counter_key)
        if symbol_key in funnel:
            return normalized_symbols(funnel.get(symbol_key))
    return []


def aggregate_funnel_symbols(chunks: list[dict], counter_key: str) -> list[str]:
    out = []
    seen = set()
    for chunk in chunks:
        for sym in chunk_funnel_symbols(chunk, counter_key):
            if sym not in seen:
                out.append(sym)
                seen.add(sym)
    return out



def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def sql_lit(v) -> str:
    if v is None:
        return 'NULL'
    return "'" + str(v).replace("'", "''") + "'"


def sql_json(v) -> str:
    return sql_lit(json.dumps(v if v is not None else {}, ensure_ascii=False, sort_keys=True)) + '::jsonb'


def sql_int_or_null(v) -> str:
    if v is None:
        return 'NULL'
    try:
        return str(int(v))
    except Exception:
        return 'NULL'


def db_exec(sql: str, fetch: bool = False) -> str | None:
    if shutil.which('psql') is None:
        if DB_STRICT:
            raise RuntimeError('psql not found for required research DB persistence')
        return None
    try:
        p = subprocess.run(['psql', '-d', PG_DB, '-v', 'ON_ERROR_STOP=1', '-qAt'], input=sql, text=True, capture_output=True, timeout=30)
    except Exception as e:
        if DB_STRICT:
            raise RuntimeError(f'psql execution failed for required research DB persistence: {e!r}')
        return None
    if p.returncode != 0:
        if DB_STRICT:
            raise RuntimeError('psql failed for required research DB persistence: ' + (p.stderr or p.stdout or '').strip()[:1000])
        return None
    return p.stdout if fetch else ''


