    upsert_stage(campaign_id, run_id, 'calendar', 'completed', output_json={'row_count': summary.get('calendar_row_count'), 'universe_count': summary.get('calendar_universe_count')}, artifact_path=str(run_dir/'calendar_snapshot.json'), params=params, passed=summary.get('calendar_universe_count'))
    upsert_stage(campaign_id, run_id, 'qc_chain_scan', 'completed', output_json={'available': f.get('02_qc_option_chain_available'), 'scanned': summary.get('qc_symbols_scanned')}, params=params, passed=f.get('02_qc_option_chain_available'))
    upsert_stage(campaign_id, run_id, 'liquidity_greeks', 'completed', output_json={'pass': f.get('05_qc_liquidity_greeks_quality_pass'), 'cheap_calls': f.get('04_qc_calls_ask_under_max_premium')}, params=params, passed=f.get('05_qc_liquidity_greeks_quality_pass'))
