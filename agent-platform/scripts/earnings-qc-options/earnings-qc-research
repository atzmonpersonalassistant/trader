def final_candidate_gate_thresholds() -> dict:
    return {
        'min_sample_size': int(os.environ.get('QC_FINAL_MIN_SAMPLE_SIZE', '12')),
        'min_win_rate': float(os.environ.get('QC_FINAL_MIN_WIN_RATE', '0.35')),
        'min_mean_return_pct': float(os.environ.get('QC_FINAL_MIN_MEAN_RETURN_PCT', '0')),
        'min_leave_one_out_mean_return_pct': float(os.environ.get('QC_FINAL_MIN_LEAVE_ONE_OUT_MEAN_RETURN_PCT', '0')),
        'max_dropout_pct': float(os.environ.get('QC_FINAL_MAX_DROPOUT_PCT', '40')),
        'max_drawdown_pct_lt': float(os.environ.get('QC_FINAL_MAX_DRAWDOWN_PCT', '80')),
        'max_loss_pct_gt': float(os.environ.get('QC_FINAL_MAX_LOSS_PCT', '-95')),
    }


def final_candidate_gate_warnings(years: int | None, gate: dict | None = None) -> list[dict]:
    if years is None:
        return []
    gate = gate or final_candidate_gate_thresholds()
    min_sample_size = int(gate.get('min_sample_size') or 0)
    max_possible_events = int(years) * 4
    if min_sample_size > max_possible_events:
        return [{
            'code': 'FINAL_SAMPLE_SIZE_UNSATISFIABLE_FOR_YEARS',
            'min_sample_size': min_sample_size,
            'years': int(years),
            'max_possible_quarterly_events': max_possible_events,
        }]
    return []


def annotate_final_candidate_gate(summary: dict, years: int | None) -> dict:
    gate = final_candidate_gate_thresholds()
    summary['final_candidate_gate'] = gate
    warnings = final_candidate_gate_warnings(years, gate)
    if warnings:
        summary['final_candidate_gate_warnings'] = warnings
    else:
        summary.pop('final_candidate_gate_warnings', None)
    return summary


def final_candidate_gate_evaluation(r: dict, gate: dict | None = None) -> dict:
    gate = gate or final_candidate_gate_thresholds()
    status_ok = r.get('status') == 'OK'
    sample_size = int(r.get('sample_size') if r.get('sample_size') is not None else 0)
    win_rate = float(r.get('win_rate') if r.get('win_rate') is not None else 0.0)
    mean_return = float(r.get('mean_return_pct') if r.get('mean_return_pct') is not None else -999.0)
    loo_mean_return = float(r.get('leave_one_out_mean_return_pct') if r.get('leave_one_out_mean_return_pct') is not None else -999.0)
    max_drawdown = float(r.get('max_drawdown_pct') if r.get('max_drawdown_pct') is not None else 999.0)
    max_loss = float(r.get('max_loss_pct') if r.get('max_loss_pct') is not None else -999.0)
    historical_events = int(r.get('historical_event_count') if r.get('historical_event_count') is not None else 0)
    dropout_pct = float(r.get('dropout_pct') if r.get('dropout_pct') is not None else 100.0)
    if historical_events > 0 and r.get('dropout_pct') is None:
        dropout_pct = round(max(0.0, (historical_events - sample_size) / historical_events * 100.0), 2)
    windows = r.get('window_results') or []
    window_evidence_ok = bool(windows) and all(
        w.get('status') == 'OK' and int(w.get('sample_size') if w.get('sample_size') is not None else 0) >= 1
        for w in windows
    )
    checks = {
        'status_ok': status_ok,
        'sample_size_ok': sample_size >= int(gate['min_sample_size']),
        'win_rate_ok': win_rate >= float(gate['min_win_rate']),
        'mean_return_ok': mean_return > float(gate['min_mean_return_pct']),
        'leave_one_out_mean_return_ok': loo_mean_return > float(gate['min_leave_one_out_mean_return_pct']),
        'dropout_ok': dropout_pct <= float(gate['max_dropout_pct']),
        'max_drawdown_ok': max_drawdown < float(gate['max_drawdown_pct_lt']),
        'max_loss_ok': max_loss > float(gate['max_loss_pct_gt']),
        'window_evidence_ok': window_evidence_ok,
    }
    return {
        'symbol': r.get('symbol'),
        'status': r.get('status'),
        'checks': checks,
        'failed_checks': [name for name, ok in checks.items() if not ok],
        'passed': all(checks.values()),
        'observed': {
            'sample_size': sample_size,
            'historical_event_count': historical_events,
            'win_rate': win_rate,
            'mean_return_pct': mean_return,
            'leave_one_out_mean_return_pct': loo_mean_return,
            'dropout_pct': dropout_pct,
            'max_drawdown_pct': max_drawdown,
            'max_loss_pct': max_loss,
        },
        'thresholds': gate,
    }


def multiyear_result_passes(r: dict) -> bool:
    """Deterministic final-candidate gate for historical option-PnL evidence."""
    return bool(final_candidate_gate_evaluation(r).get('passed'))

def multiyear_result_has_window_evidence(r: dict) -> bool:
    return bool((r or {}).get('window_results'))

def candidate_historical_status_blocks(c: dict) -> bool:
    status = str(c.get('historical_backtest_status') or '').upper()
    return status.startswith('BLOCKED')

def promoted_final_candidate(c: dict, historical_result: dict | None) -> dict | None:
    if not historical_result or candidate_historical_status_blocks(c) or not multiyear_result_passes(historical_result):
        return None
    out = dict(c)
    out['historical_backtest_status'] = historical_result.get('status') or 'OK'
    return out

def load_chunk(run_dir: pathlib.Path, offset: int) -> dict:
    p = run_dir / f'chunk-{offset}.stdout.json'
    try:
        d = json.loads(p.read_text())
    except Exception as e:
        d = {'ok': False, 'status': 'BLOCKED_CHUNK_BAD_JSON', 'blocked_reason': repr(e)}
    d['_chunk_offset'] = offset
    return d


def load_chunks(run_dir: pathlib.Path) -> list[dict]:
    rows = []
    index_path = run_dir / 'chunks.jsonl'
    if index_path.exists():
        latest = {}
        for line in index_path.read_text().splitlines():
            if not line.strip():
                continue
            try:
                meta = json.loads(line)
                off = int(meta['offset'])
            except Exception:
                continue
            latest[off] = meta
        for off in sorted(latest):
            meta = latest[off]
            d = load_chunk(run_dir, off)
            d['_chunk_seconds'] = meta.get('seconds')
            rows.append(d)
        return rows
    for p in sorted(run_dir.glob('chunk-*.stdout.json')):
        try:
            off = int(p.name.split('-')[1].split('.')[0])
        except Exception:
            continue
        rows.append(load_chunk(run_dir, off))
    return rows


def append_chunk_meta(run_dir: pathlib.Path, d: dict) -> None:
    meta = {'offset': d.get('_chunk_offset'), 'ok': d.get('ok'), 'status': d.get('status'), 'qc_batch_count': d.get('qc_batch_count'), 'seconds': d.get('_chunk_seconds')}
    with (run_dir / 'chunks.jsonl').open('a') as f:
        f.write(json.dumps(meta, ensure_ascii=False) + '\n')


