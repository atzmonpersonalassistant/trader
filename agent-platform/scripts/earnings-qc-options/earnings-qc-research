    'intraday_validation': 'intraday_validation',
}
STAGE_ORDER = ['calendar', 'qc_chain_scan', 'candidate_scan', 'historical_option_pnl', 'intraday_validation']

def normalize_stage(value: str | None, default: str | None = None) -> str | None:
    if value is None or value == '':
        return default
    key = value.strip().lower().replace(' ', '_')
    out = STAGE_ALIASES.get(key)
    if not out:
        raise SystemExit(f'invalid stage {value!r}; expected one of: {", ".join(sorted(STAGE_ALIASES))}')
    return out

def stage_index(stage: str) -> int:
    return STAGE_ORDER.index(stage)

def stage_in_range(stage: str, from_stage: str, to_stage: str) -> bool:
    return stage_index(from_stage) <= stage_index(stage) <= stage_index(to_stage)

def add_if_value(cmd: list[str], flag: str, value) -> None:
    if value is not None:
        cmd.extend([flag, str(value)])

