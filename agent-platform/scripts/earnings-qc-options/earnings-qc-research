def upsert_campaign(campaign_id: str, goal: str | None = None, params: dict | None = None) -> None:
    if not ensure_research_db(): return
    db_exec(f"""INSERT INTO {PG_SCHEMA}.research_campaigns(campaign_id,name,goal,default_parameters_json,updated_at)
VALUES ({sql_lit(campaign_id)}, {sql_lit(campaign_id)}, {sql_lit(goal or 'Find QC/EODHD-backed pre-earnings option candidates')}, {sql_json(params or {})}, now())
ON CONFLICT (campaign_id) DO UPDATE SET updated_at=now(), default_parameters_json=EXCLUDED.default_parameters_json;""")


def upsert_run(run_id: str, campaign_id: str, status: str, run_dir: pathlib.Path | None, params: dict, summary: dict | None = None, error: str | None = None, finished: bool = False) -> None:
    if not ensure_research_db(): return
    summary = summary or {}; final_count = int(summary.get('final_candidate_count') or summary.get('candidate_count') or 0) if summary else 0
    bottleneck = summary.get('status') if summary else error
    finished_sql = 'now()' if finished else 'NULL'
    db_exec(f"""INSERT INTO {PG_SCHEMA}.research_runs(run_id,campaign_id,status,started_at,finished_at,parameters_json,run_dir,summary_json,final_candidate_count,bottleneck,error,updated_at)
VALUES ({sql_lit(run_id)}, {sql_lit(campaign_id)}, {sql_lit(status)}, now(), {finished_sql}, {sql_json(params)}, {sql_lit(str(run_dir) if run_dir else None)}, {sql_json(summary)}, {final_count}, {sql_lit(bottleneck)}, {sql_lit(error)}, now())
ON CONFLICT (run_id) DO UPDATE SET status=EXCLUDED.status, finished_at=COALESCE(EXCLUDED.finished_at,{PG_SCHEMA}.research_runs.finished_at), parameters_json=EXCLUDED.parameters_json, run_dir=EXCLUDED.run_dir, summary_json=EXCLUDED.summary_json, final_candidate_count=EXCLUDED.final_candidate_count, bottleneck=EXCLUDED.bottleneck, error=EXCLUDED.error, updated_at=now();""")


def upsert_stage(campaign_id: str, run_id: str, stage_name: str, status: str, input_json=None, output_json=None, artifact_path: str | None = None, params=None, passed=None, failed=None, blocker=None, error=None) -> None:
    if not ensure_research_db(): return
    sid = stable_id('stage', run_id, stage_name); ih = hashlib.sha256(json.dumps(input_json or {}, sort_keys=True).encode()).hexdigest()
    db_exec(f"""INSERT INTO {PG_SCHEMA}.research_stages(stage_id,campaign_id,run_id,stage_name,status,started_at,finished_at,input_json,input_hash,output_json,artifact_path,parameters_json,passed_count,failed_count,blocker,error,updated_at)
VALUES ({sql_lit(sid)}, {sql_lit(campaign_id)}, {sql_lit(run_id)}, {sql_lit(stage_name)}, {sql_lit(status)}, now(), now(), {sql_json(input_json or {})}, {sql_lit(ih)}, {sql_json(output_json or {})}, {sql_lit(artifact_path)}, {sql_json(params or {})}, {sql_int_or_null(passed)}, {sql_int_or_null(failed)}, {sql_lit(blocker)}, {sql_lit(error)}, now())
ON CONFLICT (run_id, stage_name) DO UPDATE SET status=EXCLUDED.status, finished_at=now(), input_json=EXCLUDED.input_json, input_hash=EXCLUDED.input_hash, output_json=EXCLUDED.output_json, artifact_path=EXCLUDED.artifact_path, parameters_json=EXCLUDED.parameters_json, passed_count=EXCLUDED.passed_count, failed_count=EXCLUDED.failed_count, blocker=EXCLUDED.blocker, error=EXCLUDED.error, updated_at=now();""")


def insert_artifact(stage_name: str, run_id: str, path: pathlib.Path, keep: bool=False, artifact_type: str='file', metadata=None) -> None:
    if not path.exists() or not ensure_research_db(): return
    sid = stable_id('stage', run_id, stage_name); aid = stable_id('artifact', sid, str(path))
    try:
        b=path.read_bytes(); sha=hashlib.sha256(b).hexdigest(); size=len(b)
    except Exception:
        sha=None; size=None
    db_exec(f"""INSERT INTO {PG_SCHEMA}.stage_artifacts(artifact_id,stage_id,artifact_type,path,sha256,size_bytes,keep,metadata_json)
VALUES ({sql_lit(aid)}, {sql_lit(sid)}, {sql_lit(artifact_type)}, {sql_lit(str(path))}, {sql_lit(sha)}, {size if size is not None else 'NULL'}, {'TRUE' if keep else 'FALSE'}, {sql_json(metadata or {})})
ON CONFLICT (stage_id,path) DO UPDATE SET sha256=EXCLUDED.sha256, size_bytes=EXCLUDED.size_bytes, keep=EXCLUDED.keep, metadata_json=EXCLUDED.metadata_json;""")


def persist_candidates(campaign_id: str, run_id: str, summary: dict) -> None:
    if not ensure_research_db(): return
    final = summary.get('final_candidates') or summary.get('candidates') or []
    forward = summary.get('forward_candidates') or []
    hist_by_symbol = {r.get('symbol'): r for r in ((summary.get('multiyear_backtest') or {}).get('results') or []) if r.get('symbol')}
    final_keys = {(c.get('symbol'), c.get('earnings_date') or c.get('report_date')) for c in final}
    seen = set()
    combined = []
    for c in list(final) + list(forward):
        key = (c.get('symbol'), c.get('earnings_date') or c.get('report_date'))
        if key in seen:
            continue
        seen.add(key); combined.append(c)
    for c in combined:
        sym = c.get('symbol') or 'UNKNOWN'; rd = c.get('earnings_date') or c.get('report_date'); cid = stable_id('candidate', run_id, sym, rd)
        verdict = 'final_candidate' if (sym, rd) in final_keys else 'forward_only_not_final'
        db_exec(f"""INSERT INTO {PG_SCHEMA}.candidate_dossiers(candidate_id,campaign_id,run_id,symbol,report_date,contract_json,liquidity_json,historical_pnl_json,metrics_json,verdict)
VALUES ({sql_lit(cid)}, {sql_lit(campaign_id)}, {sql_lit(run_id)}, {sql_lit(sym)}, {sql_lit(rd)}, {sql_json(c.get('contracts') or [])}, {sql_json(c)}, {sql_json(hist_by_symbol.get(sym) or {})}, {sql_json(c)}, {sql_lit(verdict)})
ON CONFLICT (run_id,symbol,report_date) DO UPDATE SET contract_json=EXCLUDED.contract_json, liquidity_json=EXCLUDED.liquidity_json, historical_pnl_json=EXCLUDED.historical_pnl_json, metrics_json=EXCLUDED.metrics_json, verdict=EXCLUDED.verdict;""")


