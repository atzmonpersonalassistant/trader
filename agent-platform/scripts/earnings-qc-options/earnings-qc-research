def derive_insights(campaign_id: str, limit: int=20) -> dict:
    runs = db_history(campaign_id, limit)
    bottlenecks = {}
    years_seen = []
    candidates = 0
    for r in runs:
        b = r.get('bottleneck') or r.get('status') or 'unknown'
        bottlenecks[b] = bottlenecks.get(b, 0) + 1
        params = r.get('parameters_json') or {}
        if params.get('years') is not None:
            years_seen.append(params.get('years'))
        candidates += int(r.get('final_candidate_count') or 0)
    suggestions = []
    if runs:
        latest = runs[0]
        if latest.get('final_candidate_count'):
            suggestions.append({'action': 'inspect_candidates', 'reason': 'latest run has final candidates'})
        elif 'BLOCKED_HISTORICAL_OPTION_PNL_GATE' in str(latest.get('bottleneck')):
            suggestions.append({'action': 'try_more_years_or_stop', 'reason': 'forward candidates failed historical PnL gate; compare 1-year vs wider windows before loosening filters'})
        elif 'PARTIAL' in str(latest.get('bottleneck')):
            suggestions.append({'action': 'resume', 'reason': 'latest run appears partial'})
        else:
            suggestions.append({'action': 'adjust_one_knob', 'reason': 'no final candidates; change one guardrailed parameter and document decision'})
    else:
        suggestions.append({'action': 'run_initial_one_year', 'reason': 'no DB history yet', 'command': 'earnings-qc-research run --years 1 --parallel 1 --end-to-end'})
    return {'ok': True, 'campaign_id': campaign_id, 'run_count': len(runs), 'bottlenecks': bottlenecks, 'years_seen': years_seen, 'final_candidates_seen': candidates, 'suggestions': suggestions, 'runs': runs[:5]}


def cmd_insights(args) -> int:
    out = derive_insights(args.campaign or DEFAULT_CAMPAIGN, args.last)
    print(json.dumps(out, ensure_ascii=False, indent=2 if args.pretty else None, sort_keys=True))
    return 0


