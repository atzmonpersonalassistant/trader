        f'- calls עם ask <= max premium: {f.get("04_qc_calls_ask_under_max_premium")}',
        f'- liquidity/Greeks quality pass: {f.get("05_qc_liquidity_greeks_quality_pass")}',
        f'- multi-year backtest: {f.get("07_multi_year_backtest_status")}',
