    cid = stable_id('cleanup', utc_now(), args.dry_run, args.older_than_days, args.keep_last)
    deleted = []; failed = []; freed = 0; staged = []
    staging_root = REPORT_ROOT.parent / '.earnings-qc-cleanup-staging' / cid
    if args.dry_run:
        for item in cleanup_candidates:
            freed += int(item.get('bytes') or 0)
            deleted.append(item)
    else:
        staging_root.mkdir(parents=True, exist_ok=True)
        for item in cleanup_candidates:
            d = pathlib.Path(item['path'])
            size_before = int(item.get('bytes') or 0)
            staged_path = staging_root / d.name
            try:
                d.rename(staged_path)
            except Exception as exc:
                failed.append({'path': str(d), 'bytes': size_before, 'bytes_freed': 0, 'bytes_remaining': cleanup_dir_size(d) if d.exists() else 0, 'error': str(exc)})
                continue
            staged.append((d, staged_path, size_before))
            freed += size_before
            deleted.append(item)
    cleanup_error = json.dumps(failed, ensure_ascii=False) if failed else None
    audit_policy = dict(policy)
    audit_deleted = deleted
    audit_freed = freed
    if not args.dry_run:
        audit_policy.update({'planned_paths': deleted, 'planned_bytes': freed})
        audit_deleted = []
        audit_freed = 0
    audit_error = cleanup_error if args.dry_run else 'CLEANUP_IN_PROGRESS'
    try:
        db_exec(f"""INSERT INTO {PG_SCHEMA}.cleanup_runs(cleanup_id,finished_at,dry_run,policy_json,deleted_paths_json,freed_bytes,error)
VALUES ({sql_lit(cid)}, now(), {'TRUE' if args.dry_run else 'FALSE'}, {sql_json(audit_policy)}, {sql_lit(json.dumps(audit_deleted, ensure_ascii=False))}::jsonb, {audit_freed}, {sql_lit(audit_error)});""")
    except Exception:
        for original, staged_path, _size_before in reversed(staged):
            if staged_path.exists() and not original.exists():
                staged_path.rename(original)
        raise
    actual_deleted = list(deleted) if args.dry_run else []
    actual_failed = list(failed)
    actual_freed = freed if args.dry_run else 0
    for original, staged_path, size_before in staged:
        try:
            shutil.rmtree(staged_path)
        except Exception as exc:
            bytes_remaining = cleanup_dir_size(staged_path) if staged_path.exists() else 0
            bytes_freed = max(0, size_before - bytes_remaining)
            actual_freed += bytes_freed
            if staged_path.exists() and not original.exists():
                staged_path.rename(original)
            actual_failed.append({'path': str(original), 'bytes': size_before, 'bytes_freed': bytes_freed, 'bytes_remaining': bytes_remaining, 'error': str(exc)})
            continue
        actual_freed += size_before
        actual_deleted.append({'path': str(original), 'bytes': size_before})
    if not args.dry_run:
        actual_error = json.dumps(actual_failed, ensure_ascii=False) if actual_failed else None
        db_exec(f"""UPDATE {PG_SCHEMA}.cleanup_runs
SET deleted_paths_json = {sql_lit(json.dumps(actual_deleted, ensure_ascii=False))}::jsonb,
    freed_bytes = {actual_freed},
    error = {sql_lit(actual_error)}
WHERE cleanup_id = {sql_lit(cid)};""")
        deleted = actual_deleted
        failed = actual_failed
        freed = actual_freed
    try:
        staging_root.rmdir()
        staging_root.parent.rmdir()
    except Exception:
        pass
    print(json.dumps({'ok': not failed, 'cleanup_id': cid, 'dry_run': args.dry_run, 'deleted_paths': deleted, 'failed_paths': failed, 'freed_bytes': freed, 'policy': policy, 'pruned_db_blobs': pruned_db_blobs}, ensure_ascii=False, indent=2, sort_keys=True))
    return 1 if failed else 0

