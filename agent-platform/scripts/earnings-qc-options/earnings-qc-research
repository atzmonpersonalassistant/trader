def refresh_summary_after_historical(run_dir: pathlib.Path, mb: dict | None) -> dict:
    fs = run_dir / 'full_summary.json'
    summary = json.loads(fs.read_text()) if fs.exists() else {'ok': False, 'status': 'NO_FULL_SUMMARY'}
    if not mb:
        return summary
    summary['multiyear_backtest'] = mb
    summary['historical_gate_ran'] = True
    summary['aggregate_funnel'] = dict(summary.get('aggregate_funnel') or {})
    summary['aggregate_funnel']['07_multi_year_backtest_status'] = mb.get('status')
    ok_syms = {r.get('symbol') for r in mb.get('results', []) if mb.get('ok') and multiyear_result_passes(r)}
    src = summary.get('forward_candidates') or summary.get('candidates') or []
    summary['final_candidates'] = [c for c in src if c.get('symbol') in ok_syms]
    summary['candidates'] = summary['final_candidates']
    summary['candidate_count'] = len(summary['final_candidates'])
    summary['final_candidate_count'] = len(summary['final_candidates'])
    # A historical refresh with no forward candidates is a terminal no-op, not an
    # infrastructure failure to retry/debug. Classify infra failures only when
    # there was actually something to validate.
    infra_failed = bool(src) and bool(mb.get('ok') is False and multiyear_infrastructure_failed(mb.get('status')))
    historical_failed = list(summary.get('historical_failed_chunks') or [])
    scanner_failed = []
    for x in (summary.get('failed_chunks') or []):
        text = (str(x.get('status')) + ' ' + str(x.get('blocked_reason'))).upper()
        if any(marker in text for marker in ['MULTIYEAR', 'HISTORICAL', 'OPTION-PNL', 'OPTION_PNL']):
            historical_failed.append(x)
        else:
            scanner_failed.append(x)
    for x in historical_failed:
        if x.get('ok') is False:
            x.setdefault('blocked_reason', 'mandatory multiyear option-PnL backtest failed')
    summary['failed_chunks'] = scanner_failed
    summary['failed_chunk_count'] = len(scanner_failed)
    summary['historical_failed_chunks'] = historical_failed
    summary['historical_failed_chunk_count'] = len(historical_failed)
    base_scan_ok = not scanner_failed and int(summary.get('qc_symbols_scanned') or 0) >= int(summary.get('calendar_row_count') or summary.get('calendar_universe_count') or 0)
    no_pass = bool(src) and bool(base_scan_ok) and not summary['final_candidates'] and multiyear_no_passing_symbols(mb.get('status'))
    summary['historical_gate_no_pass'] = no_pass
    summary['historical_gate_blocked'] = bool(src) and not summary['final_candidates'] and infra_failed
    summary['multiyear_failed'] = infra_failed
    summary['ok'] = bool(base_scan_ok) and bool(mb.get('ok')) and bool(summary['final_candidates'])
    if summary['ok']:
        summary['status'] = 'OK_FULL_QC_SCAN'
    elif no_pass:
        summary['status'] = 'NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL'
    elif infra_failed:
        summary['status'] = 'BLOCKED_MULTIYEAR_OPTION_PNL_BACKTEST'
    elif bool(src) and not summary['final_candidates']:
        summary['status'] = 'BLOCKED_HISTORICAL_OPTION_PNL_GATE'
    elif not src:
        summary['status'] = 'NO_FORWARD_CANDIDATES'
    if fs.exists():
        fs.write_text(json.dumps(summary, ensure_ascii=False, indent=2, sort_keys=True) + '\n')
    return summary


