def build_parser():
    p = argparse.ArgumentParser(description='Deterministic earnings QC full-scan runner')
    sub = p.add_subparsers(dest='cmd')
    def common(sp):
        sp.add_argument('--run-dir')
        sp.add_argument('--run-id')
        sp.add_argument('--campaign', default=DEFAULT_CAMPAIGN)
        sp.add_argument('--chunk-size', type=int, default=int(os.environ.get('QC_FULL_CHUNK_SIZE','25')))
    r=sub.add_parser('run'); common(r); r.add_argument('--symbols', help='Comma-separated ticker symbols to scan from the Nasdaq calendar snapshot/window'); r.add_argument('--max-chunks', type=int); r.add_argument('--start-offset', type=int, default=0); r.add_argument('--from-stage'); r.add_argument('--to-stage'); r.add_argument('--resume', action='store_true'); r.add_argument('--no-outbox', action='store_true'); r.add_argument('--parallel', type=int, default=int(os.environ.get('QC_FULL_PARALLEL','1'))); r.add_argument('--end-to-end', dest='end_to_end', action='store_true', default=os.environ.get('QC_FULL_END_TO_END','1') not in ('0','false','False')); r.add_argument('--no-end-to-end', dest='end_to_end', action='store_false'); r.add_argument('--years', type=int, default=int(os.environ.get('QC_SCAN_YEARS', os.environ.get('QC_MULTIYEAR_YEARS','1'))), help='Scan/discovery horizon; historical validation uses --validation-years'); r.add_argument('--validation-years', type=int, default=int(os.environ.get('QC_VALIDATION_YEARS','10')), help='Historical option-PnL validation horizon; defaults to 10')
    add_stage_parameter_args(r)
    s=sub.add_parser('status'); common(s); s.add_argument('--pretty', action='store_true')
    h=sub.add_parser('history'); h.add_argument('--campaign', default=DEFAULT_CAMPAIGN); h.add_argument('--last', type=int, default=10); h.add_argument('--pretty', action='store_true')
    ins=sub.add_parser('insights'); ins.add_argument('--campaign', default=DEFAULT_CAMPAIGN); ins.add_argument('--last', type=int, default=20); ins.add_argument('--pretty', action='store_true')
    hist=sub.add_parser('historical'); common(hist); hist.add_argument('--years', type=int, required=True); hist.add_argument('--end-to-end', dest='end_to_end', action='store_true', default=True); hist.add_argument('--no-end-to-end', dest='end_to_end', action='store_false')
    add_qc_parameter_args(hist, default_stage_values=False)
    add_historical_parameter_args(hist)
    dec=sub.add_parser('decision'); dec_sub=dec.add_subparsers(dest='decision_cmd'); da=dec_sub.add_parser('add'); da.add_argument('--campaign', default=DEFAULT_CAMPAIGN); da.add_argument('--previous-run-id'); da.add_argument('--next-run-id'); da.add_argument('--actor', default='llm'); da.add_argument('--type', dest='decision_type', required=True); da.add_argument('--rationale', required=True); da.add_argument('--parameter-changes-json', default='{}')
    cl=sub.add_parser('cleanup'); cl.add_argument('--older-than-days', type=int, default=14); cl.add_argument('--keep-last', type=int, default=20); cl.add_argument('--dry-run', action='store_true')
    sm=sub.add_parser('summarize'); common(sm); sm.add_argument('--notify', action='store_true')
    rf=sub.add_parser('retry-failed'); common(rf); rf.add_argument('--offset', type=int); rf.add_argument('--notify', action='store_true'); rf.add_argument('--end-to-end', dest='end_to_end', action='store_true', default=os.environ.get('QC_FULL_END_TO_END','1') not in ('0','false','False')); rf.add_argument('--no-end-to-end', dest='end_to_end', action='store_false'); rf.add_argument('--years', type=int, default=int(os.environ.get('QC_SCAN_YEARS', os.environ.get('QC_MULTIYEAR_YEARS','1')))); rf.add_argument('--validation-years', type=int, default=int(os.environ.get('QC_VALIDATION_YEARS','10')))
    add_qc_parameter_args(rf, default_stage_values=False)
    add_historical_parameter_args(rf)
    return p


def main(argv):
    # Backward compatible: old cron called script with flags only; treat as run.
    if not argv or argv[0].startswith('--'):
        argv = ['run'] + argv
    args = build_parser().parse_args(argv)
    validate_historical_runtime_params(args)
    if args.cmd == 'run': return cmd_run(args)
    if args.cmd == 'status': return cmd_status(args)
    if args.cmd == 'summarize': return cmd_summarize(args)
    if args.cmd == 'retry-failed': return cmd_retry_failed(args)
    if args.cmd == 'history': return cmd_history(args)
    if args.cmd == 'insights': return cmd_insights(args)
    if args.cmd == 'historical': return cmd_historical(args)
    if args.cmd == 'decision' and getattr(args, 'decision_cmd', None) == 'add': return cmd_decision_add(args)
    if args.cmd == 'cleanup': return cmd_cleanup(args)
    raise SystemExit('missing command')

if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
