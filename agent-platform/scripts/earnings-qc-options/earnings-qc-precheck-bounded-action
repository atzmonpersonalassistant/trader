#!/usr/bin/env python3
import json
import pathlib
import sys


def write_result(path, status, returncode, argv, reason):
    path.write_text(
        json.dumps(
            {
                "argv": argv,
                "reason": reason,
                "returncode": returncode,
                "status": status,
            },
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )
    print(status)


def main():
    if len(sys.argv) < 3:
        raise SystemExit("usage: earnings-qc-precheck-bounded-action SUMMARY_JSON RESULT_JSON [ARGV...]")

    summary_path = pathlib.Path(sys.argv[1])
    result_path = pathlib.Path(sys.argv[2])
    argv = sys.argv[3:]

    if argv[:1] != ["retry-failed"]:
        print("OK")
        return 0

    try:
        summary = json.loads(summary_path.read_text(encoding="utf-8"))
    except Exception as exc:
        write_result(
            result_path,
            "REFUSED_RETRY_FAILED_PRECONDITION_UNREADABLE",
            65,
            argv,
            f"could not read full_summary.json: {exc}",
        )
        return 1

    failed_chunk_count = summary.get("failed_chunk_count")
    if not isinstance(failed_chunk_count, int):
        failed_chunks = summary.get("failed_chunks")
        failed_chunk_count = len(failed_chunks) if isinstance(failed_chunks, list) else 0

    if failed_chunk_count <= 0:
        write_result(
            result_path,
            "REFUSED_RETRY_FAILED_NO_FAILED_CHUNKS",
            65,
            argv,
            "retry-failed requested but full_summary.json has failed_chunk_count=0",
        )
        return 1

    print("OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
