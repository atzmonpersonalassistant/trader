#!/usr/bin/env bash
set -euo pipefail

export TZ=Asia/Jerusalem
if [[ -n "${EARNINGS_POSTRUN_PATH_PREFIX:-}" ]]; then
  export PATH="${EARNINGS_POSTRUN_PATH_PREFIX}:/agents/research/bin:/usr/local/bin:/usr/bin:/bin"
else
  export PATH=/agents/research/bin:/usr/local/bin:/usr/bin:/bin
fi
export PYTHONDONTWRITEBYTECODE=1

MODEL="gpt-5.4-mini"
DATE="$(date +%F)"
DRY_RUN=0

usage() {
  cat >&2 <<'USAGE'
usage: earnings-llm-postrun-review [--date YYYY-MM-DD] [--model MODEL] [--dry-run]

No-op unless today's deterministic earnings-qc-research run has finished.
No-op if another earnings LLM postrun review is currently running.
Otherwise, run one trader-research-system bounded postrun review via the
approved isolated Codex research runner.

This script does not schedule itself and does not send push notifications.
USAGE
}

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])'
}

make_runner_inputs_usable() {
  local task_file="$1"
  local output_dir="$2"
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -m "u:agent-research-runner:--x" /agents /agents/research "$REPORT_ROOT" 2>/dev/null || true
    setfacl -m "u:agent-research:rwx,u:agent-research-runner:rwx,m::rwx,d:u:agent-research:rwx,d:u:agent-research-runner:rwx,d:m::rwx" "$output_dir"
    setfacl -m "u:agent-research-runner:r--" "$task_file"
    chmod u+rw,o-rwx "$task_file"
  else
    chgrp agent-research-runner "$output_dir"
    chmod 2770 "$output_dir"
    chgrp agent-research-runner "$task_file"
    chmod 0640 "$task_file"
  fi
}

write_no_finished_run_handoff_task() {
  local condition="NO_FINISHED_DAILY_RUN"
  local marker_dir ts task_file tmp_task_file
  marker_dir="$STATE_DIR/failure-handoffs/${DATE_COMPACT}-${condition}"
  mkdir -p "$STATE_DIR/failure-handoffs"
  tmp_task_file="$(mktemp "$HANDOFF_DIR/.research-pass-postrun-${DATE_COMPACT}-${condition}.XXXXXX")"
  ts="$(date -u +%Y%m%d-%H%M%S)"
  task_file="$HANDOFF_DIR/research-pass-postrun-${DATE_COMPACT}-${ts}-$$-${condition}-task.txt"
  cat > "$tmp_task_file" <<TASK
Earnings postrun review could not find a finished deterministic daily run.

condition: $condition
date: $DATE
scheduled_at: ${DAILY_RUN_SCHEDULED_AT:-unknown}
grace_seconds: ${MISSING_RUN_GRACE_SECONDS:-unknown}
threshold_seconds: ${STALE_RUNNING_SECONDS:-unknown}

This is a durable handoff artifact for the LLM/operator loop. Keep the existing
script no-op signal; investigate whether the daily run was skipped, is still
running, or finished without a DB row that matches the postrun selector.
TASK
  chmod 0640 "$tmp_task_file"
  if ! mkdir "$marker_dir" 2>/dev/null; then
    rm -f "$tmp_task_file"
    echo "HANDOFF_TASK_ALREADY_WRITTEN condition=$condition marker=$marker_dir"
    return
  fi
  if ! mv "$tmp_task_file" "$task_file"; then
    rmdir "$marker_dir" 2>/dev/null || true
    rm -f "$tmp_task_file"
    echo "ERROR: failed to persist handoff task condition=$condition task=$task_file" >&2
    return 73
  fi
  printf '%s\n' "$task_file" > "$marker_dir/task_file.txt"
  printf '%s\n' "$(date -Is)" > "$marker_dir/written_at.txt"
  echo "HANDOFF_TASK_WRITTEN condition=$condition task=$task_file"
}


while [[ $# -gt 0 ]]; do
  case "$1" in
    --date) DATE="${2:?missing --date value}"; shift 2 ;;
    --model) MODEL="${2:?missing --model value}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage; exit 64 ;;
  esac
done

if [[ ! "$DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "ERROR: --date must be YYYY-MM-DD" >&2
  exit 64
fi
case "$MODEL" in
  *[!A-Za-z0-9._/-]*|"") echo "ERROR: unsafe model name" >&2; exit 64 ;;
esac

DATE_COMPACT="${DATE//-/}"
STATE_DIR="${EARNINGS_POSTRUN_STATE_DIR:-/agents/research/state/earnings-qc-research/llm-postrun-review}"
HANDOFF_DIR="${EARNINGS_POSTRUN_HANDOFF_DIR:-/agents/research/handoff}"
REPORT_ROOT="${EARNINGS_POSTRUN_REPORT_ROOT:-/agents/research/reports}"
SKILL_FILE="${EARNINGS_POSTRUN_SKILL_FILE:-/agents/research/skills/trader-research-system/SKILL.md}"
DAILY_RUN_SCHEDULED_AT="${EARNINGS_POSTRUN_DAILY_RUN_SCHEDULED_AT:-10:30}"
MISSING_RUN_GRACE_SECONDS="${EARNINGS_POSTRUN_MISSING_RUN_GRACE_SECONDS:-10800}"
STALE_RUNNING_SECONDS="${EARNINGS_POSTRUN_STALE_RUNNING_SECONDS:-10800}"
LOCK="${STATE_DIR}/earnings-llm-postrun-review.lock"
mkdir -p "$STATE_DIR" "$HANDOFF_DIR" "$REPORT_ROOT"

# User-requested behavior: if a postrun review is already running, do nothing.
exec 9>"$LOCK"
if ! flock -n 9; then
  echo "POSTRUN_REVIEW_ALREADY_RUNNING"
  exit 0
fi

# Source of truth: DB row with finished_at. Prefer the canonical daily campaign.
# Legacy/manual runs before this fix may have used the old default campaign, so
# fall back by deterministic daily run_id + conservative daily parameters only.
cd /tmp && psql -d trader_research -qAt -v ON_ERROR_STOP=1 -c "ALTER TABLE earnings_cache.research_runs ADD COLUMN IF NOT EXISTS research_verdict TEXT;" >/dev/null
ROW="$(cd /tmp && psql -d trader_research -qAt -F $'\t' -v ON_ERROR_STOP=1 -c "
SELECT run_id, status, COALESCE(research_verdict, summary_json->>'status', ''), COALESCE(finished_at::text,''), run_dir, COALESCE(final_candidate_count,0)::text, COALESCE(bottleneck,''), COALESCE(error,'')
FROM earnings_cache.research_runs
WHERE campaign_id = 'daily-earnings-otm'
  AND run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
  AND finished_at IS NOT NULL
  AND parameters_json->>'from_stage' = 'calendar'
  AND parameters_json->>'to_stage' = 'historical_option_pnl'
  AND COALESCE((parameters_json->>'years')::int, 1) = 1
  AND COALESCE((parameters_json->>'parallel')::int, 1) = 1
  AND COALESCE((parameters_json->>'end_to_end')::boolean, true) = true
  AND COALESCE((parameters_json->>'chunk_size')::int, 25) = 25
  AND COALESCE(parameters_json->>'symbols','') = ''
  AND parameters_json->>'no_outbox' = 'false'
  AND COALESCE(parameters_json->>'calendar_source','nasdaq') = 'nasdaq'
ORDER BY finished_at DESC
LIMIT 1;
")"

if [[ -z "$ROW" ]]; then
  ROW="$(cd /tmp && psql -d trader_research -qAt -F $'\t' -v ON_ERROR_STOP=1 -c "
  SELECT run_id, status, COALESCE(research_verdict, summary_json->>'status', ''), COALESCE(finished_at::text,''), run_dir, COALESCE(final_candidate_count,0)::text, COALESCE(bottleneck,''), COALESCE(error,'')
  FROM earnings_cache.research_runs
  WHERE run_id LIKE 'earnings-qc-options-scan-full-${DATE_COMPACT}-%'
    AND finished_at IS NOT NULL
    AND parameters_json->>'from_stage' = 'calendar'
    AND parameters_json->>'to_stage' = 'historical_option_pnl'
    AND COALESCE((parameters_json->>'years')::int, 1) = 1
    AND COALESCE((parameters_json->>'parallel')::int, 1) = 1
    AND COALESCE((parameters_json->>'end_to_end')::boolean, true) = true
    AND COALESCE((parameters_json->>'chunk_size')::int, 25) = 25
    AND COALESCE(parameters_json->>'symbols','') = ''
    AND parameters_json->>'no_outbox' = 'false'
    AND COALESCE(parameters_json->>'calendar_source','nasdaq') = 'nasdaq'
  ORDER BY finished_at DESC
  LIMIT 1;
  ")"
  if [[ -n "$ROW" ]]; then
    echo "USING_LEGACY_DAILY_RUN_FALLBACK date=$DATE"
  fi
fi

if [[ -z "$ROW" ]]; then
  write_no_finished_run_handoff_task
  echo "NO_FINISHED_DAILY_RUN date=$DATE"
  exit 0
fi

IFS=$'\t' read -r RUN_ID RUN_STATUS RESEARCH_VERDICT FINISHED_AT RUN_DIR FINAL_COUNT BOTTLENECK RUN_ERROR <<< "$ROW"
if [[ -z "${RUN_ID:-}" || -z "${RUN_DIR:-}" ]]; then
  echo "ERROR: malformed DB row for date=$DATE: $ROW" >&2
  exit 70
fi
if [[ ! -d "$RUN_DIR" || ! -f "$RUN_DIR/full_summary.json" ]]; then
  echo "ERROR: finished DB row exists but run artifacts are missing: run_id=$RUN_ID run_dir=$RUN_DIR" >&2
  exit 66
fi

SAFE_RUN_MARKER="$(printf '%s' "$RUN_ID" | tr -c 'A-Za-z0-9._-' '-')"
COMPLETED_MARKER_DIR="$STATE_DIR/completed-runs/$SAFE_RUN_MARKER"
if [[ -d "$COMPLETED_MARKER_DIR" ]]; then
  echo "POSTRUN_ALREADY_REVIEWED run_id=$RUN_ID marker=$COMPLETED_MARKER_DIR"
  exit 0
fi

TS="$(date -u +%Y%m%d-%H%M%S)"
SAFE_RUN_ID="$SAFE_RUN_MARKER"
TASK_FILE="$HANDOFF_DIR/research-pass-postrun-${DATE_COMPACT}-${TS}-task.txt"
OUTPUT_DIR="$REPORT_ROOT/research-pass-postrun-${DATE_COMPACT}-${TS}-${SAFE_RUN_ID}"
BOUNDED_ACTION_ID="postrun-${DATE_COMPACT}-${TS}-${SAFE_RUN_ID}"
ACTION_DIR="$STATE_DIR/actions"
ACTION_FILE="$ACTION_DIR/$BOUNDED_ACTION_ID"
HOST_ACTION_DIR="$STATE_DIR/host-action/$BOUNDED_ACTION_ID"

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "WOULD_RUN run_id=$RUN_ID task=$TASK_FILE output=$OUTPUT_DIR model=$MODEL"
  exit 0
fi

mkdir -p "$OUTPUT_DIR" "$ACTION_DIR" "$HOST_ACTION_DIR"
chmod 750 "$OUTPUT_DIR"
chmod 750 "$ACTION_DIR"
chmod 700 "$HOST_ACTION_DIR"

cat > "$TASK_FILE" <<'TASK'
You are running the full trader-research-system skill for Uriel's VPS earnings-options research system.

Full skill content deployed on the VPS from GitHub at: __SKILL_FILE__

<TRADER_RESEARCH_SYSTEM_SKILL>
__SKILL_CONTENT__
</TRADER_RESEARCH_SYSTEM_SKILL>

Context:
- Deterministic daily scan has finished.
- run_id: __RUN_ID__
- status: __RUN_STATUS__
- research_verdict: __RESEARCH_VERDICT__
- finished_at: __FINISHED_AT__
- run_dir: __RUN_DIR__
- final_candidate_count: __FINAL_COUNT__
- bottleneck: __BOTTLENECK__
- error: __RUN_ERROR__

Apply the full trader-research-system skill above. This invocation is allowed to request exactly one bounded follow-up action when the skill calls for it. Do not execute sudo or the wrapper yourself: Codex runs inside a no-new-privileges sandbox, so sudo will fail by design.

If exactly one bounded follow-up action is justified, write this file and then exit normally:
__OUTPUT_DIR__/bounded_action_request.json

The file must be JSON with this shape only:
{"argv":["retry-failed","--offset","650","--years","1","--end-to-end"]}

Use only arguments that the bounded wrapper accepts. The postrun host process will execute the request outside the Codex sandbox through:
/usr/local/sbin/trading-research-bounded-earnings-qc --bounded-action-dir __ACTION_DIR__ --bounded-action-id __BOUNDED_ACTION_ID__ <argv...>

The wrapper remains the execution guardrail. If an action is unsafe or not justified, do not write bounded_action_request.json and record NO_ACTION.

Short reminders:
- You are a skeptical research agent, not an autonomous trader.
- Output is evidence, not trades. Default stance is NO TRADE until multi-year historical evidence says otherwise.
- This invocation is one bounded iteration only: read state -> classify -> pick ONE action if justified -> execute -> record -> exit.
- Never loop, never schedule yourself, never chain a second expensive action.
- Allowed outcomes: Final candidate, Candidate worth manual review, Meaningful blocker, Parameter experiment result, No-trade conclusion.
- Hard guardrails: no live trading, no broker orders, no final candidate without QC/EODHD multi-year historical option-PnL evidence, no bypassing/loosening gates to force a candidate, no broad/expensive universe runs without staged gates, no 0DTE/1DTE, no naked options, no fabricated/interpolated data, no Yahoo/yfinance unless explicitly approved.
- Nasdaq calendar is only stage-1 forward earnings discovery; evidence after discovery must come from QC/LEAN or QC/EODHD.
- This postrun invocation may request exactly one bounded follow-up action by writing `__OUTPUT_DIR__/bounded_action_request.json` when justified by the skill. The host postrun script will execute the request through `/usr/local/sbin/trading-research-bounded-earnings-qc --bounded-action-dir __ACTION_DIR__ --bounded-action-id __BOUNDED_ACTION_ID__`. The action id is one-use; a second mutating call will fail and must not be worked around.
- Do not invoke sudo, `/usr/local/sbin/trading-research-bounded-earnings-qc`, or `/agents/research/bin/earnings-qc-research` directly from Codex; request the bounded action via JSON only.
- Do not re-spend QC/QCC on duplicate work. Read prior artifacts first; if the wrapper refuses a broad or unsafe action, stop and record the blocker.
- Reporting threshold: final candidate, manual-review candidate, meaningful new bottleneck, system failure, major parameter change, or QC/QCC budget risk. Routine no-candidate/no-change should be logged, not pushed.

Task:
1. Read __RUN_DIR__/full_summary.json and relevant small artifacts in __RUN_DIR__.
2. Classify the finished run according to the skill.
3. If the skill justifies one allowed next action, write exactly one bounded_action_request.json; otherwise record why no action was justified.
4. Write a durable review artifact to this output directory:
   __OUTPUT_DIR__/review.md
   and, if useful, __OUTPUT_DIR__/review.json
5. Also write __OUTPUT_DIR__/notify.txt containing either:
   - NO_NOTIFY
   - or a concise Hebrew WhatsApp-style message that meets the reporting threshold.
6. Do not send any message yourself. Do not create cron jobs. Do not modify the daily cron.
7. Record the exact bounded-wrapper command you ran, or `NO_ACTION`, in the artifact.
TASK
python3 - "$TASK_FILE" "$SKILL_FILE" "$RUN_ID" "$RUN_STATUS" "$RESEARCH_VERDICT" "$FINISHED_AT" "$RUN_DIR" "$FINAL_COUNT" "$BOTTLENECK" "$RUN_ERROR" "$ACTION_DIR" "$BOUNDED_ACTION_ID" "$OUTPUT_DIR" <<'PY'
import pathlib, sys
(task_file, skill_file, run_id, run_status, research_verdict, finished_at, run_dir, final_count, bottleneck, run_error, action_dir, bounded_action_id, output_dir) = sys.argv[1:]
text = pathlib.Path(task_file).read_text()
skill = pathlib.Path(skill_file).read_text()
replacements = {
    '__SKILL_FILE__': skill_file,
    '__SKILL_CONTENT__': skill,
    '__RUN_ID__': run_id,
    '__RUN_STATUS__': run_status,
    '__RESEARCH_VERDICT__': research_verdict,
    '__FINISHED_AT__': finished_at,
    '__RUN_DIR__': run_dir,
    '__FINAL_COUNT__': final_count,
    '__BOTTLENECK__': bottleneck,
    '__RUN_ERROR__': run_error,
    '__ACTION_DIR__': action_dir,
    '__BOUNDED_ACTION_ID__': bounded_action_id,
    '__OUTPUT_DIR__': output_dir,
}
for old, new in replacements.items():
    text = text.replace(old, new)
pathlib.Path(task_file).write_text(text)
PY
chmod 0640 "$TASK_FILE"
make_runner_inputs_usable "$TASK_FILE" "$OUTPUT_DIR"

STARTED_AT="$(date -Is)"
ISSUED_AT="$(date +%s)"
{
  printf 'issued_at=%s
' "$ISSUED_AT"
  printf 'output_dir=%s
' "$OUTPUT_DIR"
  printf 'runner_pid=pending
'
} > "$ACTION_FILE"
chmod 0640 "$ACTION_FILE"
set +e
sudo -n -u agent-research-runner /usr/local/bin/trading-research-runner-codex "$TASK_FILE" "$OUTPUT_DIR" "$MODEL" \
  > "$OUTPUT_DIR/runner.stdout.log" 2> "$OUTPUT_DIR/runner.stderr.log" &
RUNNER_PID=$!
{
  printf 'issued_at=%s
' "$ISSUED_AT"
  printf 'output_dir=%s
' "$OUTPUT_DIR"
  printf 'runner_pid=%s
' "$RUNNER_PID"
} > "$ACTION_FILE"
chmod 0640 "$ACTION_FILE"
wait "$RUNNER_PID"
RC=$?
set -e

BOUNDED_ACTION_RC=0
BOUNDED_ACTION_STATUS="NO_REQUEST"
REQUEST_FILE="$OUTPUT_DIR/bounded_action_request.json"
if [[ "$RC" -eq 0 && -e "$REQUEST_FILE" ]]; then
  BOUNDED_ACTION_STATUS="REQUESTED"
  [[ ! -L "$REQUEST_FILE" ]] || { BOUNDED_ACTION_STATUS="INVALID_REQUEST"; BOUNDED_ACTION_RC=64; }
  BOUNDED_ACTION_ARGV_NUL="$HOST_ACTION_DIR/request.argv0"
  if [[ "$BOUNDED_ACTION_STATUS" != "INVALID_REQUEST" ]]; then
    if ! python3 - "$REQUEST_FILE" "$BOUNDED_ACTION_ARGV_NUL" <<'PY'
import json, pathlib, sys
request_path = pathlib.Path(sys.argv[1])
out_path = pathlib.Path(sys.argv[2])
try:
    data = json.loads(request_path.read_text(encoding='utf-8'))
except Exception as exc:
    raise SystemExit(f'invalid bounded_action_request.json: {exc}')
argv = data.get('argv')
if set(data.keys()) != {'argv'}:
    raise SystemExit('bounded_action_request.json may contain only argv')
if not isinstance(argv, list) or not argv or len(argv) > 24:
    raise SystemExit('bounded_action_request.json must contain non-empty argv list with <=24 strings')
encoded = []
for arg in argv:
    if not isinstance(arg, str) or not arg or len(arg) > 500:
        raise SystemExit('bounded action argv entries must be non-empty short strings')
    if any(ch in arg for ch in '\n\r\t\0'):
        raise SystemExit('bounded action argv contains control whitespace')
    encoded.append(arg.encode('utf-8'))
tmp = out_path.with_name(out_path.name + '.tmp')
if out_path.exists() or out_path.is_symlink() or tmp.exists() or tmp.is_symlink():
    raise SystemExit('host argv output path already exists')
fd = None
try:
    import os
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as fh:
        fd = None
        fh.write(b'\0'.join(encoded) + b'\0')
    os.replace(tmp, out_path)
finally:
    if fd is not None:
        os.close(fd)
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
PY
    then
      BOUNDED_ACTION_STATUS="INVALID_REQUEST"
      BOUNDED_ACTION_RC=64
    else
      mapfile -d '' BOUNDED_ACTION_ARGS < "$BOUNDED_ACTION_ARGV_NUL"
    fi
  fi
  if [[ "$BOUNDED_ACTION_STATUS" != "INVALID_REQUEST" ]]; then
  {
    printf 'issued_at=%s
' "$ISSUED_AT"
    printf 'output_dir=%s
' "$OUTPUT_DIR"
    printf 'runner_pid=host-postrun
'
  } > "$ACTION_FILE"
  chmod 0640 "$ACTION_FILE"
  set +e
  BOUNDED_STDOUT="$HOST_ACTION_DIR/bounded-action.stdout.log"
  BOUNDED_STDERR="$HOST_ACTION_DIR/bounded-action.stderr.log"
  (cd "$OUTPUT_DIR" && /usr/local/sbin/trading-research-bounded-earnings-qc --bounded-action-dir "$ACTION_DIR" --bounded-action-id "$BOUNDED_ACTION_ID" "${BOUNDED_ACTION_ARGS[@]}") \
    > "$BOUNDED_STDOUT" 2> "$BOUNDED_STDERR"
  BOUNDED_ACTION_RC=$?
  set -e
  if [[ "$BOUNDED_ACTION_RC" -eq 0 ]]; then
    BOUNDED_ACTION_STATUS="EXECUTED"
# earnings-qc-research returns rc=2 for completed research no-trade/blocker
# outcomes as well as for invalid requests. Treat only known research blocker
# payloads as executed; wrapper/request errors still remain FAILED.
  elif [[ "$BOUNDED_ACTION_RC" -eq 2 ]] && /agents/research/libexec/earnings-qc-options/earnings-qc-classify-bounded-action "$BOUNDED_STDOUT"
  then
    BOUNDED_ACTION_STATUS="EXECUTED_RESEARCH_BLOCKED"
  else
    BOUNDED_ACTION_STATUS="FAILED"
  fi
    python3 - "$HOST_ACTION_DIR/bounded_action_result.json" "$BOUNDED_ACTION_STATUS" "$BOUNDED_ACTION_RC" "${BOUNDED_ACTION_ARGS[@]}" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
path.write_text(json.dumps({
    'status': sys.argv[2],
    'returncode': int(sys.argv[3]),
    'argv': sys.argv[4:],
}, ensure_ascii=False, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
  fi
  COPY_BACK_RC=0
  python3 - "$HOST_ACTION_DIR" "$OUTPUT_DIR" <<'PY' || COPY_BACK_RC=$?
import os, pathlib, shutil, sys
src = pathlib.Path(sys.argv[1]).resolve()
dst = pathlib.Path(sys.argv[2]).resolve()
conflicts = []
for name in ('bounded-action.stdout.log', 'bounded-action.stderr.log', 'bounded_action_result.json'):
    sp = src / name
    if not sp.exists():
        continue
    if sp.is_symlink():
        conflicts.append(f'host action artifact is symlink: {sp}')
        continue
    dp = dst / name
    if dp.exists() or dp.is_symlink():
        conflicts.append(f'runner-controlled artifact path already exists: {dp}')
        continue
    with sp.open('rb') as rf:
        fd = os.open(dp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        with os.fdopen(fd, 'wb') as wf:
            shutil.copyfileobj(rf, wf)
if conflicts:
    marker = dst / 'bounded_action_copy_conflicts.txt'
    if not marker.exists() and not marker.is_symlink():
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
        with os.fdopen(fd, 'w', encoding='utf-8') as fh:
            fh.write('\n'.join(conflicts) + '\n')
    raise SystemExit(73)
PY
  if [[ "$COPY_BACK_RC" -ne 0 ]]; then
    echo "BOUNDED_ACTION_COPY_BACK_CONFLICT rc=$COPY_BACK_RC output=$OUTPUT_DIR host_action_dir=$HOST_ACTION_DIR" >&2
  fi
fi

if [[ ! -d "$ACTION_FILE.used" && ! -d "$ACTION_FILE.expired" ]]; then
  mkdir "$ACTION_FILE.expired" 2>/dev/null || true
  date -Is > "$ACTION_FILE.expired/expired_at.txt" 2>/dev/null || true
fi
FINISHED_REVIEW_AT="$(date -Is)"

RUN_ID_JSON="$(printf '%s' "$RUN_ID" | json_escape)"
RUN_STATUS_JSON="$(printf '%s' "$RUN_STATUS" | json_escape)"
RESEARCH_VERDICT_JSON="$(printf '%s' "$RESEARCH_VERDICT" | json_escape)"
FINISHED_AT_JSON="$(printf '%s' "$FINISHED_AT" | json_escape)"
RUN_DIR_JSON="$(printf '%s' "$RUN_DIR" | json_escape)"
cat > "$OUTPUT_DIR/run_metadata.json" <<META
{
  "run_id": "$RUN_ID_JSON",
  "daily_run_status": "$RUN_STATUS_JSON",
  "research_verdict": "$RESEARCH_VERDICT_JSON",
  "daily_finished_at": "$FINISHED_AT_JSON",
  "run_dir": "$RUN_DIR_JSON",
  "review_started_at": "$STARTED_AT",
  "review_finished_at": "$FINISHED_REVIEW_AT",
  "model": "$MODEL",
  "returncode": $RC,
  "bounded_action_id": "$BOUNDED_ACTION_ID",
  "task_file": "$TASK_FILE",
  "host_action_dir": "$HOST_ACTION_DIR",
  "runner": "trading-research-runner-codex",
  "output_dir": "$OUTPUT_DIR",
  "bounded_action_status": "$BOUNDED_ACTION_STATUS",
  "bounded_action_returncode": $BOUNDED_ACTION_RC,
  "bounded_action_copy_back_returncode": ${COPY_BACK_RC:-0}
}
META

if [[ "$RC" -eq 0 && ( "$BOUNDED_ACTION_STATUS" == "NO_REQUEST" || "$BOUNDED_ACTION_STATUS" == "EXECUTED" || "$BOUNDED_ACTION_STATUS" == "EXECUTED_RESEARCH_BLOCKED" ) ]]; then
  mkdir -p "$STATE_DIR/completed-runs"
  if mkdir "$COMPLETED_MARKER_DIR" 2>/dev/null; then
    printf '%s
' "$RUN_ID" > "$COMPLETED_MARKER_DIR/run_id.txt"
    printf '%s
' "$OUTPUT_DIR" > "$COMPLETED_MARKER_DIR/output_dir.txt"
    printf '%s
' "$FINISHED_REVIEW_AT" > "$COMPLETED_MARKER_DIR/review_finished_at.txt"
    printf '%s
' "$BOUNDED_ACTION_STATUS" > "$COMPLETED_MARKER_DIR/bounded_action_status.txt"
  fi
  echo "REVIEW_COMPLETED run_id=$RUN_ID output=$OUTPUT_DIR"
elif [[ "$RC" -eq 0 ]]; then
  echo "REVIEW_FAILED run_id=$RUN_ID bounded_action_status=$BOUNDED_ACTION_STATUS bounded_action_rc=$BOUNDED_ACTION_RC output=$OUTPUT_DIR" >&2
  exit "${BOUNDED_ACTION_RC:-70}"
else
  echo "REVIEW_FAILED run_id=$RUN_ID rc=$RC output=$OUTPUT_DIR" >&2
  exit "$RC"
fi
