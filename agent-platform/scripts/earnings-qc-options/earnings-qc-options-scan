def write_outbox(message: str, payload: dict) -> bool:
    if not ORCH_DB.exists():
        return False
    ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
    ext = f"earnings-qc-options-scan-{payload.get('run_date')}-{payload.get('status')}"
    con = sqlite3.connect(str(ORCH_DB))
    con.execute("""INSERT OR IGNORE INTO outbox(external_id,state,labels,channel,message,payload_json,created_at,updated_at,last_seen_at,retry_count)
VALUES (?, 'pending', ?, 'whatsapp', ?, ?, ?, ?, ?, 0)""", (
        ext,
        json.dumps(['earnings_qc_options_scan','notification' if payload.get('candidate_count') else 'blocker']),
        message,
        json.dumps(payload, ensure_ascii=False, sort_keys=True),
        ts, ts, ts,
    ))
    con.commit(); con.close(); return True


def fetch_nasdaq_earnings_for_date(day: datetime.date) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache_path = CACHE_DIR / f'{day.isoformat()}.json'
    url = 'https://api.nasdaq.com/api/calendar/earnings?' + urllib.parse.urlencode({'date': day.isoformat()})
    headers = {
        'User-Agent': 'Mozilla/5.0',
        'Accept': 'application/json, text/plain, */*',
        'Origin': 'https://www.nasdaq.com',
        'Referer': 'https://www.nasdaq.com/market-activity/earnings',
    }
    meta = {'date': day.isoformat(), 'url': url, 'cache_path': str(cache_path), 'from_cache': False}
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=25) as r:
            body = r.read().decode('utf-8', 'replace')
            meta['http_status'] = getattr(r, 'status', None)
            meta['content_type'] = r.headers.get('content-type')
        cache_path.write_text(body)
    except Exception as e:
        meta['error'] = repr(e)
        if cache_path.exists():
            body = cache_path.read_text()
            meta['from_cache'] = True
        else:
            return [], meta
    try:
        data = json.loads(body)
        rows = (((data or {}).get('data') or {}).get('rows') or [])
        out = []
        for row in rows:
            sym = str(row.get('symbol') or '').strip().upper()
            if not sym or sym in {'N/A', 'NA'}:
                continue
            if any(x in sym for x in ['^', '/', '.', '$']):
                continue
            t = row.get('time')
            if t == 'time-after-hours': timing = 'after_market'
            elif t == 'time-pre-market': timing = 'before_market'
            elif t == 'time-during-market': timing = 'during_market'
            else: timing = 'not_supplied'
            out.append({
                'symbol': sym,
                'report_date': day.isoformat(),
                'company_name': row.get('name'),
                'before_after_market': timing,
                'nasdaq_time_raw': t,
                'market_cap': row.get('marketCap'),
                'fiscal_quarter_ending': row.get('fiscalQuarterEnding'),
                'eps_forecast': row.get('epsForecast'),
                'analyst_estimate_count': row.get('noOfEsts'),
                'last_year_report_date': row.get('lastYearRptDt'),
                'last_year_eps': row.get('lastYearEPS'),
                'source': 'nasdaq_public_calendar',
            })
        meta['row_count_raw'] = len(rows)
        meta['row_count_normalized'] = len(out)
        return out, meta
    except Exception as e:
        meta['parse_error'] = repr(e)
        return [], meta


def nasdaq_calendar_window(start: datetime.date, end: datetime.date) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    rows: list[dict[str, Any]] = []
    metas: list[dict[str, Any]] = []
    cur = start
    seen = set()
    while cur <= end:
        day_rows, meta = fetch_nasdaq_earnings_for_date(cur)
        metas.append(meta)
        for r in day_rows:
            key = (r['symbol'], r['report_date'])
            if key not in seen:
                rows.append(r); seen.add(key)
        cur += timedelta(days=1)
        time.sleep(0.15)
    return rows, metas


def qc_credentials() -> tuple[str, str]:
    path = pathlib.Path.home() / '.lean' / 'credentials'
    d = json.loads(path.read_text())
    return str(d['user-id']), str(d['api-token'])


def qc_api(method: str, endpoint: str, payload: dict | None = None) -> dict:
    uid, token = qc_credentials()
    ts = str(int(time.time()))
    pw = hashlib.sha256(f'{token}:{ts}'.encode('utf-8')).hexdigest()
    headers = {'Timestamp': ts, 'User-Agent': 'Lean CLI earnings-qc-stage2'}
    url = urljoin(QC_API_BASE, endpoint)
    data = None
    if method.upper() == 'GET' and payload:
        url += '?' + urllib.parse.urlencode(payload)
    elif payload:
        data = json.dumps(payload).encode('utf-8')
        headers['Content-Type'] = 'application/json'
    req = urllib.request.Request(url, data=data, headers=headers, method=method.upper())
    import base64
    req.add_header('Authorization', 'Basic ' + base64.b64encode(f'{uid}:{pw}'.encode()).decode())
    with urllib.request.urlopen(req, timeout=90) as r:
        out = json.loads(r.read().decode('utf-8', 'replace'))
    if not out.get('success'):
        raise RuntimeError(json.dumps({k: out.get(k) for k in ['errors','messages','Message']}, ensure_ascii=False))
    return out


def ensure_qc_project(project_dir: pathlib.Path, project_name: str = QC_PROJECT_NAME) -> tuple[int, str]:
    cfg_path = project_dir / 'config.json'
    cfg = json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
    if int(cfg.get('cloud-id') or 0) > 0 and cfg.get('organization-id'):
        return int(cfg['cloud-id']), str(cfg['organization-id'])
    projects = qc_api('GET', 'projects/read').get('projects', [])
    project = next((p for p in projects if p.get('name') == project_name), None)
    if project is None:
        project = qc_api('POST', 'projects/create', {'name': project_name, 'language': 'Py'})['projects'][0]
    cfg.update({'algorithm-language': 'Python', 'parameters': {}, 'description': 'Earnings cheap near-expiry call QC batch diagnostic', 'cloud-id': project['projectId'], 'organization-id': project.get('organizationId')})
    cfg_path.write_text(json.dumps(cfg, indent=2) + '\n')
    return int(project['projectId']), str(project.get('organizationId'))




def env_float(name: str, default: float, min_value: float | None = None, max_value: float | None = None) -> float:
    raw = os.environ.get(name)
    if raw is None or str(raw).strip() == '':
        return default
    try:
        value = float(raw)
    except Exception as e:
        raise ValueError(f'{name} must be a float, got {raw!r}') from e
    if not math.isfinite(value):
        raise ValueError(f'{name} must be finite, got {value}')
    if min_value is not None and value < min_value:
        raise ValueError(f'{name} must be >= {min_value}, got {value}')
    if max_value is not None and value > max_value:
        raise ValueError(f'{name} must be <= {max_value}, got {value}')
    return value


