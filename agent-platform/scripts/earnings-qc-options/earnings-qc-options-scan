}

def parse_int_range(raw: str | None, default: tuple[int, int], name: str) -> tuple[int, int]:
    if not raw:
        return default
    text = str(raw).replace(',', ':').strip()
    parts = text.split(':')
    if len(parts) != 2:
        raise SystemExit(f'{name} must be MIN:MAX, got {raw!r}')
    try:
        lo, hi = int(parts[0]), int(parts[1])
    except Exception as e:
        raise SystemExit(f'{name} must contain integers, got {raw!r}') from e
    if lo > hi:
        raise SystemExit(f'{name} min must be <= max, got {raw!r}')
    return lo, hi

def parse_float_range(raw: str | None, name: str) -> tuple[float, float] | None:
    if not raw:
        return None
    text = str(raw).replace(',', ':').strip()
    parts = text.split(':')
    if len(parts) != 2:
        raise SystemExit(f'{name} must be MIN:MAX, got {raw!r}')
    try:
        lo, hi = float(parts[0]), float(parts[1])
    except Exception as e:
        raise SystemExit(f'{name} must contain numbers, got {raw!r}') from e
    if lo > hi:
        raise SystemExit(f'{name} min must be <= max, got {raw!r}')
    return lo, hi

def parse_stage2_params(**kw) -> dict[str, Any]:
    qc_resolution = (kw.get('qc_resolution') or 'hour').lower()
    option_resolution = (kw.get('option_resolution') or qc_resolution).lower()
    if qc_resolution not in RESOLUTION_NAMES:
        raise SystemExit(f'unsupported --qc-resolution {qc_resolution!r}')
    if option_resolution not in RESOLUTION_NAMES:
        raise SystemExit(f'unsupported --option-resolution {option_resolution!r}')
    option_right = (kw.get('option_right') or 'call').lower()
    if option_right not in {'call', 'put', 'both'}:
        raise SystemExit(f'unsupported --option-right {option_right!r}')
    if kw.get('strike_min') is not None and kw.get('strike_max') is not None:
        strike_min, strike_max = int(kw.get('strike_min')), int(kw.get('strike_max'))
        if strike_min > strike_max:
            raise SystemExit('strike_min must be <= strike_max')
    else:
        strike_min, strike_max = parse_int_range(kw.get('strike_range'), (-50, 300), '--strike-range')
    if kw.get('delta_min') is not None or kw.get('delta_max') is not None:
        delta_range = (float(kw.get('delta_min')) if kw.get('delta_min') is not None else None, float(kw.get('delta_max')) if kw.get('delta_max') is not None else None)
    else:
        delta_range = parse_float_range(kw.get('delta_range'), '--delta-range')
    if delta_range and delta_range[0] is not None and delta_range[1] is not None and delta_range[0] > delta_range[1]:
        raise SystemExit('delta_min must be <= delta_max')
    if kw.get('iv_min') is not None or kw.get('iv_max') is not None:
        iv_range = (float(kw.get('iv_min')) if kw.get('iv_min') is not None else None, float(kw.get('iv_max')) if kw.get('iv_max') is not None else None)
    else:
        iv_range = parse_float_range(kw.get('iv_range'), '--iv-range')
    if iv_range and iv_range[0] is not None and iv_range[1] is not None and iv_range[0] > iv_range[1]:
        raise SystemExit('iv_min must be <= iv_max')
    out = {
        'qc_resolution': qc_resolution,
        'option_resolution': option_resolution,
        'qc_resolution_enum': 'Resolution.' + RESOLUTION_NAMES[qc_resolution],
        'option_resolution_enum': 'Resolution.' + RESOLUTION_NAMES[option_resolution],
        'min_expiry_after_earnings_days': int(kw.get('min_expiry_after_earnings_days') if kw.get('min_expiry_after_earnings_days') is not None else 1),
        'max_expiry_after_earnings_days': int(kw.get('max_expiry_after_earnings_days') if kw.get('max_expiry_after_earnings_days') is not None else 7),
        'min_expiration_days': int(kw.get('min_expiration_days') if kw.get('min_expiration_days') is not None else 0),
        'max_expiration_days': int(kw.get('max_expiration_days') if kw.get('max_expiration_days') is not None else 120),
        'strike_min': strike_min,
        'strike_max': strike_max,
        'option_right': option_right,
        'delta_min': delta_range[0] if delta_range else None,
        'delta_max': delta_range[1] if delta_range else None,
        'iv_min': iv_range[0] if iv_range else None,
        'iv_max': iv_range[1] if iv_range else None,
        'min_open_interest_gate': kw.get('min_open_interest_gate') if kw.get('min_open_interest_gate') is not None else kw.get('min_open_interest'),
        'min_volume_gate': kw.get('min_volume_gate') if kw.get('min_volume_gate') is not None else kw.get('min_volume'),
    }
    if out['min_expiry_after_earnings_days'] > out['max_expiry_after_earnings_days']:
        raise SystemExit('--min-expiry-after-earnings-days must be <= --max-expiry-after-earnings-days')
    if out['min_expiration_days'] > out['max_expiration_days']:
        raise SystemExit('--min-expiration-days must be <= --max-expiration-days')
    return out


def validate_scan_tuning(tuning: dict[str, float] | None = None) -> dict[str, float]:
    """Validate explicit or env-derived research-agent/LLM scan knobs."""
    tuning = tuning or {}
    out = {}
    unknown = sorted(set(tuning) - set(TUNING_SPECS))
    if unknown:
        raise ValueError(f'unknown scan tuning keys: {unknown}')
    for key, (env_name, default, min_value, max_value) in TUNING_SPECS.items():
        if key in tuning:
            try:
                value = float(tuning[key])
            except Exception as e:
                raise ValueError(f'{key} must be a float, got {tuning[key]!r}') from e
            if not math.isfinite(value):
                raise ValueError(f'{key} must be finite, got {value}')
            if value < min_value:
                raise ValueError(f'{key} must be >= {min_value}, got {value}')
            if value > max_value:
                raise ValueError(f'{key} must be <= {max_value}, got {value}')
            out[key] = value
        else:
            out[key] = env_float(env_name, default, min_value, max_value)
    return out


def scan_tuning_from_env() -> dict[str, float]:
    """Guardrailed knobs for research-agent/LLM parameter sweeps.

    These change scanner filtering only. They do not authorize live trading.
    """
    return validate_scan_tuning()


def latest_weekday_on_or_before(day: datetime.date) -> datetime.date:
    while day.weekday() >= 5:
        day -= timedelta(days=1)
    return day

def previous_weekday_before(day: datetime.date) -> datetime.date:
    day -= timedelta(days=1)
    while day.weekday() >= 5:
        day -= timedelta(days=1)
    return day

def last_completed_qc_trading_day(today: datetime.date) -> datetime.date:
    # QC daily option-chain snapshots for the current trading day may not be available
    # when this scanner runs in the morning. Use the most recent completed weekday.
    return previous_weekday_before(today)

def write_qc_stage2_project(project_dir: pathlib.Path, batch_rows: list[dict[str, Any]], today: datetime.date, tuning: dict[str, float] | None = None, stage2_params: dict[str, Any] | None = None) -> None:
    project_dir.mkdir(parents=True, exist_ok=True)
    earnings = {r['symbol']: r['report_date'] for r in batch_rows}
    tuning = validate_scan_tuning(tuning) if tuning is not None else scan_tuning_from_env()
