    start = today + timedelta(days=int(calendar_from_days))
    end = today + timedelta(days=int(calendar_to_days))
    if start > end:
        raise SystemExit('--calendar-from-days must be <= --calendar-to-days')
    run_id = f"earnings-qc-options-scan-{today.strftime('%Y%m%d')}-{now.strftime('%H%M%S')}-{os.getpid()}-{qc_batch_offset}"
