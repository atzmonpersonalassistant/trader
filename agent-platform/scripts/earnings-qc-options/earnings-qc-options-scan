def run_qc_stage2_batch(calendar_rows: list[dict[str, Any]], run_dir: pathlib.Path, batch_limit: int, today: datetime.date, batch_offset: int = 0, stage2_params: dict[str, Any] | None = None, tuning: dict[str, float] | None = None) -> dict:
    batch_rows = calendar_rows[max(0, batch_offset):max(0, batch_offset)+max(0, batch_limit)]
    if not batch_rows:
        return {'ok': False, 'reason': 'empty_batch'}
    project_name = f'{QC_PROJECT_NAME}-{batch_offset}'
    project_dir = LEAN_WORKSPACE / project_name
    tuning = validate_scan_tuning(tuning) if tuning is not None else scan_tuning_from_env()
    write_qc_stage2_project(project_dir, batch_rows, today, tuning, stage2_params=stage2_params)
    project_id, organization_id = ensure_qc_project(project_dir, project_name)
    # ensure_qc_project may have rewritten config after project creation; preserve main.py and push.
    push = subprocess.run(['lean','cloud','push','--project',str(project_dir),'--force'], cwd=str(LEAN_WORKSPACE), text=True, capture_output=True, timeout=180)
    attempts = []
    max_attempts = int(os.environ.get('QC_STAGE2_BACKTEST_ATTEMPTS', '4'))
    base_delay = int(os.environ.get('QC_STAGE2_BACKTEST_RETRY_BASE_SECONDS', '45'))
    bt = None
    name = ''
    for attempt in range(1, max(1, max_attempts) + 1):
        name = f"earnings-qc-stage2-{today.strftime('%Y%m%d')}-{datetime.datetime.now(datetime.timezone.utc).strftime('%H%M%S')}-n{len(batch_rows)}-a{attempt}"
        bt = subprocess.run(['lean','cloud','backtest',project_name,'--push','--name',name], cwd=str(LEAN_WORKSPACE), text=True, capture_output=True, timeout=900)
        output = (bt.stdout + '\n' + bt.stderr).strip()
        capacity = classify_qc_cloud_capacity(output)
        retryable = bt.returncode != 0 and bool(capacity)
        attempts.append({'attempt': attempt, 'returncode': bt.returncode, 'retryable': retryable, 'rate_limited': bool((capacity or {}).get('rate_limited')), 'capacity_blocked': bool((capacity or {}).get('capacity_blocked'))})
        if bt.returncode == 0 or not retryable or attempt >= max_attempts:
            break
        time.sleep(base_delay * attempt)
    assert bt is not None
    (run_dir/'qc_stage2_push_stdout.txt').write_text(push.stdout)
    (run_dir/'qc_stage2_push_stderr.txt').write_text(push.stderr)
    (run_dir/'qc_stage2_backtest_stdout.txt').write_text(bt.stdout)
    (run_dir/'qc_stage2_backtest_stderr.txt').write_text(bt.stderr)
    (run_dir/'qc_stage2_backtest_attempts.json').write_text(json.dumps(attempts, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    m = re.search(r'Backtest id:\s*([0-9a-f]+)', bt.stdout + '\n' + bt.stderr)
    backtest_id = m.group(1) if m else None
    backtest_output = (bt.stdout + '\n' + bt.stderr).strip()
    out = {'ok': push.returncode == 0 and bt.returncode == 0 and bool(backtest_id), 'tuning': tuning, 'stage2_params': parse_stage2_params(**(stage2_params or {})), 'project_id': project_id, 'organization_id': organization_id, 'project_name': project_name, 'backtest_id': backtest_id, 'backtest_name': name, 'symbols_requested': len(batch_rows), 'symbols_offset': batch_offset, 'symbols': [r['symbol'] for r in batch_rows], 'push_returncode': push.returncode, 'backtest_returncode': bt.returncode, 'backtest_attempts': attempts}
    capacity = classify_qc_cloud_capacity(backtest_output) if bt.returncode != 0 else None
    if capacity:
        out.update(capacity)
    if backtest_id:
        try:
            b = qc_api('GET', 'backtests/read', {'projectId': project_id, 'backtestId': backtest_id}).get('backtest', {})
            out['runtime_statistics'] = b.get('runtimeStatistics') or {}
            parts = [out['runtime_statistics'][k] for k in sorted(out['runtime_statistics']) if k.startswith('trader.stage2_json_')]
            if parts:
                try:
                    out['parsed_result'] = json.loads(''.join(parts))
                except Exception as e:
                    out['parsed_result_error'] = repr(e)
            qc_capacity = classify_qc_cloud_capacity('\n'.join(str(x or '') for x in [b.get('status'), b.get('error'), b.get('stacktrace')]))
            out['status'] = (qc_capacity or {}).get('status') or b.get('status')
            out['completed'] = b.get('completed')
            out['error'] = (qc_capacity or {}).get('error') or b.get('error')
            out['stacktrace'] = b.get('stacktrace')
            if qc_capacity:
                out.update(qc_capacity)
            out['ok'] = bool(out.get('ok') and b.get('completed') and b.get('status') == 'Completed.' and not b.get('error') and not b.get('stacktrace') and 'trader.symbols_input' in (out.get('runtime_statistics') or {}))
            (run_dir/'qc_stage2_backtest_read.json').write_text(json.dumps(b, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
        except Exception as e:
            out['read_error'] = repr(e)
            out['ok'] = False
    return out


def stat_int(stats: dict, key: str) -> int | None:
    v = stats.get(key)
    if v is None: return None
    try: return int(str(v).replace(',', '').strip())
    except Exception: return None


def qc_capability_probe(calendar_rows: list[dict[str, Any]], run_dir: pathlib.Path, batch_limit: int, today: datetime.date, batch_offset: int = 0, stage2_params: dict[str, Any] | None = None, tuning: dict[str, float] | None = None) -> dict:
    checks = {}
    try:
        p = subprocess.run(['lean', '--version'], cwd=str(LEAN_WORKSPACE), text=True, capture_output=True, timeout=20)
        checks['lean_version'] = {'ok': p.returncode == 0, 'stdout': p.stdout.strip(), 'stderr': p.stderr.strip()[:500]}
    except Exception as e:
        checks['lean_version'] = {'ok': False, 'error': repr(e)}
    try:
        p = subprocess.run(['lean', 'cloud', 'pull', '--help'], cwd=str(LEAN_WORKSPACE), text=True, capture_output=True, timeout=30)
        checks['qc_smoke'] = {'ok': p.returncode == 0, 'stdout': p.stdout.strip()[:1000], 'stderr': p.stderr.strip()[:500], 'note': 'CLI cloud command reachable; not a full QC auth/project backtest'}
    except Exception as e:
        checks['qc_smoke'] = {'ok': False, 'error': repr(e)}
    try:
        checks['qc_option_chain_batch_diagnostic'] = run_qc_stage2_batch(calendar_rows, run_dir, batch_limit, today, batch_offset, stage2_params=stage2_params, tuning=tuning)
    except Exception as e:
        checks['qc_option_chain_batch_diagnostic'] = {'ok': False, 'error': repr(e)}
    return checks


def normalize_symbols_arg(symbols: str | None) -> list[str]:
    if not symbols:
        return []
    out = []
    seen = set()
    for raw in symbols.replace(';', ',').split(','):
        sym = raw.strip().upper()
        if not sym:
            continue
        if not all(c.isalnum() or c in {'-', '_'} for c in sym):
            raise SystemExit(f'invalid symbol for --symbols: {sym!r}')
        if sym not in seen:
            out.append(sym); seen.add(sym)
    return out


def filter_calendar_rows_by_symbols(calendar_rows: list[dict[str, Any]], symbols: list[str]) -> list[dict[str, Any]]:
    if not symbols:
        return calendar_rows
    wanted = set(symbols)
    return [r for r in calendar_rows if str(r.get('symbol') or '').upper() in wanted]


