        calendar_fetches = [{'source': 'full_scan_calendar_snapshot', 'path': calendar_snapshot, 'row_count_normalized': len(calendar_rows)}]
    else:
        calendar_rows, calendar_fetches = nasdaq_calendar_window(start, end)
    requested_symbols = symbols_filter or []
    if requested_symbols:
        original_calendar_row_count = len(calendar_rows)
        calendar_rows = filter_calendar_rows_by_symbols(calendar_rows, requested_symbols)
        calendar_fetches.append({'source': 'symbols_filter', 'requested_symbols': requested_symbols,
        'stage2_params': parse_stage2_params(**(stage2_params or {})), 'row_count_before_filter': original_calendar_row_count, 'row_count_after_filter': len(calendar_rows)})
    (run_dir/'calendar_rows.json').write_text(json.dumps(calendar_rows, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    symbols = sorted({r['symbol'] for r in calendar_rows})
    calendar_fetch_failed = (not bool(calendar_snapshot)) and any(m.get('error') or m.get('parse_error') for m in calendar_fetches)
    # Preserve Nasdaq market-cap order for QC batch by using calendar order.
    checks = qc_capability_probe(calendar_rows, run_dir, min(qc_batch_limit, max(0, len(calendar_rows)-qc_batch_offset)), today, qc_batch_offset, stage2_params=stage2_params, tuning=tuning) if calendar_rows else qc_capability_probe([], run_dir, 0, today, 0, stage2_params=stage2_params, tuning=tuning)
    batch = checks.get('qc_option_chain_batch_diagnostic', {})
    batch_ok = bool(batch.get('ok'))
    stats = batch.get('runtime_statistics') or {}
    batch_n = int(batch.get('symbols_requested') or 0)
    candidate_count = stat_int(stats, 'trader.candidates') if batch_ok else None
    candidate_details = []
    candidate_details_parse_failed = False
    tuning_stats = {}
    if batch_ok:
        parsed_result = batch.get('parsed_result') or {}
        if isinstance(parsed_result.get('candidate_details'), list):
            candidate_details = parsed_result.get('candidate_details') or []
        else:
            try:
                candidate_details = json.loads(stats.get('trader.candidates_json') or '[]')
            except Exception:
                candidate_details = []
                candidate_details_parse_failed = True
        try:
            tuning_stats = json.loads(stats.get('trader.tuning') or '{}')
        except Exception:
            tuning_stats = {}
    if not calendar_rows:
        status = 'BLOCKED_NASDAQ_CALENDAR_EMPTY'
    elif calendar_fetch_failed:
        status = 'BLOCKED_NASDAQ_CALENDAR_PARTIAL_FETCH_FAILED'
        batch_ok = False
    elif batch_ok and (candidate_details_parse_failed or (candidate_count or 0) > len(candidate_details)) and (candidate_count or 0) > 0:
        status = 'BLOCKED_QC_CANDIDATE_DETAILS_MISSING_OR_TRUNCATED'
        batch_ok = False
    elif batch.get('rate_limited'):
        status = 'BLOCKED_QC_CLOUD_RATE_LIMITED'
        batch_ok = False
    elif batch.get('capacity_blocked'):
        status = 'BLOCKED_QC_CLOUD_NO_SPARE_NODES'
        batch_ok = False
    elif batch_ok and batch_n > 0 and len((batch.get('parsed_result') or {}).get('rows') or []) == 0:
        status = 'BLOCKED_QC_NO_OPTION_CHAIN_ROWS_ON_VALUATION_DATE'
        batch_ok = False
    elif batch_ok:
        status = 'OK_STAGE3_QC_BATCH'
    else:
        status = 'BLOCKED_QC_BATCH_FAILED'

    payload = {
        'ok': bool(calendar_rows) and batch_ok and not calendar_fetch_failed and not ((candidate_details_parse_failed or (candidate_count or 0) > len(candidate_details)) and (candidate_count or 0) > 0),
        'status': status,
        'run_id': run_id,
        'run_date': today.isoformat(),
        'report_dir': str(run_dir),
        'calendar_window': [start.isoformat(), end.isoformat()],
        'calendar_source': 'nasdaq_public_calendar',
        'calendar_universe_count': len(symbols),
        'calendar_row_count': len(calendar_rows),
        'calendar_sample': calendar_rows[:25],
        'calendar_fetches': calendar_fetches,
        'calendar_fetch_failed': calendar_fetch_failed,
        'requested_symbols': requested_symbols,
        'stage2_params': parse_stage2_params(**(stage2_params or {})),
        'scan_tuning': tuning,
        'qc_batch_limit': qc_batch_limit,
        'qc_batch_count': batch_n,
        'qc_processed_row_count': len((batch.get('parsed_result') or {}).get('rows') or []),
        'valuation_date': last_completed_qc_trading_day(today).isoformat(),
        'qc_batch_offset': qc_batch_offset,
        'candidate_count': candidate_count,
        'candidate_details': candidate_details,
        'candidate_details_parse_failed': candidate_details_parse_failed,
        'tuning': tuning_stats,
        'blocked_reason': None if batch_ok else ('Nasdaq calendar empty' if not calendar_rows else ('Nasdaq calendar partial fetch/parse failure' if calendar_fetch_failed else ('QC Cloud rate-limited backtest requests; retry later/slower' if batch.get('rate_limited') else ('QC Cloud has no spare nodes available for a new backtest' if batch.get('capacity_blocked') else ('QC candidate details JSON missing/truncated/unparseable' if (candidate_details_parse_failed or (candidate_count or 0) > len(candidate_details)) and (candidate_count or 0) > 0 else ('QC produced zero option-chain rows on valuation date' if batch_n > 0 and len((batch.get('parsed_result') or {}).get('rows') or []) == 0 and batch.get('backtest_returncode') == 0 else 'QC/LEAN batch option-chain diagnostic failed; see qc_stage2_* artifacts.')))))),
        'required_next_step': 'Run QC/EODHD multi-year historical option-PnL backtest with explicit exit policy.' if batch_ok else 'Fix QC batch diagnostic failure.',
        'qc_checks': checks,
        'funnel': {
            '01_nasdaq_earnings_21_28d_universe': len(symbols),
            '02_qc_option_chain_available': stat_int(stats, 'trader.option_chain_available'),
            '03_qc_expiry_within_0_7d_after_earnings': stat_int(stats, 'trader.expiry_within_0_7d_after_earnings'),
            '035_qc_otm_expiry_within_0_7d_after_earnings': stat_int(stats, 'trader.otm_expiry_within_0_7d_after_earnings'),
            '04_qc_calls_ask_under_max_premium': stat_int(stats, 'trader.calls_under_max_premium'),
            '05_qc_liquidity_greeks_quality_pass': stat_int(stats, 'trader.liquidity_pass'),
            '07_multi_year_backtest_status': 'REQUIRES_QC_EODHD_MULTIYEAR_OPTION_PNL',
            '08_qc_candidates': candidate_count,
        },
        'guardrails': {
            'no_yahoo_yfinance': True,
            'nasdaq_calendar_stage_only': True,
            'qc_for_options_and_history': True,
            'research_only': True,
            'qc_stage2_batch_limited': batch_n < len(symbols),
        },
    }
    if not calendar_rows:
        msg = (
            'סריקת דוחות Nasdaq נכשלה/חזרה ריקה.\n'
            f'- חלון: {start.isoformat()} עד {end.isoformat()}\n'
            '- לא הופעל Yahoo/yfinance.'
        )
    elif batch_ok:
        top = ', '.join(symbols[:20]) + ('…' if len(symbols) > 20 else '')
        msg = (
            'סריקת דוחות + QC Stage 3 הורצה בהצלחה.\n'
            f'- חלון דוחות: {start.isoformat()} עד {end.isoformat()}\n'
            f'- Nasdaq universe: {len(symbols)} סימבולים / {len(calendar_rows)} שורות\n'
            f'- QC batch שנבדק: {batch_n} סימבולים, offset {qc_batch_offset}\n'
            f'- option chain: {payload["funnel"]["02_qc_option_chain_available"]}/{batch_n}\n'
            f'- פקיעה עד 7 ימים אחרי הדוח: {payload["funnel"]["03_qc_expiry_within_0_7d_after_earnings"]}/{batch_n}\n'
            f'- OTM בתוך חלון הפקיעה: {payload["funnel"]["035_qc_otm_expiry_within_0_7d_after_earnings"]}/{batch_n}\n'
            f'- חוזי OTM בלבד ממשיכים לשלב cheap-calls; נמדד required_move_pct לכל חוזה\n'
            f'- calls עם ask עד max premium: {payload["funnel"]["04_qc_calls_ask_under_max_premium"]}/{batch_n}\n'
            f'- liquidity/Greeks quality pass: {payload["funnel"]["05_qc_liquidity_greeks_quality_pass"]}/{batch_n}\n'
            f'- multi-year backtest: {payload["funnel"]["07_multi_year_backtest_status"]}\n'
            f'- מועמדים ב־batch: {candidate_count}\n'
            + (''.join([f'- {c.get("symbol")}: חוזים לדוגמה {len(c.get("contracts",[]))}\n' for c in candidate_details[:5]]) if candidate_details else '')
            + f'- דוגמאות universe: {top}\n'
            '- לא הופעל Yahoo/yfinance.'
        )
    else:
        msg = (
            'שלב Nasdaq עבר, אבל QC Stage 2 נכשל.\n'
            f'- חלון דוחות: {start.isoformat()} עד {end.isoformat()}\n'
            f'- Nasdaq universe: {len(symbols)} סימבולים\n'
            '- ראה qc_stage2_* artifacts בדוח.\n'
            '- לא הופעל Yahoo/yfinance.'
        )
    (run_dir/'nasdaq_calendar_rows.json').write_text(json.dumps(calendar_rows, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    (run_dir/'candidate_details.json').write_text(json.dumps(candidate_details, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    (run_dir/'result.json').write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    (run_dir/'hebrew_report.md').write_text(msg+'\n')
    if notify and (payload.get('candidate_count') or not payload.get('ok')):
        payload['outbox_written'] = write_outbox(msg, payload)
        (run_dir/'result.json').write_text(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)+'\n')
    print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    return 0 if payload.get('ok') else 2


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == 'run-now':
        notify = '--no-outbox' not in sys.argv
        limit = None
        offset = None
        if '--qc-batch-limit' in sys.argv:
            i = sys.argv.index('--qc-batch-limit')
            limit = int(sys.argv[i+1])
        snapshot = None
        if '--qc-batch-offset' in sys.argv:
            i = sys.argv.index('--qc-batch-offset')
            offset = int(sys.argv[i+1])
        if '--calendar-snapshot' in sys.argv:
            i = sys.argv.index('--calendar-snapshot')
            snapshot = sys.argv[i+1]
        symbols = None
        if '--symbols' in sys.argv:
            i = sys.argv.index('--symbols')
            symbols = normalize_symbols_arg(sys.argv[i+1])
        def opt(name, default=None):
            if name in sys.argv:
                return sys.argv[sys.argv.index(name)+1]
            return default
        stage2_params = parse_stage2_params(
            qc_resolution=opt('--qc-resolution'),
            option_resolution=opt('--option-resolution'),
            min_expiry_after_earnings_days=opt('--min-expiry-after-earnings-days'),
            max_expiry_after_earnings_days=opt('--max-expiry-after-earnings-days'),
            min_expiration_days=opt('--min-expiration-days'),
            max_expiration_days=opt('--max-expiration-days'),
            strike_range=opt('--strike-range'),
            option_right=opt('--option-right'),
            delta_range=opt('--delta-range'),
            iv_range=opt('--iv-range'),
            min_open_interest=int(opt('--min-open-interest')) if opt('--min-open-interest') is not None else None,
            min_volume=int(opt('--min-volume')) if opt('--min-volume') is not None else None,
        )
        tuning = validate_scan_tuning({
            key: opt(flag) for key, flag in [
                ('max_premium', '--max-premium'),
                ('min_bid', '--min-bid'),
                ('max_spread_pct', '--max-spread-pct'),
                ('min_relative_spread', '--min-relative-spread'),
                ('vol_spread_factor', '--vol-spread-factor'),
                ('expected_move_spread_fraction', '--expected-move-spread-fraction'),
            ] if opt(flag) is not None
        })
        return run_now(notify=notify, qc_batch_limit=limit, qc_batch_offset=offset, calendar_snapshot=snapshot, symbols_filter=symbols, as_of_date=opt('--as-of-date'), calendar_from_days=int(opt('--calendar-from-days', 21)), calendar_to_days=int(opt('--calendar-to-days', 28)), stage2_params=stage2_params, tuning=tuning)
    print('usage: earnings-qc-options-scan run-now [--no-outbox] [--qc-batch-limit N] [--qc-batch-offset N] [--calendar-snapshot PATH] [--symbols AAPL,MSFT]', file=sys.stderr)
    return 64

if __name__ == '__main__':
    raise SystemExit(main())
