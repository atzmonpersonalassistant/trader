#!/usr/bin/env python3
import json
import pathlib
import sys


TERMINAL_NO_TRADE_STATUSES = {
    "NO_FORWARD_CANDIDATES",
    "NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL",
}


def bounded_action_is_completed_research(payload: dict) -> bool:
    status = str(
        payload.get("status")
        or (payload.get("summary") or {}).get("status")
        or (payload.get("multiyear") or {}).get("status")
        or ""
    )
    ok = payload.get("ok")
    return ok is False and (
        status.startswith(("BLOCKED_", "PARTIAL_"))
        or status in TERMINAL_NO_TRADE_STATUSES
    )


def main() -> int:
    try:
        payload = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
    except Exception:
        return 1
    return 0 if bounded_action_is_completed_research(payload) else 1


if __name__ == "__main__":
    raise SystemExit(main())
