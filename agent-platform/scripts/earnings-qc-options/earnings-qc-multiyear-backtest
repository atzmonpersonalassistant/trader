def parse_range(value: str | None, default_lo: int, default_hi: int) -> tuple[int, int]:
    if not value:
        return default_lo, default_hi
    parts = str(value).replace(':', ',').split(',')
    if len(parts) != 2:
        raise SystemExit(f'invalid range {value!r}; expected lo:hi')
    lo = int(parts[0]); hi = int(parts[1])
    if lo > hi:
        raise SystemExit(f'invalid range {value!r}; low > high')
    return lo, hi

def qc_resolution_key(value: str | None, default: str = 'daily') -> str:
    v = (value or default).strip().lower()
    if v not in {'tick', 'second', 'minute', 'hour', 'daily'}:
        raise SystemExit(f'invalid resolution {value!r}')
    return v

def qc_resolution_expr(value: str | None, default: str = 'daily') -> str:
    mapping = {
        'tick': 'Resolution.TICK',
        'second': 'Resolution.SECOND',
        'minute': 'Resolution.MINUTE',
        'hour': 'Resolution.HOUR',
        'daily': 'Resolution.DAILY',
    }
    return mapping[qc_resolution_key(value, default)]

def path_metrics_key(value: str | None, default: str = 'daily') -> str:
    v = (value or default).strip().lower()
    if v not in {'none', 'daily', 'hour', 'minute'}:
        raise SystemExit(f'invalid path_metrics {value!r}')
    return v

def runtime_stat_chunks(stats:dict, prefix:str)->list[str]:
    def chunk_index(key:str)->int:
        try:
            return int(key.rsplit('_', 1)[1])
        except Exception:
            return 10**9
    return [stats[k] for k in sorted((k for k in stats if k.startswith(prefix)), key=chunk_index)]

def hist_params(params:dict|None) -> dict:
    p = dict(params or {})
    entry_min, entry_max = parse_range(p.get('entry_window'), 21, 28)
    strike_min, strike_max = parse_range(p.get('strike_range'), -50, 300)
    max_contracts = p.get('max_contracts')
    stop_loss = p.get('stop_loss_max_loss_pct')
    stop_loss_max_loss_pct = -abs(float(stop_loss)) if stop_loss is not None else None
    option_right = str(p.get('option_right') or 'call').lower()
    if option_right not in {'call', 'put', 'both'}:
        raise SystemExit(f"invalid option_right {option_right!r}; expected call, put, or both")
    exit_days_before = int(p.get('exit_days_before') if p.get('exit_days_before') is not None else 1)
    if exit_days_before < 1:
        raise SystemExit(f"invalid exit_days_before {exit_days_before!r}; expected integer >= 1")
    exit_policy_raw = p.get('exit_policy')
    exit_policy = str(exit_policy_raw).strip().lower().replace('_', '-') if exit_policy_raw is not None else ''
    implemented_exit_policy = 'sell-before-earnings-no-hold-through'
    unimplemented_exit_policies = {'before-earnings', 'after-market-report-day-close'}
    if not exit_policy:
        exit_policy = implemented_exit_policy
    if exit_policy in unimplemented_exit_policies:
        raise SystemExit(
            f"exit_policy {exit_policy!r} is accepted by older artifacts but is not implemented; "
            f"only {implemented_exit_policy} is implemented"
        )
    if exit_policy != implemented_exit_policy:
        raise SystemExit(f"invalid exit_policy {exit_policy!r}; expected {implemented_exit_policy}")
    return {
        'historical_resolution': qc_resolution_key(p.get('historical_resolution'), 'daily'),
        'option_right': option_right,
        'exit_days_before': exit_days_before,
        'exit_policy': 'sell_before_earnings_no_hold_through',
        'max_premium': float(p.get('max_premium') if p.get('max_premium') is not None else 0.50),
        'max_required_move_pct': float(p.get('max_required_move_pct')) if p.get('max_required_move_pct') is not None else None,
        'max_days_after_earnings': int(p.get('max_expiry_after_earnings_days') if p.get('max_expiry_after_earnings_days') is not None else 7),
        'min_expiration_days': int(p.get('min_expiration_days') if p.get('min_expiration_days') is not None else 1),
        'max_expiration_days': int(p.get('max_expiration_days') if p.get('max_expiration_days') is not None else 60),
        'entry_min_days': entry_min,
        'entry_max_days': entry_max,
        'strike_min': strike_min,
        'strike_max': strike_max,
        'min_bid': float(p.get('min_bid') if p.get('min_bid') is not None else 0.05),
        'max_spread': float(p.get('max_spread') if p.get('max_spread') is not None else 0.25),
        'max_spread_pct': float(p.get('max_spread_pct') if p.get('max_spread_pct') is not None else 0.60),
        'min_relative_spread': float(p.get('min_relative_spread') if p.get('min_relative_spread') is not None else 0.25),
        'vol_spread_factor': float(p.get('vol_spread_factor') if p.get('vol_spread_factor') is not None else 0.50),
        'expected_move_spread_fraction': float(p.get('expected_move_spread_fraction') if p.get('expected_move_spread_fraction') is not None else 0.15),
        'min_open_interest': int(p.get('min_open_interest') if p.get('min_open_interest') is not None else 0),
        'min_volume': int(p.get('min_volume') if p.get('min_volume') is not None else 0),
        'max_contracts': int(max_contracts) if max_contracts is not None else 3,
        'stop_loss_max_loss_pct': stop_loss_max_loss_pct,
        'option_resolution': qc_resolution_expr(p.get('option_resolution') or p.get('historical_resolution'), 'daily'),
        'path_metrics': path_metrics_key(p.get('path_metrics'), 'daily'),
        'delta_target': float(p.get('delta_target') if p.get('delta_target') is not None else 0.25),
        # No public --final-* CLI flags exist today; keep scanner and generated QC defaults tied to the same env values.
        'final_min_sample_size': int(p.get('final_min_sample_size') if p.get('final_min_sample_size') is not None else os.environ.get('QC_FINAL_MIN_SAMPLE_SIZE', '12')),
        'final_max_dropout_pct': float(p.get('final_max_dropout_pct') if p.get('final_max_dropout_pct') is not None else os.environ.get('QC_FINAL_MAX_DROPOUT_PCT', '40')),
    }

def write_project(project_dir:pathlib.Path, candidates:list[dict], years:int, params:dict|None=None):
    project_dir.mkdir(parents=True,exist_ok=True)
    cfg_path=project_dir/'config.json'
    existing_cfg=json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
    hp = hist_params(params)
    today=datetime.date.today(); start=today.replace(year=max(2018,today.year-years)); end=today
    minimal=[]
    for c in candidates:
        minimal.append({'symbol':c.get('symbol'),'forward_earnings_date':c.get('earnings_date'),'spot':c.get('spot'),'forward_contracts':[{'strike':x.get('strike'),'ask':x.get('ask'),'required_move_pct':x.get('required_move_pct'),'days_after_earnings':x.get('days_after_earnings')} for x in (c.get('contracts') or [])[:hp['max_contracts']]]})
    cfg={'algorithm-language':'Python','parameters':{},'description':'Earnings candidates multi-year historical option PnL backtest','cloud-id':0,'organization-id':''}
    if int(existing_cfg.get('cloud-id') or 0)>0 and existing_cfg.get('organization-id'):
        cfg.update({'cloud-id':existing_cfg['cloud-id'],'organization-id':existing_cfg['organization-id']})
    cfg_path.write_text(json.dumps(cfg,indent=2)+'\n')
    code=f'''from AlgorithmImports import *\nfrom QuantConnect.DataSource import EODHDUpcomingEarnings\nimport json, math\nfrom datetime import datetime, timedelta\n\nclass EarningsQcHistoricalOptionPnl(QCAlgorithm):\n    def initialize(self):\n        self.set_start_date({start.year},{start.month},{start.day})\n        self.set_end_date({end.year},{end.month},{end.day})\n        self.set_cash(100000)\n        self.candidates = json.loads({json.dumps(minimal, sort_keys=True)!r})\n        self.targets = set([c["symbol"] for c in self.candidates if c.get("symbol")])\n        self.events = {{}}\n        self.snapshots = {{}}  # sym -> date -> {{underlying, contracts}}\n        self.contract_fields = ("symbol","strike","expiry","bid","ask","mid","last","volume","open_interest","iv","delta")\n        self.contract_field_index = {{name:i for i,name in enumerate(self.contract_fields)}}\n        self.snapshot_contract_count = 0\n        self.snapshot_day_count = 0\n        self.snapshot_peak_day_count = 0\n        self.errors = []\n        self.max_premium = {hp['max_premium']:.6f}\n        self.max_days_after_earnings = {hp['max_days_after_earnings']}\n        self.entry_min_days = {hp['entry_min_days']}\n        self.entry_max_days = {hp['entry_max_days']}\n        self.exit_policy = 'sell_before_earnings_no_hold_through'\n        self.max_spread = {hp['max_spread']:.6f}\n        self.max_spread_pct = {hp['max_spread_pct']:.6f}\n        self.min_relative_spread = {hp['min_relative_spread']:.6f}\n        self.vol_spread_factor = {hp['vol_spread_factor']:.6f}\n        self.expected_move_spread_fraction = {hp['expected_move_spread_fraction']:.6f}\n        self.min_bid = {hp['min_bid']:.6f}\n        self.min_open_interest = {hp['min_open_interest']}\n        self.min_volume = {hp['min_volume']}\n        self.stop_loss_max_loss_pct = {repr(hp['stop_loss_max_loss_pct'])}\n        self.universe_settings.resolution = {hp['option_resolution']}\n        self.add_universe(EODHDUpcomingEarnings, self.selection)\n        self.option_by_underlying = {{}}\n        for c in self.candidates:\n            try:\n                eq = self.add_equity(c["symbol"], {hp['option_resolution']})\n                eq.set_data_normalization_mode(DataNormalizationMode.RAW)\n                opt = self.add_option(c["symbol"], {hp['option_resolution']})\n                opt.set_filter(lambda u: u.include_weeklys().strikes({hp['strike_min']}, {hp['strike_max']}).expiration(timedelta({hp['min_expiration_days']}), timedelta({hp['max_expiration_days']})))\n                self.option_by_underlying[eq.symbol] = opt.symbol\n            except Exception as e:\n                self.errors.append({{"symbol": c.get("symbol"), "stage":"add_symbol", "error":str(e)[:200]}})\n    def qget(self, q, key, default=None):\n        if hasattr(q, 'get'):\n            return q.get(key, default)\n        idx=self.contract_field_index.get(key)\n        return q[idx] if idx is not None and idx < len(q) else default\n    def qdict(self, q):\n        if hasattr(q, 'items'):\n            return dict(q)\n        return {{k:self.qget(q,k) for k in self.contract_fields}}\n    def compact_contract(self, c, exp, bid, ask, mid, last):\n        return (str(c.symbol), float(c.strike), exp.isoformat(), round(bid,4), round(ask,4), round(mid,4), round(last,4), int(c.volume) if c.volume is not None else 0, int(c.open_interest) if c.open_interest is not None else 0, round(float(c.implied_volatility),4) if c.implied_volatility is not None else None, round(float(c.greeks.delta),4) if c.greeks is not None and c.greeks.delta is not None else None)\n    def snapshot_memory_stats(self):\n        day_count=sum(len(days) for days in self.snapshots.values())\n        contract_count=0\n        peak_contracts_per_symbol_day=0\n        for days in self.snapshots.values():\n            for snap in days.values():\n                n=len(snap.get('contracts') or [])\n                contract_count += n\n                peak_contracts_per_symbol_day=max(peak_contracts_per_symbol_day,n)\n        self.snapshot_contract_count=contract_count\n        self.snapshot_day_count=day_count\n        self.snapshot_peak_day_count=max(self.snapshot_peak_day_count, day_count)\n        stats={{"snapshot_contract_count":contract_count,"snapshot_day_count":day_count,"snapshot_peak_day_count":self.snapshot_peak_day_count,"snapshot_peak_contracts_per_symbol_day":peak_contracts_per_symbol_day,"snapshot_record_format":"tuple_v1","snapshot_strike_range":"{hp['strike_min']}:{hp['strike_max']}"}}\n        txt=json.dumps(stats, sort_keys=True, separators=(',',':'))\n        self.set_runtime_statistic('multiyear_snapshot_memory', txt[:3900])\n        for k,v in stats.items():\n            self.set_runtime_statistic('multiyear_'+k, str(v))\n        return stats\n    def selection(self, data):\n        for d in data:\n            try:\n                sym=str(d.symbol.value).upper()\n                if sym not in self.targets: continue\n                rd=d.report_date\n                report_date=rd.date() if hasattr(rd,'date') else rd\n                self.events.setdefault(sym, {{}})[str(report_date)]={{"symbol":sym,"asof":self.time.strftime('%Y-%m-%d'),"report_date":str(report_date),"report_time":str(getattr(d,'report_time',None))}}\n            except Exception as e:\n                self.errors.append({{"stage":"selection", "error":str(e)[:200]}})\n        return []\n    def on_data(self, data):\n        day=self.time.date().isoformat()\n        for underlying,opt_symbol in list(self.option_by_underlying.items()):\n            try:\n                sym=str(underlying).split(' ')[0].upper()\n                chain=data.option_chains.get(opt_symbol)\n                if chain is None: continue\n                spot=float(self.securities[underlying].price)\n                rows=[]\n                for c in list(chain):\n                    if c.right != OptionRight.CALL: continue\n                    exp=c.expiry.date()\n                    dte=(exp-self.time.date()).days\n                    if dte < {hp['min_expiration_days']} or dte > {hp['max_expiration_days']}: continue\n                    bid=float(c.bid_price) if c.bid_price is not None else 0.0\n                    ask=float(c.ask_price) if c.ask_price is not None else 0.0\n                    last=float(c.last_price) if c.last_price is not None else 0.0\n                    if bid <= 0 and ask <= 0 and last <= 0: continue\n                    mid=(bid+ask)/2.0 if bid>0 and ask>0 else (last if last>0 else max(bid,ask))\n                    rows.append(self.compact_contract(c, exp, bid, ask, mid, last))\n                if rows:\n                    self.snapshots.setdefault(sym, {{}})[day]={{"underlying":round(spot,4),"contracts":rows}}\n                    self.snapshot_memory_stats()\n            except Exception as e:\n                self.errors.append({{"stage":"snapshot", "error":str(e)[:200]}})\n    def liquidity_metrics(self, q, spot, dte):\n        bid=self.qget(q,'bid') or 0; ask=self.qget(q,'ask') or 0; mid=self.qget(q,'mid') or 0\n        spread=ask-bid\n        rel_spread=spread/mid if mid>0 else 999\n        iv=self.qget(q,'iv')\n        delta=self.qget(q,'delta')\n        expected_option_move=abs(delta) * spot * iv * ((max(dte, 1) / 365.0) ** 0.5) if delta is not None and iv is not None and spot else None\n        allowed_relative_spread=min(self.max_spread_pct, max(self.min_relative_spread, self.min_relative_spread + self.vol_spread_factor * iv * ((max(dte, 1) / 365.0) ** 0.5))) if iv is not None else None\n        allowed_spread_inputs=[self.max_spread]\n        if mid>0 and allowed_relative_spread is not None:\n            allowed_spread_inputs.append(mid * allowed_relative_spread)\n        if expected_option_move is not None:\n            allowed_spread_inputs.append(self.expected_move_spread_fraction * expected_option_move)\n        allowed_spread=min(allowed_spread_inputs)\n        return {{"spread":round(spread,4),"spread_mid_pct":round(rel_spread*100,2) if rel_spread != 999 else None,"allowed_spread":round(allowed_spread,4),"allowed_relative_spread_pct":round((allowed_relative_spread or 0)*100,2) if allowed_relative_spread is not None else None,"expected_option_move":round(expected_option_move,4) if expected_option_move is not None else None,"missing_volatility_inputs": iv is None or delta is None}}\n    def liquidity_pass(self, q, spot, dte):\n        bid=self.qget(q,'bid') or 0; ask=self.qget(q,'ask') or 0; mid=self.qget(q,'mid') or 0\n        m=self.liquidity_metrics(q, spot, dte)\n        if ask <= 0 or bid < self.min_bid or mid <= 0: return False\n        if m['missing_volatility_inputs']: return False\n        if m['spread'] > m['allowed_spread']: return False\n        if m['spread_mid_pct'] is None or m['spread_mid_pct'] > self.max_spread_pct * 100.0: return False\n        if (self.qget(q,'open_interest') or 0) < self.min_open_interest and (self.qget(q,'volume') or 0) < self.min_volume: return False\n        return True\n    def nearest_snapshot_date(self, sym, target, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys()])\n        for d in dates:\n            if d >= target and d <= latest: return d\n        return None\n    def quote_on_or_before(self, sym, contract_symbol, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys() if datetime.strptime(d,'%Y-%m-%d').date() <= latest], reverse=True)\n        for d in dates[:10]:\n            snap=self.snapshots[sym][d.isoformat()]\n            for q in snap['contracts']:\n                if self.qget(q,'symbol')==contract_symbol:\n                    return d, q, snap.get('underlying')\n        return None, None, None\n    def contract_quotes_between(self, sym, contract_symbol, start, latest):\n        rows=[]\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').d