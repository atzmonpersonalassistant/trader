    code=f'''from AlgorithmImports import *\nfrom QuantConnect.DataSource import EODHDUpcomingEarnings\nimport json, math\nfrom datetime import datetime, timedelta\n\nclass EarningsQcHistoricalOptionPnl(QCAlgorithm):\n    def initialize(self):\n        self.set_start_date({start.year},{start.month},{start.day})\n        self.set_end_date({end.year},{end.month},{end.day})\n        self.set_cash(100000)\n        self.candidates = json.loads({json.dumps(minimal, sort_keys=True)!r})\n        self.targets = set([c["symbol"] for c in self.candidates if c.get("symbol")])\n        self.events = {{}}\n        self.snapshots = {{}}  # sym -> date -> {{underlying, contracts}}\n        self.contract_fields = ("symbol","strike","expiry","bid","ask","mid","last","volume","open_interest","iv","delta")\n        self.contract_field_index = {{name:i for i,name in enumerate(self.contract_fields)}}\n        self.snapshot_contract_count = 0\n        self.snapshot_day_count = 0\n        self.snapshot_peak_day_count = 0\n        self.errors = []\n        self.max_premium = {hp['max_premium']:.6f}\n        self.max_days_after_earnings = {hp['max_days_after_earnings']}\n        self.entry_min_days = {hp['entry_min_days']}\n        self.entry_max_days = {hp['entry_max_days']}\n        self.exit_policy = 'sell_before_earnings_no_hold_through'\n        self.max_spread = {hp['max_spread']:.6f}\n        self.max_spread_pct = {hp['max_spread_pct']:.6f}\n        self.min_relative_spread = {hp['min_relative_spread']:.6f}\n        self.vol_spread_factor = {hp['vol_spread_factor']:.6f}\n        self.expected_move_spread_fraction = {hp['expected_move_spread_fraction']:.6f}\n        self.min_bid = {hp['min_bid']:.6f}\n        self.min_open_interest = {hp['min_open_interest']}\n        self.min_volume = {hp['min_volume']}\n        self.stop_loss_max_loss_pct = {repr(hp['stop_loss_max_loss_pct'])}\n        self.universe_settings.resolution = Resolution.DAILY\n        self.add_universe(EODHDUpcomingEarnings, self.selection)\n        self.option_by_underlying = {{}}\n        for c in self.candidates:\n            try:\n                eq = self.add_equity(c["symbol"], Resolution.DAILY)\n                eq.set_data_normalization_mode(DataNormalizationMode.RAW)\n                opt = self.add_option(c["symbol"], Resolution.DAILY)\n                opt.set_filter(lambda u: u.include_weeklys().strikes({hp['strike_min']}, {hp['strike_max']}).expiration(timedelta({hp['min_expiration_days']}), timedelta({hp['max_expiration_days']})))\n                self.option_by_underlying[eq.symbol] = opt.symbol\n            except Exception as e:\n                self.errors.append({{"symbol": c.get("symbol"), "stage":"add_symbol", "error":str(e)[:200]}})\n    def qget(self, q, key, default=None):\n        if hasattr(q, 'get'):\n            return q.get(key, default)\n        idx=self.contract_field_index.get(key)\n        return q[idx] if idx is not None and idx < len(q) else default\n    def qdict(self, q):\n        if hasattr(q, 'items'):\n            return dict(q)\n        return {{k:self.qget(q,k) for k in self.contract_fields}}\n    def compact_contract(self, c, exp, bid, ask, mid, last):\n        return (str(c.symbol), float(c.strike), exp.isoformat(), round(bid,4), round(ask,4), round(mid,4), round(last,4), int(c.volume) if c.volume is not None else 0, int(c.open_interest) if c.open_interest is not None else 0, round(float(c.implied_volatility),4) if c.implied_volatility is not None else None, round(float(c.greeks.delta),4) if c.greeks is not None and c.greeks.delta is not None else None)\n    def snapshot_memory_stats(self):\n        day_count=sum(len(days) for days in self.snapshots.values())\n        contract_count=0\n        peak_contracts_per_symbol_day=0\n        for days in self.snapshots.values():\n            for snap in days.values():\n                n=len(snap.get('contracts') or [])\n                contract_count += n\n                peak_contracts_per_symbol_day