    dte=(exp-self.time.date()).days\n                    if dte < {hp['min_expiration_days']} or dte > {hp['max_expiration_days']}: continue\n                    bid=float(c.bid_price) if c.bid_price is not None else 0.0\n                    ask=float(c.ask_price) if c.ask_price is not None else 0.0\n                    last=float(c.last_price) if c.last_price is not None else 0.0\n                    if bid <= 0 and ask <= 0 and last <= 0: continue\n                    mid=(bid+ask)/2.0 if bid>0 and ask>0 else (last if last>0 else max(bid,ask))\n                    rows.append(self.compact_contract(c, exp, bid, ask, mid, last))\n                if rows:\n                    self.snapshots.setdefault(sym, {{}})[day]={{"underlying":round(spot,4),"contracts":rows}}\n                    self.snapshot_memory_stats()\n            except Exception as e:\n                self.errors.append({{"stage":"snapshot", "error":str(e)[:200]}})\n    def liquidity_metrics(self, q, spot, dte):\n        bid=self.qget(q,'bid') or 0; ask=self.qget(q,'ask') or 0; mid=self.qget(q,'mid') or 0\n        spread=ask-bid\n        rel_spread=spread/mid if mid>0 else 999\n        iv=self.qget(q,'iv')\n        delta=self.qget(q,'delta')\n        expected_option_move=abs(delta) * spot * iv * ((max(dte, 1) / 365.0) ** 0.5) if delta is not None and iv is not None and spot else None\n        allowed_relative_spread=min(self.max_spread_pct, max(self.min_relative_spread, self.min_relative_spread + self.vol_spread_factor * iv * ((max(dte, 1) / 365.0) ** 0.5))) if iv is not None else None\n        allowed_spread_inputs=[self.max_spread]\n        if mid>0 and allowed_relative_spread is not None:\n            allowed_spread_inputs.append(mid * allowed_relative_spread)\n        if expected_option_move is not None:\n            allowed_spread_inputs.append(self.expected_move_spread_fraction * expected_option_move)\n        allowed_spread=min(allowed_spread_inputs)\n        return {{"spread":round(spread,4),"spread_mid_pct":round(rel_spread*100,2) if rel_spread != 999 else None,"allowed_spread":round(allowed_spread,4),"allowed_relative_spread_pct":round((allowed_relative_spread or 0)*100,2) if allowed_relative_spread is not None else None,"expected_option_move":round(expected_option_move,4) if expected_option_move is not None else None,"missing_volatility_inputs": iv is None or delta is None}}\n    def liquidity_pass(self, q, spot, dte):\n        bid=self.qget(q,'bid') or 0; ask=self.qget(q,'ask') or 0; mid=self.qget(q,'mid') or 0\n        m=self.liquidity_metrics(q, spot, dte)\n        if ask <= 0 or bid < self.min_bid or mid <= 0: return False\n        if m['missing_volatility_inputs']: return False\n        if m['spread'] > m['allowed_spread']: return False\n        if m['spread_mid_pct'] is None or m['spread_mid_pct'] > self.max_spread_pct * 100.0: return False\n        if (self.qget(q,'open_interest') or 0) < self.min_open_interest and (self.qget(q,'volume') or 0) < self.min_volume: return False\n        return True\n    def nearest_snapshot_date(self, sym, target, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys()])\n        for d in dates:\n            if d >= target and d <= latest: return d\n        return None\n    def quote_on_or_before(self, sym, contract_symbol, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys() if datetime.strptime(d,'%Y-%m-%d').date() <= latest], reverse=True)\n        for d in dates[:10]:\n            snap=self.snapshots[sym][d.isoformat()]\n            for q in snap['contracts']:\n                if self.qget(q,'symbol')==contract_symbol:\n                    return d, q, snap.get('underlying')\n        return None, None, None\n    def contract_quotes_between(self, sym, contract_symbol, start, latest):\n        rows=[]\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapsh