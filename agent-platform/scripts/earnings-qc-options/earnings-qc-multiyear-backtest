    args=ap.parse_args(argv); rd=pathlib.Path(args.run_dir) if args.run_dir else latest_run_dir()
    params={k:getattr(args,k) for k in ['entry_window','exit_days_before','exit_policy','historical_resolution','path_metrics','max_contracts'] if getattr(args,k) is not None}
    summary=run_backtest(rd,args.years,params=params); print(json.dumps(summary,ensure_ascii=False,indent=2,sort_keys=True)); return 0 if summary.get('ok') else 2
