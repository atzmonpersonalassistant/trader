    return out or None

def run_backtest(run_dir:pathlib.Path, years:int, params:dict|None=None):
    candidates=load_candidates(run_dir); out_dir=run_dir/'multiyear_backtest'; out_dir.mkdir(exist_ok=True)
    if not candidates:
        summary={'ok':False,'status':'NO_FORWARD_CANDIDATES','results':[]}; (out_dir/'summary.json').write_text(json.dumps(summary,indent=2)+'\n'); return summary
    project_dir=LEAN_WORKSPACE/PROJECT_NAME; write_project(project_dir,candidates,years,params=params); project_id=ensure_project(project_dir)
    push=subprocess.run(['lean','cloud','push','--project',str(project_dir),'--force'],cwd=str(LEAN_WORKSPACE),text=True,capture_output=True,timeout=180)
    name=f'earnings-qc-historical-option-pnl-{datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")}'
    backtest_timeout = int(os.environ.get('QC_LEAN_CLOUD_BACKTEST_TIMEOUT_SECONDS', '1800'))
    bt=subprocess.run(['lean','cloud','backtest',PROJECT_NAME,'--push','--name',name],cwd=str(LEAN_WORKSPACE),text=True,capture_output=True,timeout=backtest_timeout)
    (out_dir/'push.stdout').write_text(push.stdout); (out_dir/'push.stderr').write_text(push.stderr); (out_dir/'backtest.stdout').write_text(bt.stdout); (out_dir/'backtest.stderr').write_text(bt.stderr)
    m=re.search(r'Backtest id:\s*([0-9a-f]+)', bt.stdout+'\n'+bt.stderr); backtest_id=m.group(1) if m else None
    summary={'ok':False,'status':'QC_BACKTEST_FAILED','project_id':project_id,'backtest_id':backtest_id,'backtest_name':name,'push_returncode':push.returncode,'backtest_returncode':bt.returncode,'parameters': params or {}}
    capacity = classify_qc_cloud_capacity(bt.stdout + '\n' + bt.stderr) if bt.returncode != 0 else None
    if capacity:
        summary.update(capacity)
    if backtest_id:
        b=qc_api('GET','backtests/read',{'projectId':project_id,'backtestId':backtest_id}).get('backtest',{})
        (out_dir/'backtest_read.json').write_text(json.dumps(b,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
        stats=b.get('runtimeStatistics') or {}
        snapshot_memory = snapshot_memory_from_runtime_stats(stats)
        if snapshot_memory:
            summary['snapshot_memory'] = snapshot_memory
        parts=runtime_stat_chunks(stats, 'multiyear_json_')
        js=''.join(parts) if parts else None
        if js:
            try:
                payload=json.loads(js); summary.update(payload); qc_ok=b.get('completed') and b.get('status')=='Completed.' and not b.get('error') and not b.get('stacktrace'); capacity = classify_qc_cloud_capacity('\n'.join(str(x or '') for x in [b.get('status'), b.get('error'), b.get('stacktrace')])) if not qc_ok else None; summary.update(capacity or {'ok': bool(qc_ok), 'status':'OK_MULTIYEAR_OPTION_PNL_BACKTEST' if qc_ok else 'QC_BACKTEST_FAILED'})
            except Exception as e: summary['parse_error']=repr(e)
        summary['qc_status']=b.get('status'); summary['qc_error']=b.get('error'); summary['qc_stacktrace']=b.get('stacktrace')
    (out_dir/'summary.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
    return summary

