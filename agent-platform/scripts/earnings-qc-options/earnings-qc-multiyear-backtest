#!/usr/bin/env python3
from __future__ import annotations
import argparse, datetime, json, pathlib, re, subprocess, time, urllib.request, urllib.parse, hashlib, base64, os
from urllib.parse import urljoin

REPORT_ROOT = pathlib.Path('/agents/research/reports')
STATE_DIR = pathlib.Path('/agents/research/state/earnings-qc-options-scan')
LEAN_WORKSPACE = pathlib.Path('/agents/research/lean-workspace')
QC_API_BASE = 'https://www.quantconnect.com/api/v2/'
PROJECT_NAME = 'earnings-qc-multiyear-backtest'

def latest_run_dir() -> pathlib.Path:
    p = STATE_DIR / 'latest-full-run.txt'
    if p.exists() and p.read_text().strip(): return pathlib.Path(p.read_text().strip())
    dirs=sorted(REPORT_ROOT.glob('earnings-qc-options-scan-full-*'), key=lambda x:x.stat().st_mtime)
    if not dirs: raise SystemExit('no full scan run found')
    return dirs[-1]

def qc_credentials():
    d=json.loads((pathlib.Path.home()/'.lean'/'credentials').read_text()); return str(d['user-id']), str(d['api-token'])

def qc_api(method, endpoint, payload=None):
    uid, token = qc_credentials(); ts=str(int(time.time())); pw=hashlib.sha256(f'{token}:{ts}'.encode()).hexdigest()
    headers={'Timestamp':ts,'User-Agent':'earnings-qc-multiyear'}; url=urljoin(QC_API_BASE, endpoint); data=None
    if method.upper()=='GET' and payload: url += '?' + urllib.parse.urlencode(payload)
    elif payload: data=json.dumps(payload).encode(); headers['Content-Type']='application/json'
    req=urllib.request.Request(url,data=data,headers=headers,method=method.upper())
    req.add_header('Authorization','Basic '+base64.b64encode(f'{uid}:{pw}'.encode()).decode())
    with urllib.request.urlopen(req,timeout=90) as r: out=json.loads(r.read().decode())
    if not out.get('success'): raise RuntimeError(json.dumps(out,ensure_ascii=False)[:1000])
    return out

def ensure_project(project_dir:pathlib.Path):
    cfg_path=project_dir/'config.json'; cfg=json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
    if int(cfg.get('cloud-id') or 0)>0 and cfg.get('organization-id'): return int(cfg['cloud-id'])
    projects=qc_api('GET','projects/read').get('projects',[])
    pr=next((p for p in projects if p.get('name')==PROJECT_NAME),None)
    if pr is None: pr=qc_api('POST','projects/create',{'name':PROJECT_NAME,'language':'Py'})['projects'][0]
    cfg.update({'algorithm-language':'Python','parameters':{},'description':'Earnings candidates multi-year historical option PnL backtest','cloud-id':pr['projectId'],'organization-id':pr.get('organizationId')})
    cfg_path.write_text(json.dumps(cfg,indent=2)+'\n'); return int(pr['projectId'])

def load_candidates(run_dir:pathlib.Path):
    full=json.loads((run_dir/'full_summary.json').read_text()); return full.get('forward_candidates') or full.get('candidates') or []

def result_passes(r:dict)->bool:
    if r.get('status')!='OK': return False
    sample=int(r.get('sample_size') if r.get('sample_size') is not None else 0); events=int(r.get('historical_event_count') if r.get('historical_event_count') is not None else 0); dropout=0.0 if events<=0 else (1.0 - (sample/events))*100.0; win=float(r.get('win_rate') if r.get('win_rate') is not None else 0); med=float(r.get('median_return_pct') if r.get('median_return_pct') is not None else -999); mean=float(r.get('mean_return_pct') if r.get('mean_return_pct') is not None else -999); dd=float(r.get('max_drawdown_pct') if r.get('max_drawdown_pct') is not None else 999); ml=float(r.get('max_loss_pct') if r.get('max_loss_pct') is not None else -999)
    base_ok = sample>=8 and win>=0.35 and med>0 and mean>0 and dd<80 and ml>-95 and (events<=0 or dropout<=float(os.environ.get('QC_FINAL_MAX_DROPOUT_PCT','40')))
    windows = r.get('window_results') or []
    if windows:
        return base_ok and all(w.get('status') == 'OK' and int(w.get('sample_size') if w.get('sample_size') is not None else 0) >= 1 for w in windows)
    return base_ok

def write_project(project_dir:pathlib.Path, candidates:list[dict], years:int):
    project_dir.mkdir(parents=True,exist_ok=True)
    today=datetime.date.today(); start=today.replace(year=max(2018,today.year-years)); end=today
    minimal=[]
    for c in candidates:
        minimal.append({'symbol':c.get('symbol'),'forward_earnings_date':c.get('earnings_date'),'spot':c.get('spot'),'forward_contracts':[{'strike':x.get('strike'),'ask':x.get('ask'),'required_move_pct':x.get('required_move_pct'),'days_after_earnings':x.get('days_after_earnings')} for x in (c.get('contracts') or [])[:3]]})
    (project_dir/'config.json').write_text(json.dumps({'algorithm-language':'Python','parameters':{},'description':'Earnings candidates multi-year historical option PnL backtest','cloud-id':0,'organization-id':''},indent=2)+'\n')
    code=f'''from AlgorithmImports import *\nfrom QuantConnect.DataSource import EODHDUpcomingEarnings\nimport json\nfrom datetime import datetime, timedelta\n\nclass EarningsQcHistoricalOptionPnl(QCAlgorithm):\n    def initialize(self):\n        self.set_start_date({start.year},{start.month},{start.day})\n        self.set_end_date({end.year},{end.month},{end.day})\n        self.set_cash(100000)\n        self.candidates = json.loads({json.dumps(minimal, sort_keys=True)!r})\n        self.targets = set([c["symbol"] for c in self.candidates if c.get("symbol")])\n        self.events = {{}}\n        self.snapshots = {{}}  # sym -> date -> {{underlying, contracts}}\n        self.errors = []\n        self.max_premium = 0.50\n        self.max_days_after_earnings = 7\n        self.entry_min_days = 21\n        self.entry_max_days = 28\n        self.exit_policy = 'sell_before_earnings_no_hold_through'\n        self.max_spread = 0.25\n        self.max_spread_pct = 0.60\n        self.min_relative_spread = 0.25\n        self.vol_spread_factor = 0.50\n        self.expected_move_spread_fraction = 0.15\n        self.min_bid = 0.05\n        self.min_open_interest = 50\n        self.min_volume = 10\n        self.universe_settings.resolution = Resolution.DAILY\n        self.add_universe(EODHDUpcomingEarnings, self.selection)\n        self.option_by_underlying = {{}}\n        for c in self.candidates:\n            try:\n                eq = self.add_equity(c["symbol"], Resolution.DAILY)\n                eq.set_data_normalization_mode(DataNormalizationMode.RAW)\n                opt = self.add_option(c["symbol"], Resolution.DAILY)\n                opt.set_filter(lambda u: u.include_weeklys().strikes(-50, 300).expiration(timedelta(0), timedelta(60)))\n                self.option_by_underlying[eq.symbol] = opt.symbol\n            except Exception as e:\n                self.errors.append({{"symbol": c.get("symbol"), "stage":"add_symbol", "error":str(e)[:200]}})\n    def selection(self, data):\n        for d in data:\n            try:\n                sym=str(d.symbol.value).upper()\n                if sym not in self.targets: continue\n                rd=d.report_date\n                report_date=rd.date() if hasattr(rd,'date') else rd\n                self.events.setdefault(sym, {{}})[str(report_date)]={{"symbol":sym,"asof":self.time.strftime('%Y-%m-%d'),"report_date":str(report_date),"report_time":str(getattr(d,'report_time',None))}}\n            except Exception as e:\n                self.errors.append({{"stage":"selection", "error":str(e)[:200]}})\n        return []\n    def on_data(self, data):\n        day=self.time.date().isoformat()\n        for underlying,opt_symbol in list(self.option_by_underlying.items()):\n            try:\n                sym=str(underlying).split(' ')[0].upper()\n                chain=data.option_chains.get(opt_symbol)\n                if chain is None: continue\n                spot=float(self.securities[underlying].price)\n                rows=[]\n                for c in list(chain):\n                    if c.right != OptionRight.CALL: continue\n                    exp=c.expiry.date()\n                    dte=(exp-self.time.date()).days\n                    if dte < 1 or dte > 60: continue\n                    bid=float(c.bid_price) if c.bid_price is not None else 0.0\n                    ask=float(c.ask_price) if c.ask_price is not None else 0.0\n                    last=float(c.last_price) if c.last_price is not None else 0.0\n                    if bid <= 0 and ask <= 0 and last <= 0: continue\n                    mid=(bid+ask)/2.0 if bid>0 and ask>0 else (last if last>0 else max(bid,ask))\n                    rows.append({{"symbol":str(c.symbol),"strike":float(c.strike),"expiry":exp.isoformat(),"bid":round(bid,4),"ask":round(ask,4),"mid":round(mid,4),"last":round(last,4),"volume":int(c.volume) if c.volume is not None else 0,"open_interest":int(c.open_interest) if c.open_interest is not None else 0,"iv":round(float(c.implied_volatility),4) if c.implied_volatility is not None else None,"delta":round(float(c.greeks.delta),4) if c.greeks is not None and c.greeks.delta is not None else None}})\n                if rows:\n                    self.snapshots.setdefault(sym, {{}})[day]={{"underlying":round(spot,4),"contracts":rows}}\n            except Exception as e:\n                self.errors.append({{"stage":"snapshot", "error":str(e)[:200]}})\n    def liquidity_metrics(self, q, spot, dte):\n        bid=q.get('bid') or 0; ask=q.get('ask') or 0; mid=q.get('mid') or 0\n        spread=ask-bid\n        rel_spread=spread/mid if mid>0 else 999\n        iv=q.get('iv')\n        delta=q.get('delta')\n        expected_option_move=abs(delta) * spot * iv * ((max(dte, 1) / 365.0) ** 0.5) if delta is not None and iv is not None and spot else None\n        allowed_relative_spread=min(self.max_spread_pct, max(self.min_relative_spread, self.min_relative_spread + self.vol_spread_factor * iv * ((max(dte, 1) / 365.0) ** 0.5))) if iv is not None else None\n        allowed_spread_inputs=[self.max_spread]\n        if mid>0 and allowed_relative_spread is not None:\n            allowed_spread_inputs.append(mid * allowed_relative_spread)\n        if expected_option_move is not None:\n            allowed_spread_inputs.append(self.expected_move_spread_fraction * expected_option_move)\n        allowed_spread=min(allowed_spread_inputs)\n        return {{"spread":round(spread,4),"spread_mid_pct":round(rel_spread*100,2) if rel_spread != 999 else None,"allowed_spread":round(allowed_spread,4),"allowed_relative_spread_pct":round((allowed_relative_spread or 0)*100,2) if allowed_relative_spread is not None else None,"expected_option_move":round(expected_option_move,4) if expected_option_move is not None else None,"missing_volatility_inputs": iv is None or delta is None}}\n    def liquidity_pass(self, q, spot, dte):\n        bid=q.get('bid') or 0; ask=q.get('ask') or 0; mid=q.get('mid') or 0\n        m=self.liquidity_metrics(q, spot, dte)\n        if ask <= 0 or bid < self.min_bid or mid <= 0: return False\n        if m['missing_volatility_inputs']: return False\n        if m['spread'] > m['allowed_spread']: return False\n        if m['spread_mid_pct'] is None or m['spread_mid_pct'] > self.max_spread_pct * 100.0: return False\n        if (q.get('open_interest') or 0) < self.min_open_interest and (q.get('volume') or 0) < self.min_volume: return False\n        return True\n    def nearest_snapshot_date(self, sym, target, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys()])\n        for d in dates:\n            if d >= target and d <= latest: return d\n        return None\n    def quote_on_or_before(self, sym, contract_symbol, latest):\n        dates=sorted([datetime.strptime(d,'%Y-%m-%d').date() for d in (self.snapshots.get(sym) or {{}}).keys() if datetime.strptime(d,'%Y-%m-%d').date() <= latest], reverse=True)\n        for d in dates[:10]:\n            snap=self.snapshots[sym][d.isoformat()]\n            for q in snap['contracts']:\n                if q['symbol']==contract_symbol:\n                    return d, q, snap.get('underlying')\n        return None, None, None\n    def on_end_of_algorithm(self):\n        results=[]\n        bysym={{c['symbol']:c for c in self.candidates}}\n        for sym,c in bysym.items():\n            evs=sorted((self.events.get(sym) or {{}}).values(), key=lambda r:r['report_date'])\n            trades=[]; blockers={{}}\n            for ev in evs:\n                try:\n                    rd=datetime.strptime(ev['report_date'],'%Y-%m-%d').date()\n                    entry_target=rd-timedelta(days=self.entry_max_days)\n                    entry_latest=rd-timedelta(days=self.entry_min_days)\n                    entry_day=self.nearest_snapshot_date(sym, entry_target, entry_latest)\n                    if entry_day is None:\n                        blockers['missing_entry_snapshot']=blockers.get('missing_entry_snapshot',0)+1; continue\n                    snap=self.snapshots[sym][entry_day.isoformat()]\n                    spot=float(snap['underlying'])\n                    max_exp=rd+timedelta(days=self.max_days_after_earnings)\n                    eligible=[]\n                    for q in snap['contracts']:\n                        exp=datetime.strptime(q['expiry'],'%Y-%m-%d').date()\n                        ask=q.get('ask') or 0; strike=q.get('strike') or 0\n                        if exp <= rd or exp > max_exp: continue\n                        if ask <= 0 or ask > self.max_premium: continue\n                        if strike <= spot: continue\n                        dte=(exp-entry_day).days\n                        if not self.liquidity_pass(q, spot, dte): continue\n                        req=(strike/spot-1.0)*100.0\n                        qq=dict(q); qq['required_move_pct']=round(req,2); qq.update(self.liquidity_metrics(q, spot, dte))\n                        eligible.append(qq)\n                    if not eligible:\n                        blockers['no_eligible_entry_contract']=blockers.get('no_eligible_entry_contract',0)+1; continue\n                    eligible=sorted(eligible, key=lambda q:(q['ask'], q['required_move_pct'], -(q.get('open_interest') or 0), -(q.get('volume') or 0)))\n                    ent=eligible[0]\n                    report_time=str(ev.get('report_time'))\n                    # Conservative daily-data exit policy: never hold through earnings.\n                    # Before-market reports exit the prior trading day. After-market reports may\n                    # use the report day's daily snapshot as the last pre-report close.\n                    normalized_report_time=report_time.lower().replace('-', '_').replace(' ', '_')\n                    # Single exit policy: sell before the earnings announcement; never hold through earnings.\n                    # After-market reports use the report day's daily close as the last pre-announcement snapshot.\n                    # Pre-market or unknown reports exit on the prior trading day. Unknown is intentionally conservative.\n                    if any(token in normalized_report_time for token in ['aftermarket','after_market','after_hours','post_market','time_after_hours']):\n                        planned_exit_date=rd\n                        exit_reason='after_market_report_day_close_sell_before_earnings'\n                    else:\n                        planned_exit_date=rd-timedelta(days=1)\n                        exit_reason='pre_market_or_unknown_prior_trading_day_sell_before_earnings'\n                    exit_day, exq, und = self.quote_on_or_before(sym, ent['symbol'], planned_exit_date)\n                    if exq is None:\n                        blockers['missing_exit_quote']=blockers.get('missing_exit_quote',0)+1; continue\n                    entry_price=float(ent['ask'])\n                    exit_price=float(exq.get('bid') or exq.get('mid') or 0)\n                    if entry_price <= 0 or exit_price < 0:\n                        blockers['bad_prices']=blockers.get('bad_prices',0)+1; continue\n                    ret=(exit_price/entry_price-1.0)*100.0\n                    trades.append({{"report_date":ev['report_date'],"entry_date":entry_day.isoformat(),"planned_exit_date":planned_exit_date.isoformat(),"actual_exit_date":exit_day.isoformat(),"exit_date":exit_day.isoformat(),"exit_days_shifted":(planned_exit_date-exit_day).days,"contract":ent['symbol'],"entry_ask":round(entry_price,4),"exit_bid":round(exit_price,4),"return_pct":round(ret,2),"win":ret>0,"required_move_pct":ent['required_move_pct'],"allowed_spread":ent.get('allowed_spread'),"spread_mid_pct":ent.get('spread_mid_pct'),"expected_option_move":ent.get('expected_option_move'),"exit_policy":self.exit_policy,"exit_reason":exit_reason,"report_time":report_time}})\n                except Exception as e:\n                    self.errors.append({{"symbol":sym,"stage":"eval_event","report_date":ev.get('report_date'),"error":str(e)[:200]}})\n            def metrics(rows, label, min_sample):\n                n=len(rows); wins=sum(1 for t in rows if t['win']); rets=[t['return_pct'] for t in rows]\n                mean_ret=round(sum(rets)/n,2) if n else None\n                med_ret=None\n                if n:\n                    xs=sorted(rets); med_ret=round(xs[n//2] if n%2 else (xs[n//2-1]+xs[n//2])/2.0,2)\n                max_loss=round(min(rets),2) if n else None\n                eq=1.0; peak=1.0; mdd=0.0\n                for r in rets:\n                    eq *= max(0.0, 1.0 + r/100.0); peak=max(peak,eq); mdd=max(mdd,(peak-eq)/peak if peak else 0)\n                return {{"window":label,"sample_size":n,"wins":wins,"win_rate":round(wins/n,4) if n else None,"mean_return_pct":mean_ret,"median_return_pct":med_ret,"max_loss_pct":max_loss,"max_drawdown_pct":round(mdd*100,2),"status":"OK" if n>=min_sample else "BLOCKED_HISTORICAL_OPTION_SAMPLE_INSUFFICIENT"}}\n            windows=[]\n            for wy in sorted(set([1,3,5,{years}])):\n                cutoff=datetime({end.year},{end.month},{end.day}).date()-timedelta(days=365*wy)\n                rows=[t for t in trades if datetime.strptime(t['report_date'],'%Y-%m-%d').date() >= cutoff]\n                windows.append(metrics(rows, str(wy)+'y', 1 if wy==1 else min(4, wy)))\n            overall=metrics(trades,'all',4)\n            results.append({{"symbol":sym,"historical_event_count":len(evs),"sample_size":overall['sample_size'],"exit_policy":self.exit_policy,"wins":overall['wins'],"win_rate":overall['win_rate'],"mean_return_pct":overall['mean_return_pct'],"median_return_pct":overall['median_return_pct'],"max_loss_pct":overall['max_loss_pct'],"max_drawdown_pct":overall['max_drawdown_pct'],"window_results":windows,"blockers":blockers,"status":"OK" if overall['sample_size']>=4 and all(w['status']=='OK' for w in windows) else "BLOCKED_HISTORICAL_OPTION_WINDOW_GATE"}})\n        payload={{"type":"earnings_qc_multiyear_backtest","mode":"historical_option_pnl_v1","exit_policy":"sell_before_earnings_no_hold_through","years":{years},"candidate_count":len(self.candidates),"results":results,"errors":self.errors[:10]}}\n        txt=json.dumps(payload, sort_keys=True)\n        self.set_runtime_statistic('multiyear_candidate_count', str(len(self.candidates)))\n        self.set_runtime_statistic('multiyear_mode','historical_option_pnl_v1')
        self.set_runtime_statistic('multiyear_exit_policy','sell_before_earnings_no_hold_through')\n        
        for i in range(0, len(txt), 3500):
            self.set_runtime_statistic('multiyear_json_%02d' % (i//3500), txt[i:i+3500])\n        self.debug('EARNINGS_QC_MULTIYEAR_JSON='+txt)\n'''
    (project_dir/'main.py').write_text(code)

def run_backtest(run_dir:pathlib.Path, years:int, params:dict|None=None):
    candidates=load_candidates(run_dir); out_dir=run_dir/'multiyear_backtest'; out_dir.mkdir(exist_ok=True)
    if not candidates:
        summary={'ok':False,'status':'NO_FORWARD_CANDIDATES','results':[]}; (out_dir/'summary.json').write_text(json.dumps(summary,indent=2)+'\n'); return summary
    project_dir=LEAN_WORKSPACE/PROJECT_NAME; write_project(project_dir,candidates,years); project_id=ensure_project(project_dir)
    push=subprocess.run(['lean','cloud','push','--project',str(project_dir),'--force'],cwd=str(LEAN_WORKSPACE),text=True,capture_output=True,timeout=180)
    name=f'earnings-qc-historical-option-pnl-{datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")}'
    bt=subprocess.run(['lean','cloud','backtest',PROJECT_NAME,'--push','--name',name],cwd=str(LEAN_WORKSPACE),text=True,capture_output=True,timeout=1800)
    (out_dir/'push.stdout').write_text(push.stdout); (out_dir/'push.stderr').write_text(push.stderr); (out_dir/'backtest.stdout').write_text(bt.stdout); (out_dir/'backtest.stderr').write_text(bt.stderr)
    m=re.search(r'Backtest id:\s*([0-9a-f]+)', bt.stdout+'\n'+bt.stderr); backtest_id=m.group(1) if m else None
    summary={'ok':False,'status':'QC_BACKTEST_FAILED','project_id':project_id,'backtest_id':backtest_id,'backtest_name':name,'push_returncode':push.returncode,'backtest_returncode':bt.returncode,'parameters': params or {}}
    if backtest_id:
        b=qc_api('GET','backtests/read',{'projectId':project_id,'backtestId':backtest_id}).get('backtest',{})
        (out_dir/'backtest_read.json').write_text(json.dumps(b,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
        stats=b.get('runtimeStatistics') or {}; parts=[stats[k] for k in sorted(stats) if k.startswith('multiyear_json_')]
        js=''.join(parts) if parts else None
        if js:
            try:
                payload=json.loads(js); summary.update(payload); any_pass=any(result_passes(r) for r in summary.get('results',[])); qc_ok=b.get('completed') and b.get('status')=='Completed.' and not b.get('error') and not b.get('stacktrace'); summary.update({'ok': bool(qc_ok and any_pass), 'status':'OK_MULTIYEAR_OPTION_PNL_BACKTEST' if (qc_ok and any_pass) else ('QC_BACKTEST_FAILED' if not qc_ok else 'BLOCKED_HISTORICAL_OPTION_PNL_GATE_NO_PASSING_SYMBOLS')})
            except Exception as e: summary['parse_error']=repr(e)
        summary['qc_status']=b.get('status'); summary['qc_error']=b.get('error'); summary['qc_stacktrace']=b.get('stacktrace')
    (out_dir/'summary.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
    fs=run_dir/'full_summary.json'
    if fs.exists():
        full=json.loads(fs.read_text()); full['multiyear_backtest']=summary; full['historical_gate_ran']=True; full['aggregate_funnel']['07_multi_year_backtest_status']=summary.get('status')
        # final candidates only where option pnl backtest has sufficient OK status; stricter pass criteria can be tuned later
        ok_syms={r['symbol'] for r in summary.get('results',[]) if summary.get('ok') and result_passes(r)}
        src=full.get('forward_candidates') or full.get('candidates',[])
        full['final_candidates']=[c for c in src if c.get('symbol') in ok_syms]
        full['candidates']=full['final_candidates']
        full['candidate_count']=len(full['final_candidates'])
        full['final_candidate_count']=len(full['final_candidates'])
        historical_failed = list(full.get('historical_failed_chunks') or [])
        scanner_failed = []
        for x in (full.get('failed_chunks') or []):
            text = (str(x.get('status')) + ' ' + str(x.get('blocked_reason'))).upper()
            # Keep scanner failures separate from historical/multiyear option-PnL failures.
            # Retry logic relies on the inverse check: 'MULTIYEAR' not in str(x.get('status')).
            if any(marker in text for marker in ['MULTIYEAR', 'HISTORICAL', 'OPTION-PNL', 'OPTION_PNL']):
                historical_failed.append(x)
            else:
                scanner_failed.append(x)
        base_scan_ok = not scanner_failed and int(full.get('qc_symbols_scanned') or 0) >= int(full.get('calendar_row_count') or full.get('calendar_universe_count') or 0)
        no_pass = bool(src) and bool(base_scan_ok) and not bool(full['final_candidates']) and summary.get('status') == 'BLOCKED_HISTORICAL_OPTION_PNL_GATE_NO_PASSING_SYMBOLS'
        infra_failed = bool(src) and not bool(summary.get('ok')) and not no_pass
        full['historical_gate_no_pass']=no_pass
        full['historical_gate_blocked']=bool(src) and bool(base_scan_ok) and not bool(full['final_candidates']) and (infra_failed or not no_pass)
        full['multiyear_failed']=infra_failed
        full['failed_chunks'] = scanner_failed
        full['failed_chunk_count'] = len(scanner_failed)
        full['historical_failed_chunks'] = historical_failed
        full['historical_failed_chunk_count'] = len(historical_failed)
        full['ok']=bool(base_scan_ok) and bool(summary.get('ok')) and bool(full['final_candidates'])
        if full['ok']:
            full['status']='OK_FULL_QC_SCAN'
        elif no_pass:
            full['status']='NO_FINAL_CANDIDATES_AFTER_HISTORICAL_OPTION_PNL'
        elif full['historical_gate_blocked']:
            full['status']='BLOCKED_HISTORICAL_OPTION_PNL_GATE'
        elif full['multiyear_failed']:
            full['status']='BLOCKED_MULTIYEAR_OPTION_PNL_BACKTEST'
        fs.write_text(json.dumps(full,ensure_ascii=False,indent=2,sort_keys=True)+'\n')
    return summary

def main(argv):
