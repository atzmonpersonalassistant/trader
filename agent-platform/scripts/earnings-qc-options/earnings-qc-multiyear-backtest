def snapshot_memory_from_runtime_stats(stats: dict) -> dict | None:
    raw = stats.get('multiyear_snapshot_memory')
    if raw:
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                return parsed
        except Exception:
            pass
    keys = [
        'snapshot_contract_count',
        'snapshot_day_count',
        'snapshot_peak_day_count',
        'snapshot_peak_contracts_per_symbol_day',
        'snapshot_record_format',
        'snapshot_strike_range',
    ]
    out = {}
    for key in keys:
        value = stats.get('multiyear_' + key)
        if value is None:
            continue
        if key in {'snapshot_record_format', 'snapshot_strike_range'}:
            out[key] = value
            continue
        try:
            out[key] = int(value)
        except Exception:
