#!/usr/bin/env bash
# Narrow root-owned sudo target for orchestrator -> coding-agent stub dispatch.
set -euo pipefail

if [[ "$#" -ne 3 || "$1" != "run" || "$2" != "--issue" || ! "$3" =~ ^[0-9]+$ ]]; then
  echo "usage: trading-dispatch-coding-agent-stub run --issue <number>" >&2
  exit 64
fi

exec sudo -n -u agent-coding /usr/local/bin/trading-coding-agent-stub run --issue "$3"
